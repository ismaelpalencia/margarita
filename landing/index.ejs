                }
            },
            {
                "@type": "Question",
                "name": "¿Hay costo de instalación o setup?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "No. El plan incluye la puesta en marcha y el onboarding: sesión de arranque de 2 h y guía publicada. Solo pagas la mensualidad."
                }
            },
            {
                "@type": "Question",
                "name": "¿El consumo de WhatsApp está incluido?",
                "acceptedAnswer": {
                    "@type": "Answer",

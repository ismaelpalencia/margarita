<!doctype html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <meta name="author" content="Margarita" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Margarita" />
    <meta property="og:title" content="<%= title %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:url" content="<%= canonicalUrl %>" />
    <meta property="og:image" content="https://margaritaapp.org/assets/img/margarita-wordmark-512.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta name="twitter:image" content="https://margaritaapp.org/assets/img/margarita-wordmark-512.png" />
    <meta name="theme-color" content="#2B6CB0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="/assets/css/tokens.css" />
    <link rel="stylesheet" href="/assets/css/site.css" />

    <script type="application/ld+json">
        <%- JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "@id": "https://margaritaapp.org/#organization",
                    "name": "Margarita",
                    "url": "https://margaritaapp.org/",
                    "logo": "https://margaritaapp.org/assets/img/margarita-icon-512.png",
                    "description": "Plataforma para operar WhatsApp con IA acotada, control humano y panel completo."
                },
                {
                    "@type": "WebSite",
                    "@id": "https://margaritaapp.org/#website",
                    "url": "https://margaritaapp.org/",
                    "name": "Margarita",
                    "inLanguage": "es-MX",
                    "publisher": { "@id": "https://margaritaapp.org/#organization" }
                },
                {
                    "@type": "SoftwareApplication",
                    "name": "Margarita IA",
                    "applicationCategory": "BusinessApplication",
                    "operatingSystem": "Web",
                    "description": description,
                    "url": "https://margaritaapp.org/",
                    "publisher": { "@id": "https://margaritaapp.org/#organization" },
                    "offers": {
                        "@type": "Offer",
                        "price": "1299",
                        "priceCurrency": "MXN",
                        "valueAddedTaxIncluded": false,
                        "url": "https://margaritaapp.org/precios"
                    }
                }
            ]
        }) %>
    </script>

    <% if (typeof metaPixelId !== "undefined" && metaPixelId) { %>
        <script>
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '<%= metaPixelId %>');
            fbq('track', 'PageView');
        </script>
        <noscript>
            <img height="1" width="1" style="display:none"
                 src="https://www.facebook.com/tr?id=<%= metaPixelId %>&ev=PageView&noscript=1" />
        </noscript>
    <% } %>
</head>
<body>
<a class="skip-link" href="#contenido">Saltar al contenido</a>

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <a class="brand" href="/">
                    <img src="/assets/img/margarita-icon-128.png" alt="Margarita" />
                    <span>Margarita</span>
                </a>
                <p>Automatiza WhatsApp con IA: atiende, califica y deriva. Cuenta dedicada, datos cifrados y control humano.</p>
            </div>

            <div class="footer-col">
                <h4>Producto</h4>
                <a href="/ia">IA con control humano</a>
                <a href="/precios">Precios</a>
                <a href="/demo">Demo</a>
                <a href="/onboarding">Alta en 7 días</a>
            </div>

            <div class="footer-col">
                <h4>Recursos</h4>
                <a href="/guia">Guía de uso</a>
                <a href="/plantillas">Guía de plantillas</a>
                <a href="/privacidad">Aviso de privacidad</a>
                <a href="/acceso">Ya tengo acceso</a>
            </div>

            <div class="footer-col">
                <h4>Contacto</h4>
                <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
                <a href="<%= supportWhatsappUrl %>" target="_blank" rel="noopener">WhatsApp <%= supportWhatsappDisplay %></a>
                <a href="https://margaritaapp.org">margaritaapp.org</a>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© <%= year %> Margarita. Todos los derechos reservados.</span>
            <span>Precios en MXN + IVA. El consumo de WhatsApp lo factura Meta directamente al cliente.</span>
        </div>
    </div>
</footer>

<% if (typeof metaPixelId !== "undefined" && metaPixelId) { %>
    <script>
        (function () {
            if (typeof fbq !== "function") {
                return;
            }

            var path = window.location.pathname;

            if (path === "/precios" || path === "/demo") {
                fbq("track", "ViewContent", { content_name: path });
            }

            document.addEventListener(
                "click",
                function (event) {
                    var target = event.target;
                    var link = target && target.closest
                        ? target.closest('a[href*="wa.me"]')
                        : null;

                    if (link) {
                        fbq("track", "Contact", { content_name: "whatsapp" });
                    }
                },
                true
            );
        })();
    </script>
<% } %>
</body>
</html>

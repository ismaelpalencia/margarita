<%- include("_head") %>
<%- include("_header") %>

<main id="contenido">
    <section class="section section--tight">
        <div class="container">
            <span class="eyebrow">Guía de uso</span>
            <h1 class="section-title" style="font-size:34px;line-height:42px;">El manual del equipo que atiende por WhatsApp</h1>
            <p class="section-lede">
                Arranque, bandeja, plantillas, campañas, IA, horarios, leads, respaldos y
                problemas comunes. Si algo no coincide con lo que ves en pantalla, gana la
                pantalla.
            </p>
        </div>
    </section>

    <section class="section section--tight">
        <div class="container">
            <nav class="guide-toc" aria-label="En esta guía">
                <p class="section-kicker">En esta guía</p>
                <ul class="guide-toc__list">
                    <% guideHeadings.forEach((heading) => { %>
                        <li><a href="#<%= heading.id %>"><%= heading.text %></a></li>
                    <% }) %>
                </ul>
            </nav>

            <div class="prose">
                <%- guideHtml %>
            </div>
        </div>
    </section>

    <section class="cta-band section--dark">
        <div class="container cta-band__inner">
            <div>
                <h2>¿Necesitas ayuda con el arranque?</h2>
                <p>La sesión de arranque de 2 horas va incluida en el plan.</p>
            </div>
            <a class="btn btn--primary btn--lg" href="<%= supportWhatsappUrl %>" target="_blank" rel="noopener">Hablar por WhatsApp</a>
        </div>
    </section>
</main>

<%- include("_footer") %>

APP_NAME=Margarita
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
TIMEZONE=America/Mexico_City

DATABASE_URL=

# Obligatorio en producción; genera una llave aleatoria con npm run secrets:generate
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=margarita_token

WORKSPACE_NAME=
WORKSPACE_SLUG=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

META_API_VERSION=v23.0
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_VERIFY_TOKEN=
META_PHONE_NUMBER=

# Endurecimiento (producción)
ENCRYPTION_KEY=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOG_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=30
WEBHOOK_QUEUE_ENABLED=true
WEBHOOK_WORKER_INTERVAL_MS=2000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_SCHEMA_PAUSE_MS=300000
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=10

# Multimedia (archivos que envían los clientes)
# En producción apunta a un Volume, por ejemplo /data/media
MEDIA_STORAGE_DIR=
MEDIA_MAX_BYTES=26214400

# Solo para pruebas: apunta la Graph API a un servidor simulado.
# En producción se deja vacío para usar https://graph.facebook.com
GRAPH_BASE_URL=

# Avisos de calidad y comodidad de la operación
# Palabras que dan de baja a un contacto al escribirlas (separadas por coma)
OPT_OUT_KEYWORDS=STOP
# Intentos sin respuesta que llevan a un cliente a "sin contestación"
OUTCOME_NO_ANSWER_ATTEMPTS=3

# Sesiones
# Minutos de inactividad antes de cerrar la sesión sola
SESSION_IDLE_MINUTES=720
# Dispositivos con sesión abierta por usuario
SESSION_MAX_ACTIVE=3

# Respaldos automáticos de la base
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Debe apuntar a un Volume en producción, por ejemplo /data/backups
BACKUP_DIR=
BACKUP_MAX_AGE_HOURS=36

# Campañas en cola
CAMPAIGN_WORKER_INTERVAL_MS=5000
CAMPAIGN_BATCH_SIZE=10
CAMPAIGN_SEND_INTERVAL_MS=700

# Contacto comercial de la página pública (opcional)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SETUP_SERVICE_PRICE=
# Complemento de IA (aprobado 2026-11-04). Se suma al paquete base.
# Vacío usa los importes del código; cámbialos solo junto con
# docs/alcance-produccion.md y docs/facturacion.md.
AI_ESSENTIAL_INSTALL_PRICE=
AI_ESSENTIAL_MONTHLY_PRICE=
AI_SUPPORT_INSTALL_PRICE=
AI_SUPPORT_MONTHLY_PRICE=

# IA de respuestas (sugerencias y automático acotado)
# Interruptor maestro de la instalación. Con false, la app funciona igual.
# El automático además debe activarse por workspace en Admin → IA.
AI_ENABLED=false
# deepseek | cualquier API compatible con OpenAI | mock
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000
# Mensajes previos del hilo que se mandan como contexto
AI_MAX_CONTEXT_MESSAGES=12
# Entradas de la base de conocimiento que se recuperan por mensaje
AI_MAX_KNOWLEDGE_ENTRIES=6
# Espera para agrupar varios mensajes seguidos antes de llamar al modelo
AI_DEBOUNCE_SECONDS=4
AI_WORKER_INTERVAL_MS=3000
AI_MAX_ATTEMPTS=2
AI_MAX_TOKENS=400
AI_TEMPERATURE=0.3
# Precio de referencia para estimar costo y presupuesto (USD por millón de tokens)
AI_PRICE_INPUT_PER_MILLION=0.27
AI_PRICE_OUTPUT_PER_MILLION=1.10

# Demo pública (/demo). Sin true, la ruta responde 404.
DEMO_ENABLED=false

# Techos de IA que el operador fija desde Railway (opcionales).
# Si existen, la app recorta los límites del workspace y el panel los muestra
# como solo lectura: el cliente no puede subirlos.
# AI_MAX_REPLIES_PER_DAY=1500
# AI_MAX_REPLIES_PER_THREAD=5
# AI_MAX_MONTHLY_BUDGET_CENTS=500
# AI_LIMITS_LOCKED=true
# AI_LIMITS_HIDDEN=true

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

/**
 * Giro de la operación. No cambia el código: cambia el vocabulario, los
 * módulos visibles y el playbook con el que se arranca. Cobranza es el
 * primero; comercio y servicios se atienden con el mismo binario.
 */
enum WorkspaceProfile {
  COBRANZA
  COMERCIO
  SERVICIOS
  GENERICO
}

enum UserRole {
  ADMIN
  AGENT
}

enum UserStatus {
  AVAILABLE
  BUSY
  BREAK
  OFFLINE
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ConversationOperationalStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum ConversationSource {
  CAMPAIGN
  MANUAL
  INBOUND
  AUTOMATIC
}

enum MessageDirection {
  IN
  OUT
}

enum MessageType {
  TEXT
  TEMPLATE
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  INTERACTIVE
  UNKNOWN
}

enum MessageStatus {
  CREATED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageSource {
  MANUAL
  CAMPAIGN
  AUTOMATIC
  WEBHOOK
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  VALIDATING
  READY
  RUNNING
  PAUSED
  FINISHED
  FAILED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum LogModule {
  SYSTEM
  AUTH
  USER
  CONTACT
  TAG
  CAMPAIGN
  CONVERSATION
  MESSAGE
  WEBHOOK
  META
  WHATSAPP_ACCOUNT
  COMPLAINT
  COMPLIANCE
  AI
}

enum ComplaintMotive {
  HOSTIGAMIENTO
  HORARIO
  LENGUAJE
  FRECUENCIA
  DATOS_PERSONALES
  MONTO
  OTRO
}

enum ComplaintChannel {
  WHATSAPP
  LLAMADA
  CORREO
  PRESENCIAL
  OTRO
}

enum ComplaintStatus {
  ABIERTA
  EN_PROCESO
  CERRADA
  ESCALADA
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/**
 * Cómo se usa la IA en el workspace.
 * - `OFF`: apagada.
 * - `SUGGEST`: redacta un borrador y una persona decide (fase 1).
 * - `AUTO`: responde sola las preguntas que la base de conocimiento cubre
 * (fase 2; el worker de la fase 1 la trata como apagada).
 */
enum AiMode {
  OFF
  SUGGEST
  AUTO
}

/**
 * Qué hace la instalación con un mensaje que llega fuera del horario de
 * atención configurado (solo aplica cuando `businessHoursEnabled` es true).
 * - `TEXT_ONLY`: responde con `offHoursMessage` una vez por intervalo.
 * - `AI_IF_COVERED`: responde con IA solo si la base de conocimiento cubre la
 * pregunta y la confianza alcanza el umbral; si no, mensaje fuera de horario.
 * - `QUEUE_ONLY`: no responde; deja la conversación sin asignar para la mañana.
 */
enum OffHoursMode {
  TEXT_ONLY
  AI_IF_COVERED
  QUEUE_ONLY
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  CONVERTIDO
  DESCARTADO
}

enum FeedbackValue {
  UP
  DOWN
}

enum AiJobStatus {
  PENDING
  PROCESSING
  DONE
  SKIPPED
  FAILED
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  EDITED
  DISCARDED
  /**
   * Llegó un mensaje más nuevo y este borrador ya no aplica.
   */
  SUPERSEDED
  /**
   * El modo automático acotado la envió sin intervención humana.
   */
  AUTO_SENT
  /**
   * El modo automático decidió no responder y entregó el hilo a una persona.
   */
  HANDOFF
}

/**
 * En qué quedó la gestión con un cliente.
 * `PROMISE_BROKEN` es la incumplida **confirmada** (alguien la marcó). La
 * promesa que venció y nadie revisó no se guarda: se deduce de `dueAt`, así
 * que si el cliente paga después, marcar `PAID` la deja en paz sin tener que
 * deshacer nada.
 */
enum ContactOutcomeType {
  PROMISE
  PROMISE_BROKEN
  PAID
  /**
   * «Ya pagué» dicho por el deudor desde un botón. **No** es un pago
   * confirmado: es una promesa de conciliación, y los reportes lo cuentan
   * aparte justo para que nadie lo confunda con recuperación.
   */
  REPORTED_PAYMENT
  /**
   * El deudor dice que no reconoce la deuda: pausa y revisión.
   */
  DISPUTED
  CONVENIO
  NO_ANSWER
  WRONG_NUMBER
  NOT_INTERESTED
  CALLBACK
  OTHER
}

/**
 * Lo que hace una respuesta de botón además de registrar el resultado.
 * Se mantiene corto a propósito: cualquier cosa más elaborada se hace con las
 * reglas de la herramienta (resultado de gestión), no inventando efectos.
 */
enum ReplyEffect {
  NONE
  /**
   * Deja de escribirle hasta que alguien lo revise (cuenta en disputa).
   */
  PAUSE_ACCOUNT
  /**
   * Da de baja al contacto, igual que la palabra clave.
   */
  OPT_OUT
}

/**
 * Traduce lo que el deudor toca al resultado de gestión que ya existe.
 * Es editable por el despacho porque cada operación cobra distinto: lo que no
 * cambia es la llave, que es el `id` del botón (con el texto como respaldo,
 * porque no siempre viene un identificador propio).
 */
model InteractiveReplyRule {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /**
   * El identificador que manda Meta cuando tocan el botón.
   */
  replyId    String
  /**
   * El texto del botón; se usa como respaldo si Meta no manda identificador.
   */
  replyTitle String?

  outcomeType ContactOutcomeType
  effect      ReplyEffect        @default(NONE)
  note        String?
  isActive    Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, replyId])
  @@index([workspaceId])
}

model Workspace {
  id                      String           @id @default(cuid())
  name                    String
  slug                    String           @unique
  status                  WorkspaceStatus  @default(ACTIVE)
  /**
   * Giro con el que se arrancó esta instalación. Hoy solo cambia el matiz
   * de la interfaz y el playbook; no bifurca el código.
   */
  profile                 WorkspaceProfile @default(GENERICO)
  legalName               String?
  rfc                     String?
  taxRegime               String?
  authorizedScheduleStart String           @default("08:00")
  authorizedScheduleEnd   String           @default("21:00")

  /**
   * Horario de atención (fuera de horario). Todo es opcional y apagado por
   * defecto: sin `businessHoursEnabled`, la instalación se comporta igual que
   * antes. `businessHours` trae `{ timezone, days, start, end }`.
   */
  businessHoursEnabled       Boolean      @default(false)
  businessHours              Json?
  offHoursMode               OffHoursMode @default(TEXT_ONLY)
  offHoursMessage            String?
  offHoursReplyIntervalHours Int          @default(12)

  /**
   * Listas interactivas (más de 3 opciones). Apagado por defecto.
   */
  interactiveListsEnabled Boolean @default(false)

  /**
   * Captura de leads. Apagado por defecto.
   */
  leadsEnabled Boolean @default(false)

  /**
   * URL y secreto del webhook saliente de leads (firmado con HMAC).
   */
  leadWebhookUrl    String?
  leadWebhookSecret String?

  /**
   * Valoración 👍/👎 al cerrar una conversación. Apagado por defecto.
   */
  feedbackEnabled Boolean                @default(false)
  feedback        ConversationFeedback[]

  /**
   * Idiomas de respuesta de la IA además del español. Vacío = solo español.
   * Valores admitidos: "en" y "pt".
   */
  aiMultilangLanguages String[] @default([])

  /**
   * Asignación y escalamiento de handoff.
   */
  handoffEscalationMinutes Int     @default(15)
  autoAssignToAdmin        Boolean @default(true)

  settings                 WorkspaceSettings?
  whatsappAccount          WhatsAppAccount?
  users                    User[]
  contacts                 Contact[]
  tags                     Tag[]
  templates                Template[]
  conversations            Conversation[]
  campaigns                Campaign[]
  messages                 Message[]
  logs                     Log[]
  webhookEvents            WebhookEvent[]
  quickReplies             QuickReply[]
  outcomes                 ContactOutcome[]
  complaints               Complaint[]
  authorizedContactMethods AuthorizedContactMethod[]
  /**
   * Traducción de las respuestas de botón a resultados de gestión.
   */
  interactiveReplyRules    InteractiveReplyRule[]

  /**
   * Capa de IA. Todo es opcional: sin fila en `AiSettings` la herramienta
   * funciona igual que antes.
   */
  aiSettings       AiSettings?
  aiUsageMonthly   AiUsageMonthly[]
  knowledgeEntries KnowledgeEntry[]
  aiSuggestions    AiSuggestion[]
  aiJobs           AiSuggestionJob[]
  aiUsage          AiUsage[]
  flows            Flow[]
  leads            Lead[]

  /**
   * Flujos precargados (respuesta automática por palabra clave).
   */
  flowsEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Flujo precargado (una sola respuesta automática por palabra clave).
 * No es un chatbot con pasos: al recibir un mensaje cuyo texto contiene el
 * trigger, se envía reply con botones o lista. La respuesta del cliente entra
 * por el circuito de interactivos ya existente. Se carga desde
 * seeds/verticals y no se pisa si ya existe (idempotente por slug).
 */
model Flow {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  slug    String
  name    String
  trigger String
  reply   String

  /**
   * Botones (hasta 3) o lista (1 sección, hasta 10 filas). Uno de los dos.
   */
  buttons Json?
  list    Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
}

/**
 * Lead capturado (nombre, correo, interés). No es un CRM: solo se captura el
 * contacto para derivarlo o exportarlo. Nombre y correo van cifrados; el
 * correo además lleva índice ciego para la idempotencia por conversación.
 */
model Lead {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  name      String?
  email     String?
  emailHash String?
  interest  String?
  source    String

  status LeadStatus @default(NUEVO)

  webhookSentAt   DateTime?
  webhookFailedAt DateTime?
  webhookError    String?
  webhookAttempts Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, conversationId, emailHash])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

/**
 * Valoración opcional de una conversación cerrada (👍/👎).
 */
model ConversationFeedback {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversationId String        @unique
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  value          FeedbackValue
  createdAt      DateTime      @default(now())

  @@index([workspaceId, createdAt])
}

model WorkspaceSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /**
   * Solo lo que la aplicación realmente usa.
   * Antes esta tabla prometía horarios de atención, mensaje fuera de horario,
   * modo de asignación, idioma y límites de conversaciones activas: ningún
   * código los leía y no había pantalla para editarlos. Se quitaron para que
   * la base no prometa lo que la herramienta no hace.
   * - `timezone`: fechas de la bitácora, topes diarios y reportes.
   * - `maxManualMessages`: tope diario de mensajes manuales por agente,
   * cuando el agente no tiene uno propio.
   * La asignación automática es siempre por carga (`LEAST_BUSY`): es la única
   * implementada, así que no hay nada que configurar.
   */
  timezone String @default("America/Mexico_City")

  /**
   * Tope diario de mensajes manuales por agente (ver arriba).
   */
  maxManualMessages Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  /**
   * Correo de acceso, **cifrado** en la base (AES-256-GCM, como el resto de
   * los datos personales). `emailHash` es el índice ciego que conserva la
   * unicidad y permite encontrarlo en el inicio de sesión sin tenerlo en
   * claro; se calcula siempre sobre el correo normalizado (minúsculas y sin
   * espacios).
   */
  email     String
  emailHash String @unique
  password  String

  role   UserRole
  status UserStatus @default(OFFLINE)

  /**
   * Preferencias de notificación (apagadas por defecto).
   */
  notifySoundEnabled   Boolean @default(false)
  notifyBrowserEnabled Boolean @default(false)

  isActive Boolean @default(true)

  /**
   * Cambio obligatorio de contraseña: se activa cuando un administrador
   * restablece la contraseña de alguien. En el siguiente inicio de sesión el
   * sistema solo deja cambiar la contraseña.
   */
  mustChangePassword Boolean @default(false)

  /**
   * Verificación en dos pasos (TOTP). El secreto se guarda **cifrado**,
   * como cualquier credencial; `twoFactorEnabledAt` queda vacío mientras
   * nadie haya confirmado un código, así que un secreto a medias no bloquea
   * el acceso.
   */
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  canSendManualMessages Boolean @default(false)
  manualMessageLimit    Int?

  lastLoginAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions UserSession[]

  sentMessages     Message[]        @relation("MessageSentByUser")
  campaigns        Campaign[]       @relation("CampaignCreatedBy")
  quickReplies     QuickReply[]     @relation("QuickReplyCreatedBy")
  outcomes         ContactOutcome[] @relation("ContactOutcomeCreatedBy")
  contactsOptIn    Contact[]        @relation("ContactOptIn")
  complaintsOpened Complaint[]      @relation("ComplaintOpenedBy")
  complaintsClosed Complaint[]      @relation("ComplaintClosedBy")

  aiSettingsUpdated       AiSettings[]     @relation("AiSettingsUpdatedBy")
  knowledgeEntriesCreated KnowledgeEntry[] @relation("KnowledgeEntryCreatedBy")

  assignedConversations Conversation[] @relation("ConversationAssignedUser")
  aiPausedConversations Conversation[] @relation("ConversationAiPausedBy")

  assignmentsMade AssignmentHistory[] @relation("AssignmentAssignedBy")
  assignmentsFrom AssignmentHistory[] @relation("AssignmentFromUser")
  assignmentsTo   AssignmentHistory[] @relation("AssignmentToUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([role])
  @@index([status])
}

model UserSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId   String  @unique
  ip        String?
  userAgent String?

  isActive Boolean @default(true)

  expiresAt  DateTime
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([isActive])
}

model WhatsAppAccount {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  businessAccountId String
  accessToken       String
  verifyToken       String
  apiVersion        String @default("v23.0")

  numbers WhatsAppNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Un número de la WABA. La WABA aporta las credenciales (token y verify
 * token) y cada número aporta su identidad, su calidad y sus hilos.
 */
model WhatsAppNumber {
  id                String          @id @default(cuid())
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  phoneNumberId String  @unique
  displayName   String?
  phoneNumber   String

  status         String?
  qualityRating  String?
  /**
   * Nivel de mensajería que reporta Meta, por ejemplo "1K".
   */
  messagingLimit String?

  isActive Boolean @default(true)

  /**
   * Interruptor de IA por número. El workspace puede tener la IA encendida
   * y este número apagado (o al revés, pero el workspace manda).
   */
  aiEnabled Boolean @default(true)

  /**
   * Interruptor de flujos por número. El workspace también tiene su propio
   * interruptor maestro; si cualquiera de los dos está apagado, no corren.
   */
  flowsEnabled Boolean @default(true)

  /**
   * Mes ("2026-11") en el que ya se avisó que el número pasó el umbral del
   * tramo mensual. Sirve para no repetir la alerta cada vez que se abre el
   * panel.
   */
  usageAlertMonth String?

  conversations Conversation[]
  campaigns     Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappAccountId])
  @@index([isActive])
}

model Contact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  profileName String?
  customName  String?
  /**
   * Teléfono cifrado; `phoneHash` es el índice ciego para búsquedas exactas.
   */
  phone       String
  phoneHash   String
  notes       String?

  isActive Boolean @default(true)

  /**
   * Consentimiento: cuándo aceptó recibir mensajes (se puede registrar a
   * mano) y cuándo pidió la baja. Si `optOutAt` tiene valor, la herramienta
   * no envía nada a ese contacto.
   */
  optInAt  DateTime?
  /**
   * Registro formal del consentimiento: por qué canal llegó (formulario,
   * WhatsApp, contrato, importación…) y quién lo capturó. Es la defensa
   * documental del operador ante una revisión.
   */
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /** Índice ciego del nombre visible: permite búsqueda exacta sin tenerlo en claro.
   */
  nameHash String?

  optInSource       String?
  optInRecordedById String?
  optInRecordedBy   User?     @relation("ContactOptIn", fields: [optInRecordedById], references: [id], onDelete: SetNull)
  optOutAt          DateTime?
  optOutSource      String?

  /**
   * Cuenta en revisión: el deudor dijo que no reconoce la deuda (o alguien la
   * pausó a mano). Mientras tenga fecha, la herramienta **no le escribe**,
   * igual que con una baja, pero es reversible: al aclararse se quita la fecha
   * y sigue la gestión.
   */
  pausedAt     DateTime?
  pausedReason String?

  /**
   * Resultado vigente de la gestión, denormalizado desde `ContactOutcome`
   * para poder filtrar y listar sin recorrer el historial.
   * `outcomeType` va en claro a propósito: es lo que se agrupa en los
   * reportes. El monto va cifrado (`outcomeAmount`), porque dice cuánto debe
   * una persona.
   */
  outcomeType   ContactOutcomeType?
  outcomeAt     DateTime?
  outcomeById   String?
  outcomeAmount String?
  /**
   * Fecha compromiso de la promesa o del convenio.
   */
  outcomeDueAt  DateTime?
  /**
   * Fecha en que el cliente pagó, según quien lo registró.
   */
  outcomePaidAt DateTime?

  /**
   * Llamada agendada (en UTC). La tarea sigue siendo «volver a llamar», pero
   * con una hora concreta: así no compite con todo lo demás del día.
   */
  scheduledCallAt DateTime?

  lastSeenAt DateTime?

  tags               ContactTag[]
  conversations      Conversation[]
  campaignRecipients CampaignRecipient[]
  outcomes           ContactOutcome[]
  complaints         Complaint[]
  leads              Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, phoneHash])
  @@index([workspaceId])
  @@index([phoneHash])
  @@index([workspaceId, nameHash])
  @@index([pausedAt])
  @@index([optOutAt])
  @@index([outcomeType])
  @@index([outcomeDueAt])
  @@index([isActive])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name     String
  color    String?
  isActive Boolean @default(true)

  contacts ContactTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([contactId, tagId])
}

model Template {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  metaTemplateId String?
  name           String
  language       String
  category       String?
  status         String
  components     Json?

  lastSyncedAt DateTime?

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name, language])
  @@index([workspaceId])
  @@index([status])
}

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  whatsappNumberId String
  whatsappNumber   WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)

  assignedUserId String?
  assignedUser   User?   @relation("ConversationAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /**
   * Pausa de la IA para este hilo. Mientras tenga fecha, el modo automático
   * no responde: una persona tomó el control. Se activa a mano desde la
   * bandeja y sola en cuanto alguien del equipo envía un mensaje.
   */
  aiPausedAt   DateTime?
  aiPausedById String?
  aiPausedBy   User?     @relation("ConversationAiPausedBy", fields: [aiPausedById], references: [id], onDelete: SetNull)

  /**
   * Última vez que la IA entregó el hilo a una persona y por qué. Sirve para
   * pintar el aviso en la bandeja y para las métricas de handoff.
   */
  aiHandoffAt     DateTime?
  aiHandoffReason String?

  /**
   * Última vez que se mandó la respuesta automática de fuera de horario en
   * este hilo. Sirve para no repetirla más de una vez por intervalo.
   */
  lastOffHoursReplyAt DateTime?

  /**
   * Última vez que se escaló este hilo sin asignar a todos los administradores.
   */
  handoffEscalatedAt DateTime?

  status            ConversationStatus            @default(OPEN)
  operationalStatus ConversationOperationalStatus @default(UNASSIGNED)
  source            ConversationSource

  lastMessageAt         DateTime?
  lastIncomingMessageAt DateTime?
  closedAt              DateTime?

  /**
   * Mensajes entrantes sin leer. Se incrementa con cada mensaje del cliente
   * y se pone en cero cuando alguien abre el hilo.
   */
  unreadCount Int @default(0)

  messages    Message[]
  assignments AssignmentHistory[]
  outcomes    ContactOutcome[]
  complaints  Complaint[]

  /**
   * Decisiones de IA de este hilo (borradores y envíos automáticos).
   */
  aiSuggestions AiSuggestion[]
  aiJobs        AiSuggestionJob[]
  leads         Lead[]
  feedback      ConversationFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Un hilo por contacto y número: WhatsApp trata cada número como una
   * conversación distinta, y la ventana de 24 horas es por par.
   */
  @@unique([whatsappNumberId, contactId])
  @@index([workspaceId])
  @@index([whatsappNumberId])
  @@index([contactId])
  @@index([assignedUserId])
  @@index([status])
  @@index([operationalStatus])
  @@index([lastMessageAt])
}

model Message {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sentByUserId String?
  sentByUser   User?   @relation("MessageSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /**
   * Envío automático de IA: enlaza el mensaje con la decisión que lo originó.
   * Es único, así que un reintento del worker no puede mandar dos veces la
   * misma respuesta.
   */
  aiSuggestionId String?       @unique
  aiSuggestion   AiSuggestion? @relation(fields: [aiSuggestionId], references: [id], onDelete: SetNull)
  aiModel        String?

  wamid String? @unique

  direction MessageDirection
  type      MessageType
  status    MessageStatus    @default(CREATED)
  source    MessageSource

  body     String?
  mediaId  String?
  mimeType String?

  /**
   * Respuesta de un botón o de una lista (mensaje interactivo entrante).
   * `replyId` va **en claro** a propósito: es la llave con la que se mapea la
   * respuesta a un resultado de gestión, así que se filtra y se compara. El
   * título es lo que la persona vio y se leyó ("Ya pagué"), y va **cifrado**
   * como el resto del contenido; por eso no se puede buscar por él.
   */
  interactiveType String?
  replyId         String?
  replyTitle      String?

  mediaPath          String?
  mediaSize          Int?
  mediaFilename      String?
  mediaDownloadedAt  DateTime?
  mediaDownloadError String?

  /**
   * Borrado suave: el mensaje desaparece del hilo pero sigue en la base
   * y se puede restaurar desde el panel del admin.
   */
  deletedAt DateTime?

  /**
   * Nota interna: se ve en el panel y nunca sale a WhatsApp. No cuenta
   * para el límite diario de mensajes manuales.
   */
  isInternalNote Boolean @default(false)

  metaPayload  Json?
  metaResponse Json?

  campaignRecipient CampaignRecipient?
  complaints        Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([conversationId])
  @@index([status])
  @@index([direction])
  @@index([createdAt])
  @@index([sentByUserId, createdAt])
}

model AssignmentHistory {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  fromUserId String?
  fromUser   User?   @relation("AssignmentFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)

  toUserId String?
  toUser   User?   @relation("AssignmentToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  assignedById String
  assignedBy   User   @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  reason String?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([assignedById])
}

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  whatsappNumberId String
  whatsappNumber   WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Restrict)

  name   String
  status CampaignStatus @default(DRAFT)

  totalRecipients     Int @default(0)
  validRecipients     Int @default(0)
  invalidRecipients   Int @default(0)
  duplicateRecipients Int @default(0)
  /**
   * Contactos que no se incluyeron por haber pedido la baja.
   */
  skippedRecipients   Int @default(0)

  recipients CampaignRecipient[]
  messages   Message[]

  /**
   * Cuándo debe salir sola (UTC). Solo aplica al estado SCHEDULED.
   */
  scheduledFor DateTime?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([whatsappNumberId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model CampaignRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  messageId String?  @unique
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  phone  String
  status CampaignRecipientStatus @default(PENDING)

  errorCode    String?
  errorMessage String?
  variables    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([contactId])
  @@index([messageId])
  @@index([status])
  @@index([phone])
}

/**
 * Respuesta rápida: un texto guardado que el equipo inserta en el hilo con
 * un clic. Admite `{nombre}` y `{telefono}` del contacto.
 */
model QuickReply {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title String
  /**
   * Texto de la respuesta, cifrado en la base como el resto del contenido.
   */
  body  String

  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("QuickReplyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, title])
  @@index([workspaceId])
  @@index([isActive])
}

/**
 * Historial de gestiones: un renglón por cada marcado, nunca se borra.
 * El estado vigente vive en `Contact`, pero sin este historial no se puede
 * responder "cuántas promesas se cumplieron", "cuántas gestiones hizo X esta
 * semana" ni "quién cambió esto".
 */
model ContactOutcome {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ContactOutcomeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  type ContactOutcomeType

  /**
   * Nota de la gestión (cifrada).
   */
  note   String?
  /**
   * Monto prometido o pagado: texto cifrado que la app interpreta como número.
   */
  amount String?
  /**
   * Fecha compromiso (en claro: se filtra y ordena por ella).
   */
  dueAt  DateTime?
  /**
   * Fecha en que pagó, según quien registra (puede ser anterior a hoy).
   */
  paidAt DateTime?

  /**
   * `PANEL` (desde el hilo) o `BULK` (marcado en bloque desde Contactos).
   */
  source String @default("PANEL")

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type])
  @@index([workspaceId, dueAt])
  @@index([contactId, createdAt])
}

model Complaint {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  motive      ComplaintMotive
  channel     ComplaintChannel
  description String
  resolution  String?
  status      ComplaintStatus  @default(ABIERTA)

  openedAt    DateTime  @default(now())
  openedById  String
  openedBy    User      @relation("ComplaintOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("ComplaintClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  escalatedAt DateTime?
  escalatedTo String?
  evidence    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, openedAt])
  @@index([workspaceId, status])
  @@index([contactId])
  @@index([conversationId])
}

model AuthorizedContactMethod {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     ComplaintChannel
  identifier  String
  label       String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, active])
}

model Log {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  level   LogLevel
  module  LogModule
  action  String
  message String

  payload Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([level])
  @@index([module])
  @@index([createdAt])
}

model WebhookEvent {
  id String @id @default(cuid())

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  phoneNumberId String?

  payload Json

  status   WebhookEventStatus @default(PENDING)
  attempts Int                @default(0)

  nextAttemptAt DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([workspaceId])
}

/**
 * Configuración de la capa de IA por workspace.
 * Nace apagada y en **modo sugerencia**: la IA redacta y una persona decide.
 * El modo `AUTO` es la respuesta automática acotada: solo envía cuando la
 * política lo permite y, si duda, entrega el hilo a una persona.
 */
model AiSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  mode    AiMode  @default(SUGGEST)

  /**
   * Texto adicional del negocio: qué hace, cómo habla y qué no debe
   * prometer. Se cifra porque puede describir la operación del cliente.
   */
  systemPrompt String?
  tone         String?
  language     String  @default("es-MX")

  /**
   * Debajo de este umbral la interfaz avisa que el borrador es dudoso.
   */
  confidenceMin Float @default(0.7)

  /**
   * Límites del modo automático acotado.
   * - `maxRepliesPerDay`: respuestas automáticas por workspace y día local.
   * - `maxRepliesPerThread`: respuestas automáticas acumuladas en un mismo hilo.
   */
  maxRepliesPerDay    Int @default(50)
  maxRepliesPerThread Int @default(5)

  /**
   * Presupuesto mensual de IA en centavos de dólar. Al agotarse, el modo
   * automático deja de responder y entrega a una persona; las sugerencias
   * siguen funcionando.
   */
  monthlyBudgetCents Int @default(500)

  /**
   * Palabras que obligan a entregar la conversación a una persona.
   */
  handoffKeywords String[] @default([])

  /**
   * Override del modelo global; vacío usa `AI_MODEL`.
   */
  model String?

  updatedById String?
  updatedBy   User?   @relation("AiSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

/**
 * Base de conocimiento: la única fuente de la que la IA puede responder.
 * `question` y `answer` se cifran en reposo; `keywords` queda en claro
 * porque es lo que se usa para recuperar y no describe a una persona.
 */
model KnowledgeEntry {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  question String
  answer   String
  /**
   * Botones de respuesta rápida que acompañan a la respuesta (máx. 3,
   * título de 20). Se envían cuando la IA contesta en modo automático.
   */
  buttons  Json?
  keywords String[] @default([])
  priority Int      @default(0)
  isActive Boolean  @default(true)

  createdById String?
  createdBy   User?   @relation("KnowledgeEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /**
   * Clave de idempotencia del cargador de paquetes: la misma pregunta no se
   * duplica al cargar dos veces el paquete de un vertical.
   */
  sourceKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, isActive])
  @@index([workspaceId, priority])
}

/**
 * Trabajo de generación. Existe para no llamar al modelo dentro del webhook:
 * Meta exige un 200 rápido y un modelo puede tardar varios segundos. También
 * permite reintentos y agrupar ráfagas (debounce).
 */
model AiSuggestionJob {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /**
   * Mensaje entrante que originó el trabajo. Es único: un reintento del
   * webhook no genera dos borradores.
   */
  inboundMessageId String @unique

  status AiJobStatus @default(PENDING)

  attempts Int      @default(0)
  runAfter DateTime @default(now())

  skipReason String?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
  @@index([workspaceId])
  @@index([conversationId])
}

/**
 * Borrador que la IA propone para un mensaje entrante. Nunca se envía solo:
 * una persona lo usa, lo edita o lo descarta.
 */
model AiSuggestion {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  inboundMessageId String @unique

  /**
   * Texto propuesto (cifrado, como cualquier contenido de conversación).
   */
  body String

  confidence Float   @default(0)
  intent     String?
  handoff    Boolean @default(false)
  /**
   * Motivo del modelo para responder o entregar (cifrado).
   */
  reason     String?
  model      String

  status AiSuggestionStatus @default(PENDING)

  decidedById String?
  decidedAt   DateTime?

  /**
   * Mensaje que salió por modo automático (si se envió).
   */
  sentMessage Message?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@index([conversationId, status])
  @@index([status])
}

/**
 * Consumo de tokens por llamada. Sirve para responder «cuánto cuesta la IA»
 * con datos y para detectar un workspace que se dispara.
 */
model AiUsage {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  conversationId String?
  suggestionId   String?

  model            String
  promptTokens     Int    @default(0)
  completionTokens Int    @default(0)
  latencyMs        Int    @default(0)
  /**
   * Costo estimado de la llamada en millonésimas de dólar (micro-USD), para
   * no redondear a cero las llamadas baratas. 1 USD = 1,000,000.
   */
  costMicros       Int    @default(0)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

/**
 * Contador mensual de IA por workspace. Sustenta la promesa comercial de
 * «N respuestas de IA incluidas al mes» sin tener que sumar toda la tabla
 * de mensajes en cada consulta.
 * - `replyCount`: respuestas automáticas enviadas en el mes.
 * - `suggestCount`: borradores de sugerencia generados en el mes.
 * El mes se calcula en la zona del workspace, no en UTC.
 */
model AiUsageMonthly {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  year  Int
  month Int

  replyCount   Int @default(0)
  suggestCount Int @default(0)

  lastIncrementedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([workspaceId, year, month])
  @@index([workspaceId, year, month])
}

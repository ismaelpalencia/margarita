<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Leads | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />
    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-2xl font-bold text-slate-800">Leads</h2>
                <p class="mt-1 text-sm text-slate-500">
                    Contactos capturados con nombre y teléfono; correo, interés y datos del flujo son opcionales. Los datos sensibles van cifrados.
                </p>
            </div>

            <details class="relative">
                <summary class="cursor-pointer rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                    Exportar CSV
                </summary>
                <form action="/admin/leads/export" method="GET" class="absolute right-0 z-20 mt-2 w-72 rounded-2xl border border-slate-200 bg-white p-4 text-left shadow-lg">
                    <p class="text-xs font-bold text-slate-700">Columnas</p>
                    <div class="mt-2 grid grid-cols-2 gap-2 text-xs text-slate-600">
                        <% const csvLabels = { nombre: "Nombre", telefono: "Teléfono", email: "Correo", interes: "Interés", notas: "Comentarios", origen: "Origen", estado: "Estado", creado: "Creado", id: "ID" }; %>
                        <% csvColumns.forEach((column) => { %>
                            <label class="flex items-center gap-1.5">
                                <input type="checkbox" name="columns" value="<%= column %>" <%= ["nombre", "telefono", "email", "interes", "notas", "origen", "estado", "creado"].includes(column) ? "checked" : "" %> />
                                <%= csvLabels[column] || column %>
                            </label>
                        <% }) %>
                    </div>
                    <label class="mt-3 flex items-start gap-2 border-t border-slate-100 pt-3 text-xs text-slate-600">
                        <input type="checkbox" name="fields" value="1" class="mt-0.5" />
                        <span>Incluir campos capturados por el flujo<br><span class="text-slate-400">Agrega columnas dato_*.</span></span>
                    </label>
                    <button class="mt-3 w-full rounded-xl bg-margarita-600 px-3 py-2 text-xs font-semibold text-white hover:bg-margarita-700">Descargar CSV</button>
                </form>
            </details>

            <details class="relative">
                <summary class="cursor-pointer rounded-xl bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 ring-1 ring-red-200 hover:bg-red-100">
                    Borrar todos
                </summary>
                <form action="/admin/leads/delete-all" method="POST" class="absolute right-0 z-20 mt-2 w-80 rounded-2xl border border-red-200 bg-white p-4 text-left shadow-lg">
                    <p class="text-sm font-bold text-red-700">Borrar todos los leads</p>
                    <p class="mt-1 text-xs text-slate-500">
                        Se eliminan los leads de esta empresa. No se borran contactos, conversaciones ni mensajes. Las filas ya escritas en Google Sheets tampoco se borran.
                    </p>
                    <label class="mt-3 block text-xs font-semibold text-slate-700">Escribe BORRAR para confirmar</label>
                    <input name="confirm" required autocomplete="off" placeholder="BORRAR" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    <button class="mt-3 w-full rounded-xl bg-red-600 px-3 py-2 text-xs font-semibold text-white hover:bg-red-700">Eliminar todos los leads</button>
                </form>
            </details>
        </div>

        <% if (success === "settings") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Configuración de leads guardada.</div>
        <% } else if (success === "created") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Lead guardado.</div>
        <% } else if (success === "status") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Estado actualizado.</div>
        <% } else if (success === "retry") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Reintento enviado.</div>
        <% } else if (success === "deleted") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">Lead eliminado. Ya puedes volver a agregarlo si lo necesitas.</div>
        <% } else if (success === "deleted_all") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
                Se eliminaron <%= deletedCount || 0 %> lead(s). Los contactos y conversaciones se conservan.
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <% if (error === "name_phone") { %> El nombre y el teléfono son obligatorios. <% } else if (error === "lead_exists") { %> Ese contacto ya tiene un lead registrado. <% } else if (error === "contact") { %> El contacto ya no existe. <% } else if (error === "delete") { %> No se pudo eliminar el lead. <% } else if (error === "delete_all_confirm") { %> Para borrar todos los leads escribe BORRAR. <% } else if (error === "delete_all") { %> No se pudieron borrar todos los leads. <% } else if (error === "retry") { %> No se pudo reintentar la entrega. <% } else { %> No se pudo completar la acción. <% } %>
            </div>
        <% } %>

        <section class="mb-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h3 class="font-bold text-slate-800">Configuración</h3>

            <form action="/admin/leads/settings" method="POST" class="mt-4 grid gap-4 md:grid-cols-2">
                <label class="flex cursor-pointer items-start gap-3">
                    <input type="checkbox" name="leadsEnabled" value="true" <%= leadsEnabled ? "checked" : "" %> class="mt-1 h-5 w-5 accent-margarita-600" />
                    <span>
                        <span class="block text-sm font-bold text-slate-800">Activar captura de leads</span>
                        <span class="block text-xs text-slate-500">Cuando un mensaje trae un correo, se crea el lead automáticamente.</span>
                    </span>
                </label>

                <div>
                    <label class="block text-sm font-semibold text-slate-700">URL del webhook (opcional)</label>
                    <input type="text" name="leadWebhookUrl" value="<%= leadWebhookUrl %>" placeholder="https://tu-crm.com/webhooks/leads" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700">Secreto de firma (opcional)</label>
                    <input type="password" name="leadWebhookSecret" placeholder="<%= hasWebhookSecret ? 'ya configurado' : '' %>" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                    <p class="mt-1 text-xs text-slate-500">Se envía la cabecera x-margarita-signature con HMAC-SHA256.</p>
                </div>

                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 md:col-span-2">
                    <p class="text-sm font-bold text-slate-800">Google Sheets (opcional)</p>
                    <p class="mt-1 text-xs text-slate-500">
                        Pega la URL del Web App de Google Apps Script. Cada lead nuevo se agrega como una fila con nombre, teléfono, correo, origen y fecha.
                    </p>
                    <div class="mt-3 grid gap-3 md:grid-cols-2">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600">URL del Web App</label>
                            <input type="text" name="leadSheetsWebhookUrl" value="<%= leadSheetsWebhookUrl %>" placeholder="https://script.google.com/macros/s/.../exec" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600">Secreto de la hoja</label>
                            <input type="password" name="leadSheetsWebhookSecret" placeholder="<%= hasSheetsSecret ? 'ya configurado' : 'opcional' %>" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                        </div>
                    </div>
                </div>

                <button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800 md:col-span-2">
                    Guardar configuración
                </button>
            </form>
        </section>

        <section class="mb-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h3 class="font-bold text-slate-800">Agregar lead</h3>

            <form action="/admin/leads" method="POST" class="mt-4 grid gap-3 md:grid-cols-5">
                <div class="md:col-span-5">
                    <label class="block text-xs font-bold text-slate-600">Desde un contacto del chat</label>
                    <select name="contactId" id="lead-contact" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm">
                        <option value="">— Escribir datos manualmente —</option>
                        <% contacts.forEach((contact) => { %>
                            <% const label = contact.customName || contact.profileName || contact.phone; %>
                            <option
                                value="<%= contact.id %>"
                                data-name="<%= label %>"
                                data-phone="<%= contact.phone %>"
                                <%= leadContactIds.has(contact.id) ? "disabled" : "" %>
                            >
                                <%= label %> · <%= contact.phone %><%= leadContactIds.has(contact.id) ? " (ya tiene lead)" : "" %>
                            </option>
                        <% }) %>
                    </select>
                    <p class="mt-1 text-xs text-slate-500">Elige un contacto que ya está en tus conversaciones para no volver a capturarlo.</p>
                </div>
                <input type="text" name="name" id="lead-name" required placeholder="Nombre" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                <input type="tel" name="phone" id="lead-phone" required placeholder="Teléfono" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                <input type="email" name="email" placeholder="Correo (opcional)" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                <input type="text" name="interest" placeholder="Interés" class="rounded-xl border border-slate-300 px-3 py-2 text-sm" />
                <div class="md:col-span-5">
                    <label class="block text-xs font-bold text-slate-600">Comentarios</label>
                    <textarea name="notes" rows="3" maxlength="4000" placeholder="Qué dijo, qué necesita, cuánto paga, mejor horario…" class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"></textarea>
                </div>
                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800 md:col-span-5">Guardar</button>
            </form>
            <script>
                (function () {
                    var select = document.getElementById("lead-contact");
                    var name = document.getElementById("lead-name");
                    var phone = document.getElementById("lead-phone");
                    if (!select || !name || !phone) return;
                    select.addEventListener("change", function () {
                        var option = select.options[select.selectedIndex];
                        if (!option || !option.value) return;
                        name.value = option.dataset.name || "";
                        phone.value = option.dataset.phone || "";
                    });
                })();
            </script>
        </section>

        <section class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-4">
                <a href="/admin/leads" class="rounded-full px-3 py-1 text-xs font-bold <%= currentStatus === "ALL" ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600' %>">Todos</a>
                <% statuses.forEach((status) => { %>
                    <a href="/admin/leads?status=<%= status %>" class="rounded-full px-3 py-1 text-xs font-bold <%= currentStatus === status ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600' %>"><%= status %></a>
                <% }) %>

                <details class="relative ml-auto">
                    <summary class="cursor-pointer rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-600 ring-1 ring-slate-200">Columnas</summary>
                    <div class="absolute right-0 z-20 mt-2 w-52 rounded-2xl border border-slate-200 bg-white p-3 shadow-lg">
                        <p class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Mostrar en la tabla</p>
                        <div class="mt-2 space-y-2 text-xs text-slate-600">
                            <% [["name", "Nombre"], ["phone", "Teléfono"], ["email", "Correo"], ["interest", "Interés"], ["notes", "Comentarios"], ["fields", "Datos del flujo"], ["status", "Estado"], ["webhook", "Webhook"]].forEach(([key, label]) => { %>
                                <label class="flex items-center gap-2">
                                    <input type="checkbox" data-lead-column-toggle="<%= key %>" checked />
                                    <%= label %>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                </details>
            </div>

            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-4 py-3" data-lead-column="email">Correo</th>
                        <th class="px-4 py-3" data-lead-column="name">Nombre</th>
                        <th class="px-4 py-3" data-lead-column="phone">Teléfono</th>
                        <th class="px-4 py-3" data-lead-column="interest">Interés</th>
                        <th class="px-4 py-3" data-lead-column="notes">Comentarios</th>
                        <th class="px-4 py-3" data-lead-column="fields">Datos del flujo</th>
                        <th class="px-4 py-3" data-lead-column="status">Estado</th>
                        <th class="px-4 py-3" data-lead-column="webhook">Webhook</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% leads.forEach((lead) => { %>
                        <tr>
                            <td class="px-4 py-3" data-lead-column="email"><%= lead.email || "—" %></td>
                            <td class="px-4 py-3" data-lead-column="name"><%= lead.name || "—" %></td>
                            <td class="px-4 py-3" data-lead-column="phone"><%= lead.phone || "—" %></td>
                            <td class="px-4 py-3" data-lead-column="interest"><%= lead.interest || "—" %></td>
                            <td class="px-4 py-3 text-xs text-slate-600" data-lead-column="notes">
                                <% if (lead.notes) { %>
                                    <span class="line-clamp-2 max-w-xs" title="<%= lead.notes %>"><%= lead.notes %></span>
                                <% } else { %>
                                    —
                                <% } %>
                            </td>
                            <td class="px-4 py-3 text-xs text-slate-600" data-lead-column="fields">
                                <% if (lead.fields) { %>
                                    <details>
                                        <summary class="cursor-pointer font-semibold text-slate-700">Ver datos</summary>
                                        <div class="mt-1 max-w-xs space-y-1 rounded bg-slate-50 p-2 text-[11px]">
                                            <% Object.entries(lead.fields).forEach(([key, value]) => { %>
                                                <div>
                                                    <span class="font-semibold text-slate-700"><%= key %>:</span>
                                                    <span><%= typeof value === "string" ? value : JSON.stringify(value) %></span>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </details>
                                <% } else { %>
                                    —
                                <% } %>
                            </td>
                            <td class="px-4 py-3" data-lead-column="status">
                                <form action="/admin/leads/<%= lead.id %>/status" method="POST" class="flex items-center gap-2">
                                    <select name="status" class="rounded-xl border border-slate-300 px-2 py-1 text-xs">
                                        <% statuses.forEach((status) => { %>
                                            <option value="<%= status %>" <%= lead.status === status ? "selected" : "" %>><%= status %></option>
                                        <% }) %>
                                    </select>
                                    <button class="rounded-lg bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">Guardar</button>
                                </form>
                            </td>
                            <td class="px-4 py-3 text-xs <%= lead.webhookFailedAt ? 'text-red-600' : lead.webhookSentAt ? 'text-emerald-600' : 'text-slate-400' %>" data-lead-column="webhook">
                                <%= lead.webhookFailedAt ? "falló" : lead.webhookSentAt ? "entregado" : "pendiente" %>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <% if (lead.webhookFailedAt) { %>
                                        <form action="/admin/leads/<%= lead.id %>/retry" method="POST">
                                            <button class="rounded-lg bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700">Reintentar</button>
                                        </form>
                                    <% } %>
                                    <form action="/admin/leads/<%= lead.id %>/delete" method="POST" onsubmit="return confirm('¿Eliminar este lead? El contacto y su conversación se conservan.');">
                                        <button class="rounded-lg bg-red-50 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-100">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>

                    <% if (leads.length === 0) { %>
                        <tr>
                            <td colspan="9" class="px-4 py-8 text-center text-sm text-slate-400">Sin leads todavía.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>

    <script>
        (function () {
            var storageKey = "marga-lead-columns";
            var toggles = document.querySelectorAll("[data-lead-column-toggle]");
            if (!toggles.length) return;

            function apply(visible) {
                Object.keys(visible).forEach(function (key) {
                    var checked = visible[key] !== false;
                    document.querySelectorAll('[data-lead-column="' + key + '"]').forEach(function (cell) {
                        cell.style.display = checked ? "" : "none";
                    });
                });
            }

            var saved = {};
            try {
                saved = JSON.parse(localStorage.getItem(storageKey) || "{}") || {};
            } catch (_) {
                saved = {};
            }

            toggles.forEach(function (toggle) {
                var key = toggle.getAttribute("data-lead-column-toggle");
                if (saved[key] === false) toggle.checked = false;

                toggle.addEventListener("change", function () {
                    saved[key] = toggle.checked;
                    apply(saved);
                    try {
                        localStorage.setItem(storageKey, JSON.stringify(saved));
                    } catch (_) {
                        /* Safari privado puede bloquear localStorage. */
                    }
                });
            });

            apply(saved);
        })();
    </script>
</body>
</html>

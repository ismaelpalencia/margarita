            <section class="section proof-section">
                <div class="shell proof-grid">
                    <div>
                        <p class="section-kicker">Pensado para operación real</p>
                        <h2>Tus clientes reciben respuesta. Tu equipo, respaldo.</h2>
                    </div>
                    <div class="proof-points">
                        <div>
                            <strong>1</strong>
                            <span>solo panel para campañas, bandeja y base de conocimiento</span>

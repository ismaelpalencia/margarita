<%
    const promoVigente =
        !installPromoUntil ||
        new Date() <= new Date(`${installPromoUntil}T23:59:59`);
    const promoSpots =
        typeof installPromoSpotsLeft === "number" ? installPromoSpotsLeft : 3;
    const hasPromo =
        installPricePromo !== installPrice && promoVigente && promoSpots > 0;
    const priceB = hasPromo ? installPricePromo : installPrice;
    const priceA = installPriceWithMeta;
    const priceADisplay = priceA.replace(/^\$/, "").replace(/\s*MXN.*$/, "");
    const priceBDisplay = priceB.replace(/^\$/, "").replace(/\s*MXN.*$/, "");
    const demoText = encodeURIComponent("Hola, quiero agendar una demo de Margarita");
    const ideaShareText = encodeURIComponent(
        "Hola, equipo Margarita. Esta plantilla de atención me ha funcionado y quiero compartirla para que la revisen y, si la aprueban, la agreguen a su biblioteca.\n\nSituación en la que la uso:\n\nTexto de la plantilla:\n\nBotones (si tiene):\n\nConfirmo que quité nombres, teléfonos y datos personales de clientes."
    );
    const packageAText = encodeURIComponent("Hola, quiero el Paquete A de Margarita");
    const packageBText = encodeURIComponent("Hola, quiero el Paquete B de Margarita");
    const whatsappBase = supportWhatsappUrl || "";
    const demoUrl = whatsappBase
        ? `${whatsappBase}?text=${demoText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${demoText}`
          : "/como-empezar";
    const ideaShareUrl = whatsappBase
        ? `${whatsappBase}?text=${ideaShareText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${encodeURIComponent("Quiero compartir una plantilla de atención")}`
          : "/plantillas";
    const packageAUrl = whatsappBase
        ? `${whatsappBase}?text=${packageAText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${packageAText}`
          : "/como-empezar";
    const packageBUrl = whatsappBase
        ? `${whatsappBase}?text=${packageBText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${packageBText}`
          : "/como-empezar";
%>

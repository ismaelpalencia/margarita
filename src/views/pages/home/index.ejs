<%
    const promoVigente =
        !installPromoUntil ||
        new Date() <= new Date(`${installPromoUntil}T23:59:59`);
    const promoSpots =
        typeof installPromoSpotsLeft === "number" ? installPromoSpotsLeft : 3;
    const hasPromo =
        installPricePromo !== installPrice && promoVigente && promoSpots > 0;
    const priceB = hasPromo ? installPricePromo : installPrice;
    const priceA = installPriceWithMeta;
    const priceADisplay = priceA.replace(/^\$/, "").replace(/\s*MXN.*$/, "");
    const priceBDisplay = priceB.replace(/^\$/, "").replace(/\s*MXN.*$/, "");
    const demoText = encodeURIComponent("Hola, quiero agendar una demo de Margarita");
    const templateShareText = encodeURIComponent(
        "Hola, equipo Margarita. Esta plantilla de cobranza me ha funcionado y quiero compartirla para que la revisen y, si la aprueban, la agreguen a su biblioteca.\n\nSituación en la que la uso:\n\nTexto de la plantilla:\n\nBotones (si tiene):\n\nConfirmo que quité nombres, teléfonos, saldos y datos personales de clientes."
    );
    const packageAText = encodeURIComponent("Hola, quiero el Paquete A de Margarita");
    const packageBText = encodeURIComponent("Hola, quiero el Paquete B de Margarita");
    const whatsappBase = supportWhatsappUrl || "";
    const demoUrl = whatsappBase
        ? `${whatsappBase}?text=${demoText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${demoText}`
          : "/como-empezar";
    const templateShareUrl = whatsappBase
        ? `${whatsappBase}?text=${templateShareText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${encodeURIComponent("Quiero compartir una plantilla de cobranza")}`
          : "/plantillas";
    const packageAUrl = whatsappBase
        ? `${whatsappBase}?text=${packageAText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${packageAText}`
          : "/como-empezar";
    const packageBUrl = whatsappBase
        ? `${whatsappBase}?text=${packageBText}`
        : supportEmail
          ? `mailto:${supportEmail}?subject=${packageBText}`
          : "/como-empezar";
%>
<!doctype html>
<html lang="es-MX">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title><%= title || "Margarita — Cobranza por WhatsApp para equipos" %></title>
<%- include("../../partials/brand-head") %>
<link rel="stylesheet" href="/css/landing-2026.css" />
    </head>
    <body>
        <a class="skip-link" href="#contenido">Saltar al contenido</a>

        <header class="site-header">
            <div class="shell header-inner">
                <a class="brand" href="#inicio" aria-label="Margarita, inicio">
                    <img class="brand-logo" src="/brand/img/margarita-icon-128.png" alt="" aria-hidden="true" />
                    <span class="brand-copy">
                        <strong>Margarita</strong>
                        <small>cobranza por WhatsApp</small>
                    </span>
                </a>

                <nav class="desktop-nav" aria-label="Navegación principal">
                    <a href="#solucion">Cómo ayuda</a>
                    <a href="#como-funciona">Cómo funciona</a>
                    <a href="#biblioteca">Biblioteca</a>
                    <a href="#precios">Precios</a>
                    <a href="#no-es">Qué no es</a>
                </nav>

                <a class="button button-small header-cta" href="<%= demoUrl %>">
                    Agendar demo
                </a>

                <details class="mobile-menu">
                    <summary aria-label="Abrir menú">Menú</summary>
                    <nav aria-label="Navegación móvil">
                        <a href="#solucion">Cómo ayuda</a>
                        <a href="#como-funciona">Cómo funciona</a>
                        <a href="#biblioteca">Biblioteca de plantillas</a>
                        <a href="#precios">Precios</a>
                        <a href="#no-es">Qué no es</a>
                        <a href="#contacto">Contacto</a>
                    </nav>
                </details>
            </div>
        </header>

        <main id="contenido">
            <section class="hero" id="inicio">
                <div class="hero-glow" aria-hidden="true"></div>
                <div class="shell hero-grid">
                    <div class="hero-copy">
                        <p class="eyebrow">
                            <span class="pulse-dot" aria-hidden="true"></span>
                            Cobranza conversacional · API oficial de WhatsApp
                        </p>

                        <h1>
                            Recupera tu cartera por WhatsApp
                            <span>con seguimiento y controles de acceso.</span>
                        </h1>

                        <p class="lede">
                            Margarita es la herramienta oficial de WhatsApp que permite
                            a tus clientes <strong>pedir que los llamen con botones que configura tu equipo</strong>. Tu
                            equipo atiende las conversaciones; los datos sensibles se
                            cifran en la base y los accesos se controlan por rol. El
                            primer mes es un <strong>piloto pagado de <%= pilotDays %> días</strong>,
                            sin penalización si decides no continuar.
                        </p>

                        <div class="hero-actions">
                            <a class="button button-primary" href="<%= demoUrl %>">
                                Conoce el piloto de <%= pilotDays %> días
                                <span aria-hidden="true">→</span>
                            </a>
                            <a class="button button-secondary" href="#como-funciona">
                                Ver cómo funciona
                                <span class="play-mark" aria-hidden="true"></span>
                            </a>
                        </div>

                        <ul class="hero-proof" aria-label="Características principales">
                            <li><span class="check" aria-hidden="true"></span> Datos sensibles cifrados en la base</li>
                            <li><span class="check" aria-hidden="true"></span> Sin chatbot que conteste automáticamente</li>
                            <li><span class="check" aria-hidden="true"></span> México y números internacionales</li>
                        </ul>

                        <p class="hero-note">
                            Instalación desde <strong><%= priceB %> + IVA</strong>. El primer
                            mes está incluido y es tu piloto.
                        </p>
                    </div>

                    <div class="hero-visual" aria-label="Vista ilustrativa del panel de Margarita">
                        <div class="visual-orbit orbit-one" aria-hidden="true"></div>
                        <div class="visual-orbit orbit-two" aria-hidden="true"></div>

                        <div class="chat-window">
                            <div class="chat-top">
                                <span class="avatar avatar-green" aria-hidden="true">CP</span>
                                <div>
                                    <strong>Cobranza Palencia</strong>
                                    <small>en línea · respuesta humana</small>
                                </div>
                                <span class="chat-more" aria-hidden="true">•••</span>
                            </div>

                            <div class="chat-body">
                                <div class="day-label">HOY</div>

                                <div class="bubble bubble-in">
                                    Hola, Laura. Vimos que tienes un saldo pendiente de
                                    <strong>$2,400</strong>. ¿Te ayudo a revisarlo?
                                </div>

                                <div class="bubble bubble-out">
                                    Sí, quiero ponerme al día. ¿Me pueden llamar?
                                    <span class="bubble-time">10:42 ✓✓</span>
                                </div>

                                <div class="interactive-card">
                                    <p>¿Qué prefieres hacer?</p>
                                    <span class="fake-button">
                                        <span class="phone-mark" aria-hidden="true"></span>
                                        Quiero que me llamen
                                    </span>
                                    <span class="fake-link">Escribir un mensaje</span>
                                </div>

                                <div class="typing">
                                    <span></span><span></span><span></span>
                                    Laura está escribiendo…
                                </div>
                            </div>

                            <div class="chat-input" aria-hidden="true">
                                <span>Escribe un mensaje…</span>
                                <span class="send-mark">➤</span>
                            </div>
                        </div>

                        <aside class="report-card">
                            <div class="report-head">
                                <div>
                                    <small>HOY</small>
                                    <strong>Llamadas pedidas</strong>
                                </div>
                                <span class="count-badge">3</span>
                            </div>

                            <div class="call-row">
                                <span class="avatar avatar-warm" aria-hidden="true">ML</span>
                                <div>
                                    <strong>María López</strong>
                                    <small>hace 4 min · pidió llamada</small>
                                </div>
                                <span class="call-time">4 min</span>
                            </div>

                            <div class="call-row">
                                <span class="avatar avatar-blue" aria-hidden="true">JR</span>
                                <div>
                                    <strong>Jorge Ramírez</strong>
                                    <small>promesa para hoy</small>
                                </div>
                                <span class="call-amount">$1,850</span>
                            </div>

                            <div class="report-footer">
                                <span class="mini-chart" aria-hidden="true">
                                    <i></i><i></i><i></i><i></i><i></i><i></i>
                                </span>
                                <span>+18% recuperado esta semana</span>
                            </div>
                        </aside>

                        <div class="floating-badge badge-security">
                            <span class="shield-mark" aria-hidden="true"></span>
                            <span><strong>AES-256</strong><small>datos protegidos</small></span>
                        </div>
                        <div class="floating-badge badge-pilot">
                            <span class="pilot-mark" aria-hidden="true"><%= pilotDays %></span>
                            <span><strong>días de piloto</strong><small>sin penalización</small></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pain-section" id="dolor">
                <div class="shell pain-grid">
                    <div>
                        <p class="section-kicker">El problema</p>
                        <h2>Cobrar no debería ser una batalla campal</h2>
                    </div>
                    <div class="pain-copy">
                        <p>
                            Llamar y que te cuelguen, mandar correos que nadie lee o
                            tener los teléfonos de tus clientes dispersos en varios Excel,
                            <strong>con riesgo de errores y accesos sin control</strong>. Así es como
                            la mayoría de las empresas pierden dinero y desgastan a su
                            equipo.
                        </p>
                        <div class="pain-tags" aria-label="Problemas comunes">
                            <span>Excel disperso</span>
                            <span>Mensajes sin contexto</span>
                            <span>Equipo desgastado</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section solution-section" id="solucion">
                <div class="shell">
                    <div class="section-heading centered">
                        <p class="section-kicker">La solución</p>
                        <h2>El control vuelve a tus manos</h2>
                        <p>
                            Menos persecución, más conversaciones que terminan en un
                            acuerdo. Y todo con evidencia de qué pasó con cada cliente.
                        </p>
                    </div>

                    <div class="feature-grid">
                        <article class="feature-card feature-card--accent">
                            <div class="feature-icon">
                                <span class="icon-phone" aria-hidden="true"></span>
                            </div>
                            <p class="feature-number">01</p>
                            <h3>Llamadas pedidas</h3>
                            <p>
                                El cliente toca el botón que configuraste y tú lo llamas. Margarita te
                                avisa cuánto tiempo lleva esperando para que lo
                                priorices el seguimiento mientras la solicitud sigue
                                reciente. La llamada la realiza una persona del equipo.
                            </p>
                            <span class="feature-tag">La función estrella</span>
                        </article>

                        <article class="feature-card">
                            <div class="feature-icon">
                                <span class="icon-shield" aria-hidden="true"></span>
                            </div>
                            <p class="feature-number">02</p>
                            <h3>Datos cifrados y acceso por rol</h3>
                            <p>
                                Los nombres, teléfonos, mensajes y montos de gestión
                                se cifran en la base de datos. El cifrado ayuda a
                                proteger la información almacenada; el consentimiento
                                y el uso adecuado de los datos siguen a cargo de tu equipo.
                            </p>
                            <span class="feature-tag">AES-256-GCM</span>
                        </article>

                        <article class="feature-card">
                            <div class="feature-icon">
                                <span class="icon-people" aria-hidden="true"></span>
                            </div>
                            <p class="feature-number">03</p>
                            <h3>No es un chatbot</h3>
                            <p>
                                Tus agentes humanos dan la cara. Margarita ordena el
                                caos: distingue promesas, pagos reportados por el cliente
                                y pagos que tu equipo marca como confirmados.
                            </p>
                            <span class="feature-tag">Copiloto para tu equipo</span>
                        </article>
                    </div>
                </div>
            </section>

            <section class="section library-section" id="biblioteca">
                <div class="shell">
                    <div class="section-heading centered library-heading">
                        <p class="section-kicker">Ideas hechas para cobranza</p>
                        <h2>No empieces con una página en blanco</h2>
                        <p>
                            Margarita incluye una biblioteca de ideas para primer contacto,
                            recordatorios y promesas de pago. Adáptalas a tu operación y
                            crea la versión final en Meta.
                        </p>
                    </div>

                    <div class="library-grid">
                        <article class="library-card">
                            <div class="library-card-brand">
                                <img src="/brand/img/margarita-icon-64.png" alt="" />
                                <span>Plantilla hecha por Margarita</span>
                            </div>
                            <p class="library-scenario">Primer contacto</p>
                            <h3>Inicia la conversación con cuidado</h3>
                            <blockquote>
                                “Te contactamos de parte de {{1}} para conversar sobre un asunto relacionado con una cuenta. Para proteger tu información, podemos compartir más detalles cuando confirmemos que hablamos con la persona indicada.”
                            </blockquote>
                            <div class="library-buttons" aria-label="Ejemplos de botones">
                                <span>Número equivocado</span>
                                <span>Quiero que me llame un asesor</span>
                            </div>
                        </article>

                        <article class="library-card">
                            <div class="library-card-brand">
                                <img src="/brand/img/margarita-icon-64.png" alt="" />
                                <span>Plantilla hecha por Margarita</span>
                            </div>
                            <p class="library-scenario">Promesa de pago</p>
                            <h3>Confirma el acuerdo</h3>
                            <blockquote>
                                “Registramos la fecha de pago que acordaste para el {{2}}. Si necesitas revisar o cambiar este compromiso, responde para que nuestro equipo te apoye.”
                            </blockquote>
                            <div class="library-buttons" aria-label="Ejemplos de botones">
                                <span>Necesito plazo</span>
                                <span>Quiero que me llame un asesor</span>
                            </div>
                        </article>

                        <article class="library-card">
                            <div class="library-card-brand">
                                <img src="/brand/img/margarita-icon-64.png" alt="" />
                                <span>Plantilla hecha por Margarita</span>
                            </div>
                            <p class="library-scenario">Pago reportado</p>
                            <h3>Confirma que recibiste el aviso</h3>
                            <blockquote>
                                “Recibimos tu aviso de pago. Nuestro equipo revisará la información y te confirmará cuando quede aplicado.”
                            </blockquote>
                            <div class="library-buttons" aria-label="Ejemplo de botón">
                                <span>Quiero que me llame un asesor</span>
                            </div>
                        </article>
                    </div>

                    <div class="library-note">
                        <span class="library-note-mark" aria-hidden="true">i</span>
                        <p>
                            Son ejemplos, <strong>no plantillas aprobadas por Meta</strong>.
                            Cada cuenta las adapta y las envía a revisión. Meta determina la
                            aprobación y la categoría final.
                        </p>
                    </div>

                    <div class="community-share">
                        <div class="community-share-copy">
                            <p class="section-kicker">Biblioteca viva</p>
                            <h3>¿Una plantilla de cobranza te ha funcionado?</h3>
                            <p>
                                Compártela con nuestro equipo. Si la revisamos y la aprobamos,
                                la sumamos a la biblioteca para ayudar a otras operaciones.
                            </p>
                        </div>
                        <a class="button button-primary" href="<%= templateShareUrl %>" target="_blank" rel="noopener noreferrer">
                            Compartir por WhatsApp
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>

                    <p class="library-privacy-note">
                        Al compartir, quita nombres, teléfonos, saldos y cualquier dato personal de clientes.
                        Margarita revisa las propuestas antes de publicarlas.
                    </p>
                </div>
            </section>

            <section class="section how-section" id="como-funciona">
                <div class="shell how-grid">
                    <div class="how-copy">
                        <p class="section-kicker">En tres pasos</p>
                        <h2>De la lista al acuerdo, sin perder el hilo</h2>
                        <p>
                            No necesitas cambiar tu forma de cobrar. Necesitas que
                            cada conversación tenga contexto y que nadie se te escape.
                        </p>

                        <ol class="steps">
                            <li>
                                <span class="step-number">1</span>
                                <div>
                                    <h3>Conecta tu cuenta de Meta</h3>
                                    <p>
                                        Nosotros te ayudamos en el Paquete A. Tú
                                        conservas el control de tu cuenta y tu número.
                                    </p>
                                </div>
                            </li>
                            <li>
                                <span class="step-number">2</span>
                                <div>
                                    <h3>Sube tu cartera y envía plantillas</h3>
                                    <p>
                                        Importa contactos desde Excel o CSV y usa
                                        plantillas aprobadas para iniciar la
                                        conversación.
                                    </p>
                                </div>
                            </li>
                            <li>
                                <span class="step-number">3</span>
                                <div>
                                    <h3>Recibe llamadas, registra promesas y cobra</h3>
                                    <p>
                                        Tu equipo atiende, marca el resultado y da
                                        seguimiento. Los reportes se arman solos.
                                    </p>
                                </div>
                            </li>
                        </ol>
                    </div>

                    <div class="how-visual" aria-label="Vista ilustrativa de la bandeja de Margarita">
                        <div class="inbox-card">
                            <div class="inbox-head">
                                <div>
                                    <small>BANDEJA</small>
                                    <strong>Conversaciones abiertas</strong>
                                </div>
                                <span class="live-pill"><i></i> En vivo</span>
                            </div>
                            <div class="inbox-row active">
                                <span class="avatar avatar-warm">ML</span>
                                <div><strong>María López</strong><small>Quiero que me llamen</small></div>
                                <span class="row-time">10:42</span>
                            </div>
                            <div class="inbox-row">
                                <span class="avatar avatar-blue">JR</span>
                                <div><strong>Jorge Ramírez</strong><small>Promesa para hoy</small></div>
                                <span class="row-time">10:30</span>
                            </div>
                            <div class="inbox-row">
                                <span class="avatar avatar-green">AC</span>
                                <div><strong>Ana Cruz</strong><small>Pago reportado</small></div>
                                <span class="row-time">Ayer</span>
                            </div>
                            <div class="inbox-foot">
                                <span>3 pendientes</span>
                                <span>Ver todas →</span>
                            </div>
                        </div>
                        <div class="result-chip result-chip--promise">
                            <span class="check" aria-hidden="true"></span>
                            Promesa registrada
                        </div>
                        <div class="result-chip result-chip--call">
                            <span class="phone-mark" aria-hidden="true"></span>
                            Llamada pedida
                        </div>
                    </div>
                </div>
            </section>

            <section class="section proof-section">
                <div class="shell proof-grid">
                    <div>
                        <p class="section-kicker">Hecho para cobranza real</p>
                        <h2>Tus clientes se sienten escuchados. Tu equipo, respaldado.</h2>
                    </div>
                    <div class="proof-points">
                        <div>
                            <strong>+18%</strong>
                            <span>referencia visual de recuperación semanal</span>
                        </div>
                        <div>
                            <strong>1</strong>
                            <span>solo panel para campañas, bandeja y resultados</span>
                        </div>
                        <div>
                            <strong>0</strong>
                            <span>bots decidiendo por tus clientes</span>
                        </div>
                    </div>
                </div>
                <p class="proof-disclaimer">
                    Cifras ilustrativas de la maqueta. Los resultados dependen de tu
                    cartera y de la operación de tu equipo.
                </p>
            </section>

            <section class="section pricing-section" id="precios">
                <div class="shell">
                    <div class="section-heading centered">
                        <p class="section-kicker">Precios y transparencia</p>
                        <h2>Precios claros, sin letras chiquitas</h2>
                        <p>
                            Elige tu paquete de inicio. Todos incluyen el primer mes de
                            uso.
                        </p>
                    </div>

                    <div class="pricing-grid">
                        <article class="price-card price-card--featured">
                            <div class="price-top">
                                <span class="package-label">Paquete A</span>
                                <span class="package-note">Llave en mano</span>
                            </div>
                            <p class="price"><sup>$</sup><%= priceADisplay %> <small>MXN + IVA</small></p>
                            <p class="price-description">
                                Instalación, primer mes y conexión con Meta.
                            </p>
                            <ul>
                                <li><span class="check"></span> Proyecto, base de datos y dominio</li>
                                <li><span class="check"></span> Conexión completa con Meta</li>
                                <li><span class="check"></span> Carga de plantillas</li>
                                <li><span class="check"></span> Sesión de arranque de 2 horas</li>
                            </ul>
                            <a class="button button-primary button-block" href="<%= packageAUrl %>">
                                Empezar con Paquete A
                            </a>
                        </article>

                        <article class="price-card">
                            <div class="price-top">
                                <span class="package-label">Paquete B</span>
                                <span class="package-note">Ya tengo Meta</span>
                            </div>
                            <p class="price"><sup>$</sup><%= priceBDisplay %> <small>MXN + IVA</small></p>
                            <p class="price-description">
                                Instalación y primer mes, si ya tienes Meta.
                            </p>
                            <ul>
                                <li><span class="check"></span> Instalación y administrador</li>
                                <li><span class="check"></span> Alta del número y webhook</li>
                                <li><span class="check"></span> Carga de plantillas</li>
                                <li><span class="check"></span> Sesión de arranque de 2 horas</li>
                            </ul>
                            <a class="button button-dark button-block" href="<%= packageBUrl %>">
                                Empezar con Paquete B
                            </a>
                        </article>
                    </div>

                    <div class="pricing-note">
                        <div class="pilot-badge">
                            <span class="pilot-mark"><%= pilotDays %></span>
                            <span>
                                <strong>Piloto de <%= pilotDays %> días</strong>
                                <small>Si no te funciona, te vas sin penalización y con tu respaldo.</small>
                            </span>
                        </div>
                        <p>
                            Mensualidad posterior: <strong><%= installMonthlyPrice %> + IVA</strong>.
                            Compromisos opcionales de 3, 6 o 12 meses con descuento.
                            Oferta válida hasta el <%= installPromoUntil %>.
                        </p>
                    </div>
                </div>
            </section>

            <section class="section not-section" id="no-es">
                <div class="shell not-grid">
                    <div>
                        <p class="section-kicker">Sin sorpresas</p>
                        <h2>Para que no te lleves sorpresas</h2>
                        <p class="not-intro">
                            Margarita organiza la operación del canal. Estos son los
                            límites que conviene conocer antes de contratar.
                        </p>
                    </div>
                    <ul class="not-list">
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No es un CRM.</strong>
                                <span>No administra ventas, embudos, cotizaciones ni facturación.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No responde solo.</strong>
                                <span>Es un copiloto para tu equipo; las decisiones y la conversación son humanas.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No envía plantillas a aprobación por ti.</strong>
                                <span>Incluye ideas de cobranza para adaptar; la plantilla final se crea y se aprueba en Meta antes de usarla.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No envía listas desplegables desde el panel.</strong>
                                <span>Sí permite enviar hasta tres botones dentro de la ventana de 24 horas; fuera de ella se requiere una plantilla aprobada.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No llama ni manda recordatorios de llamadas por sí sola.</strong>
                                <span>Las solicitudes de llamada aparecen en la lista de trabajo; el equipo hace la llamada y registra el resultado.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No incluye los cargos de Meta.</strong>
                                <span>Meta factura el uso de WhatsApp por separado. Margarita muestra una estimación, no la factura final.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No concilia ni verifica pagos.</strong>
                                <span>El equipo registra los pagos; los reportes no se conectan con bancos ni sustituyen un estado de cuenta.</span>
                            </div>
                        </li>
                        <li>
                            <span class="x-mark" aria-hidden="true"></span>
                            <div>
                                <strong>No separa permisos por número de WhatsApp.</strong>
                                <span>Si una instalación tiene varios números, sus agentes pueden acceder a conversaciones de todos ellos.</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </section>

            <section class="section faq-section" aria-labelledby="faq-title">
                <div class="shell faq-grid">
                    <div>
                        <p class="section-kicker">Preguntas rápidas</p>
                        <h2 id="faq-title">Lo que suelen preguntar antes de la demo</h2>
                    </div>
                    <div class="faq-list">
                        <details>
                            <summary>¿Mis deudores van a sentir que hablan con un robot?</summary>
                            <p>
                                No. Margarita no responde sola: ordena la conversación
                                para que una persona de tu equipo atienda. El botón de
                                llamada solo facilita que el cliente pida contacto.
                            </p>
                        </details>
                        <details>
                            <summary>¿Tengo que cambiar mi número de WhatsApp?</summary>
                            <p>
                                Se usa un número dedicado conectado a la API oficial de
                                Meta. En el Paquete A te ayudamos con la conexión; en el
                                B partimos de tu cuenta ya configurada.
                            </p>
                        </details>
                        <details>
                            <summary>¿Qué pasa si no continúo después del piloto?</summary>
                            <p>
                                No hay penalización. Te llevas tu respaldo y, si lo
                                pides por escrito, se elimina la instalación y sus
                                datos.
                            </p>
                        </details>
                        <details>
                            <summary>¿Los respaldos se guardan fuera del servidor?</summary>
                            <p>
                                Se generan respaldos diarios cifrados. Para tener una
                                copia fuera del servidor se debe configurar Cloudflare
                                R2 o descargar los respaldos a otro lugar seguro.
                            </p>
                        </details>
                    </div>
                </div>
            </section>

            <section class="final-cta" id="contacto">
                <div class="shell final-cta-inner">
                    <div>
                        <p class="section-kicker">El siguiente paso</p>
                        <h2>¿Listo para dejar de perseguir deudores?</h2>
                        <p>
                            Agenda una demo por WhatsApp. Revisamos tu cartera, tu
                            cuenta de Meta y el paquete que te conviene.
                        </p>
                    </div>
                    <div class="final-actions">
                        <a class="button button-primary" href="<%= demoUrl %>">
                            Agendar una demo por WhatsApp
                            <span aria-hidden="true">↗</span>
                        </a>
                        <a class="text-link" href="mailto:<%= supportEmail %>?subject=Quiero%20saber%20m%C3%A1s%20de%20Margarita">
                            O escríbenos a <%= supportEmail %>
                        </a>
                    </div>
                </div>
            </section>
        </main>


<%- include("../../partials/header", { title }) %>

<%
    /** Sin número configurado, el contacto cae al correo o a la guía. */
    const contactUrl =
        supportWhatsappUrl ||
        (supportEmail ? `mailto:${supportEmail}` : "/como-empezar");

    /** Los dos caminos para pedir informes, con el asunto ya escrito. */
    const asunto = encodeURIComponent("Quiero saber más de Margarita");
    const asuntoPago = encodeURIComponent("Ya pagué: quiero mis informes");
    const correoInformes = supportEmail
        ? `mailto:${supportEmail}?subject=${asunto}`
        : "";
    const correoPago = supportEmail
        ? `mailto:${supportEmail}?subject=${asuntoPago}`
        : "";

    /** Con el mensaje ya escrito, para que solo le den enviar. */
    const whatsappInformes = supportWhatsappUrl
        ? `${supportWhatsappUrl}?text=${encodeURIComponent(
              "Hola, quiero saber más de Margarita"
          )}`
        : "";

    /**
     * Si el precio de promoción es igual al de lista, la oferta no está
     * activa: se deja de anunciar la promoción sin dejar textos a medias.
     * Basta con igualar `INSTALL_PRICE_PROMO` a `INSTALL_PRICE`.
     */
    /**
     * La oferta se anuncia mientras el precio de promoción sea distinto del de
     * lista **y** no haya pasado la fecha de vigencia. Así se apaga sola el día
     * que toca, sin desplegar nada.
     */
    const promoVigente =
        !installPromoUntil ||
        new Date() <= new Date(`${installPromoUntil}T23:59:59`);
    /**
     * La oferta se apaga sola por dos caminos: la fecha y los lugares.
     * Los lugares se llevan a mano (la app no vende); al llegar a 0 la página
     * muestra el precio de lista sin que nadie toque el HTML.
     */
    const promoSpotsLeft =
        typeof installPromoSpotsLeft === "number" ? installPromoSpotsLeft : 3;
    const hasPromo =
        installPricePromo !== installPrice && promoVigente && promoSpotsLeft > 0;
    /**
     * Si la oferta se apagó (fecha o lugares), la página muestra el precio de
     * lista. Antes el número grande era siempre el de promoción, así que
     * apagarla no cambiaba nada a la vista.
     */
    const displayInstallPrice = hasPromo ? installPricePromo : installPrice;
%>

<main class="min-h-screen bg-white text-slate-950">
    <section class="relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-[560px] bg-gradient-to-b from-margarita-50 via-white to-white"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-8">
            <header class="flex items-center justify-between">
                <a href="/" class="flex items-center gap-3">
                    <img
                        src="/brand/img/margarita-wordmark-512.png"
                        alt="Margarita"
                        class="h-10 w-auto"
                    />
                </a>

                <nav class="hidden items-center gap-6 text-sm font-semibold text-slate-600 md:flex">
                    <a href="/como-empezar" class="hover:text-margarita-700">
                        Cómo empezar
                    </a>

                    <a href="/guia" class="hover:text-margarita-700">
                        Guía de uso
                    </a>

                    <a href="/plantillas" class="hover:text-margarita-700">
                        Plantillas
                    </a>

                    <a href="/propuesta" class="hover:text-margarita-700">
                        Propuesta
                    </a>

                    <a href="#precios" class="hover:text-margarita-700">
                        Precios
                    </a>

                    <a href="/aviso-de-privacidad" class="hover:text-margarita-700">
                        Aviso de privacidad
                    </a>

                    <a href="<%= contactUrl %>" class="hover:text-margarita-700">
                        Soporte
                    </a>

                    <a href="/auth/login" class="rounded-xl bg-slate-950 px-4 py-2 text-white hover:bg-slate-800">
                        Iniciar sesión
                    </a>
                </nav>

                <a href="/auth/login" class="rounded-xl bg-slate-950 px-4 py-2 text-sm font-bold text-white md:hidden">
                    Entrar
                </a>
            </header>

            <%#
                En el celular el menú de arriba se esconde y los enlaces del pie
                quedan a media página de scroll: la guía y el aviso de privacidad
                se volvían difíciles de encontrar. Aquí van a la vista.
            %>
            <nav class="mt-4 flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-600 sm:hidden">
                <a href="/como-empezar" class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">
                    Cómo empezar
                </a>

                <a href="/guia" class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">
                    Guía de uso
                </a>

                <a href="/plantillas" class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">
                    Plantillas
                </a>

                <a href="/aviso-de-privacidad" class="rounded-full bg-slate-100 px-3 py-1 hover:bg-slate-200">
                    Aviso de privacidad
                </a>
            </nav>

            <div class="grid min-h-[720px] items-center gap-14 py-16 lg:grid-cols-[1.05fr_0.95fr]">
                <section>
                    <div class="inline-flex rounded-full bg-margarita-50 px-4 py-2 text-sm font-bold text-margarita-700 ring-1 ring-margarita-100">
                        Cobranza por WhatsApp, sin hojas sueltas
                    </div>

                    <h1 class="mt-8 max-w-4xl text-5xl font-black leading-[1.05] tracking-tight text-slate-950 md:text-6xl">
                        Cobra por WhatsApp sin perder el hilo.
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
                        Margarita registra <strong>en qué quedó cada cliente</strong>
                        —prometió pagar, pagó, no contestó, número equivocado—, cuenta
                        los intentos sin respuesta, te dice <strong>a quién escribirle
                        hoy</strong> y te deja el reporte listo para Excel.
                    </p>

                    <div class="mt-8 flex max-w-xl items-start gap-4 rounded-2xl p-4 ring-1 <%= hasPromo ? 'bg-sol-50 ring-sol-200' : 'bg-margarita-50 ring-margarita-100' %>">
                        <img
                            src="/brand/img/margarita-icon-64.png"
                            alt=""
                            class="mt-0.5 h-10 w-10 shrink-0"
                        />

                        <div>
                            <p class="text-sm font-black text-margarita-900">
                                Instalación <%= displayInstallPrice %>
                                <% if (hasPromo) { %>
                                    <span class="font-semibold text-slate-500">
                                        <span class="line-through"><%= installPrice %></span>
                                    </span>
                                <% } %>
                            </p>

                            <p class="mt-1 text-xs leading-5 text-slate-600">
                                <% if (hasPromo) { %><%= installPromoLabel %>. <% } %>
                                Instalación <strong><%= installPricePromo %></strong> si
                                ya tienes Meta, o <strong><%= installPriceWithMeta %></strong>
                                con la conexión incluida. El primer mes va en la
                                instalación y es un <strong>piloto de <%= pilotDays %>
                                días</strong>: después decides. Mensualidad
                                <strong><%= installMonthlyPrice %></strong>, con
                                descuento si te comprometes. Más IVA.
                                <a href="#precios" class="font-semibold text-margarita-700 underline">
                                    Ver qué incluye
                                </a>
                            </p>
                        </div>
                    </div>

                    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
                        <a href="#contacto" class="rounded-xl bg-margarita-600 px-6 py-4 text-center text-sm font-black text-white shadow-sm hover:bg-margarita-700">
                            ¡Quiero saber más!
                        </a>

                        <a href="/como-empezar" class="rounded-xl bg-white px-6 py-4 text-center text-sm font-black text-margarita-700 ring-1 ring-margarita-200 hover:bg-margarita-50">
                            Ver cómo empezar
                        </a>
                    </div>

                    <p class="mt-5 max-w-xl text-sm leading-6 text-slate-500">
                        Se conecta a tu propia cuenta de WhatsApp Business (Meta): los
                        datos y las conversaciones son tuyos. Si no quieres pelear con
                        la configuración de Meta, <strong>la hacemos nosotros</strong>.
                    </p>
                </section>

                <section class="rounded-[2rem] bg-slate-950 p-5 shadow-2xl shadow-slate-300/60">
                    <div class="rounded-[1.5rem] bg-white p-5">
                        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b border-slate-100 pb-4">
                            <div class="flex min-w-0 items-center gap-3">
                                <img src="/brand/img/margarita-icon-128.png" alt="Margarita" class="h-10 w-10" />

                                <div>
                                    <p class="text-sm font-black text-slate-950">
                                        Hoy toca escribirle a
                                    </p>

                                    <p class="text-xs font-medium text-slate-500">
                                        Lista de trabajo del día
                                    </p>
                                </div>
                            </div>

                            <span class="shrink-0 rounded-full bg-red-50 px-3 py-1 text-xs font-bold whitespace-nowrap text-red-700">
                                3 vencidas
                            </span>
                        </div>

                        <div class="mt-4 space-y-3">
                            <div class="rounded-2xl border border-red-100 bg-red-50/60 p-4">
                                <div class="flex items-center justify-between">
                                    <p class="text-sm font-bold text-slate-800">
                                        Promesa vencida
                                    </p>

                                    <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-red-700">
                                        5 días
                                    </span>
                                </div>

                                <p class="mt-2 text-xs text-slate-600">
                                    $1,500.00 · compromiso del 10/10
                                </p>
                            </div>

                            <div class="rounded-2xl border border-sky-100 bg-sky-50/60 p-4">
                                <div class="flex items-center justify-between">
                                    <p class="text-sm font-bold text-slate-800">
                                        Vence hoy
                                    </p>

                                    <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-sky-700">
                                        $800.00
                                    </span>
                                </div>

                                <p class="mt-2 text-xs text-slate-600">
                                    Convenio a 3 pagos · primer pago hoy
                                </p>
                            </div>

                            <div class="rounded-2xl border border-amber-100 bg-amber-50/60 p-4">
                                <div class="flex items-center justify-between">
                                    <p class="text-sm font-bold text-slate-800">
                                        Sin contestar
                                    </p>

                                    <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-amber-700">
                                        4 intentos
                                    </span>
                                </div>

                                <p class="mt-2 text-xs text-slate-600">
                                    Nunca ha respondido · marcar y pasar al siguiente
                                </p>
                            </div>
                        </div>

                        <p class="mt-4 text-[11px] leading-5 text-slate-500">
                            Los intentos se cuentan solos con los mensajes enviados: no hay
                            nada que capturar a mano.
                        </p>
                    </div>
                </section>
            </div>
        </div>
    </section>

    <section class="border-y border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-7xl px-6 py-16">
            <h2 class="text-3xl font-black text-slate-950">
                Lo que la herramienta hace hoy
            </h2>

            <p class="mt-3 max-w-3xl text-slate-600">
                Es una herramienta de operación, no un CRM: se enfoca en que el
                equipo de cobranza trabaje ordenado y que al final del día haya
                números que mostrar.
            </p>

            <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                <% [
                    ["Resultado de cada gestión", "Promesa de pago, pagado, convenio, promesa incumplida, sin contestación, número inválido, no le interesa o volver a llamar, con monto, fecha compromiso y nota. Cada marcado deja historial con quién y cuándo."],
                    ["Promesas vencidas automáticas", "Una promesa con fecha pasada aparece como vencida con los días de atraso, sin que nadie tenga que marcarla. Si el cliente paga después, marcar pagado la resuelve sola."],
                    ["Intentos sin contestación", "Se cuentan con los mensajes enviados desde la última respuesta del cliente. Nada que capturar: el sistema te dice quién lleva 3, 4 o 10 intentos sin responder."],
                    ["Lista de trabajo del día", "Una pantalla que junta lo que ya venció, lo que vence hoy, lo de esta semana y los que no contestan, en ese orden de urgencia."],
                    ["Reportes y CSV", "Gestiones por persona y por día, promesas, cumplimiento (a tiempo, tarde, sin pago), prometido contra cobrado, y semana a semana. Todo descargable para Excel."],
                    ["Campañas con plantillas", "Sube un Excel y manda plantillas aprobadas con variables, por lotes y con pausa, sin chocar con los límites de Meta. Pausa, reanuda y reintenta."],
                    ["Varios números, un equipo", "Varios números de la misma cuenta de WhatsApp Business con su propia bandeja. Asignación de conversaciones a cada persona y contador de no leídos."],
                    ["Bajas y consentimiento", "Si el cliente escribe STOP, queda dado de baja al instante y deja de recibir mensajes y campañas. Reactivarlo es una decisión explícita y queda auditada."],
                    ["Datos protegidos", "Teléfonos, mensajes, notas y montos se guardan cifrados en la base. Sesiones con cierre por inactividad, tope de dispositivos y lista de accesos visible."]
                ].forEach(([title, detail]) => { %>
                    <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                        <p class="text-lg font-black text-slate-950"><%= title %></p>
                        <p class="mt-2 text-sm leading-6 text-slate-600"><%= detail %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <section class="bg-white">
        <div class="mx-auto max-w-7xl px-6 py-16">
            <h2 class="text-3xl font-black text-slate-950">
                Cómo se pone a andar
            </h2>

            <div class="mt-8 grid gap-6 md:grid-cols-3">
                <div class="rounded-2xl border border-slate-200 p-6">
                    <p class="text-sm font-black text-margarita-700">Paso 1</p>
                    <p class="mt-2 text-lg font-black text-slate-950">Conectas WhatsApp</p>
                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        Tu cuenta de WhatsApp Business en Meta (la puedes tener ya, o la
                        creamos). Se configura un número dedicado, el token permanente y el
                        webhook firmado.
                    </p>
                </div>

                <div class="rounded-2xl border border-slate-200 p-6">
                    <p class="text-sm font-black text-margarita-700">Paso 2</p>
                    <p class="mt-2 text-lg font-black text-slate-950">Subes tu cartera</p>
                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        Contactos con etiquetas, o directamente un Excel. Cada persona
                        entra con su usuario y solo ve lo que le toca.
                    </p>
                </div>

                <div class="rounded-2xl border border-slate-200 p-6">
                    <p class="text-sm font-black text-margarita-700">Paso 3</p>
                    <p class="mt-2 text-lg font-black text-slate-950">Trabajas y mides</p>
                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        El equipo marca el resultado de cada conversación y cada mañana
                        empieza con la lista de a quién escribirle. Al final, el reporte sale
                        en CSV.
                    </p>
                </div>
            </div>

            <a href="/como-empezar" class="mt-8 inline-flex text-sm font-black text-margarita-700 hover:text-margarita-800">
                Ver la guía paso a paso de Meta →
            </a>
        </div>
    </section>

    <section class="bg-white">
        <div class="mx-auto max-w-7xl px-6 py-16">
            <div id="precios" class="scroll-mt-8">
                <p class="text-sm font-black uppercase tracking-wide text-margarita-700">
                    Precios
                </p>

                <h2 class="mt-2 text-3xl font-black text-slate-950">
                    Dos formas de empezar. Un mes para probarlo.
                </h2>

                <p class="mt-3 max-w-3xl text-slate-600">
                    El primer mes es un <strong>piloto pagado</strong>: al día
                    <%= pilotDays %> decides si sigues, sin penalización. Si no
                    continúas, te llevas tu respaldo. Después, mes a mes, con
                    descuento si te comprometes. <strong>Precios más IVA</strong> y el
                    consumo de WhatsApp se paga directo a Meta.
                </p>
            </div>

            <div class="mt-8 grid gap-6 lg:grid-cols-2">
                <div class="rounded-2xl bg-white p-6 shadow-sm ring-2 ring-margarita-600">
                    <p class="text-xs font-black uppercase tracking-wide text-margarita-700">
                        Paquete A · Llave en mano
                    </p>

                    <p class="mt-3 text-4xl font-black text-slate-950">
                        <%= installPriceWithMeta %>
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-500">
                        una vez · más IVA · incluye el primer mes
                    </p>

                    <ul class="mt-5 space-y-2 text-sm text-slate-700">
                        <li>Proyecto, base de datos, dominio y usuario administrador.</li>
                        <li><strong>Conexión completa con Meta</strong>: app, cuenta, número, token y webhook.</li>
                        <li>Carga de plantillas y sesión de arranque de 2 horas.</li>
                        <li><strong>Piloto de <%= pilotDays %> días</strong>: si no sigues, te llevas tu respaldo.</li>
                    </ul>
                </div>

                <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-xs font-black uppercase tracking-wide text-slate-500">
                        Paquete B · Ya tengo Meta
                    </p>

                    <p class="mt-3 text-4xl font-black text-slate-950">
                        <%= installPricePromo %>
                    </p>

                    <p class="mt-1 text-sm font-semibold text-slate-500">
                        una vez · más IVA · incluye el primer mes
                    </p>

                    <ul class="mt-5 space-y-2 text-sm text-slate-700">
                        <li>Instalación, dominio, base de datos y administrador.</li>
                        <li>Alta del número y webhook con tus credenciales de Meta.</li>
                        <li>Carga de plantillas y sesión de arranque de 2 horas.</li>
                        <li><strong>Piloto de <%= pilotDays %> días</strong> con las mismas condiciones.</li>
                    </ul>
                </div>
            </div>

            <div class="mt-6 rounded-2xl bg-slate-950 p-6 text-white">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="text-xs font-black uppercase tracking-wide text-sol-300">
                            Mensualidad
                        </p>

                        <p class="mt-2 text-3xl font-black">
                            <%= installMonthlyPrice %>
                            <span class="text-sm font-semibold text-slate-300">al mes · más IVA</span>
                        </p>

                        <p class="mt-1 text-sm text-slate-300">
                            Usuarios ilimitados, actualizaciones, soporte y respaldos.
                        </p>
                    </div>

                    <div class="text-sm text-slate-300">
                        <p>Precio de lista: <%= installMonthlyListPrice %> al mes</p>
                        <p class="text-xs">Promoción vigente hasta el <%= installPromoUntil %>.</p>
                    </div>
                </div>

                <div class="mt-5 grid gap-3 sm:grid-cols-3">
                    <div class="rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10">
                        <p class="text-xs text-slate-400">Compromiso 3 meses</p>
                        <p class="mt-1 text-xl font-black"><%= monthlyCommit3 %> <span class="text-xs font-semibold text-slate-300">/mes</span></p>
                    </div>

                    <div class="rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10">
                        <p class="text-xs text-slate-400">Compromiso 6 meses</p>
                        <p class="mt-1 text-xl font-black"><%= monthlyCommit6 %> <span class="text-xs font-semibold text-slate-300">/mes</span></p>
                    </div>

                    <div class="rounded-xl bg-white/5 px-4 py-3 ring-1 ring-white/10">
                        <p class="text-xs text-slate-400">Compromiso 12 meses</p>
                        <p class="mt-1 text-xl font-black"><%= monthlyCommit12 %> <span class="text-xs font-semibold text-slate-300">/mes</span></p>
                    </div>
                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Los compromisos son opcionales: sirven para bajar la mensualidad.
                    Sin compromiso, se paga mes a mes.
                </p>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-3">
                <a href="#contacto" class="rounded-xl bg-margarita-600 px-6 py-4 text-sm font-black text-white hover:bg-margarita-700">
                    ¡Quiero saber más!
                </a>

                <a href="/como-empezar" class="text-sm font-black text-margarita-700 hover:text-margarita-800">
                    Ver la guía paso a paso →
                </a>
            </div>
        </div>
    </section>

    <section class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-6 py-16">
            <p class="text-sm font-black uppercase tracking-wide text-margarita-700">
                Ahorro en Meta
            </p>

            <h2 class="mt-2 text-3xl font-black text-slate-950">
                Dejamos todo configurado para que Meta te cobre menos
            </h2>

            <p class="mt-3 max-w-3xl text-slate-600">
                El consumo de WhatsApp lo cobra Meta directo a tu cuenta, no nosotros.
                Por eso la instalación incluye <strong>dejar la configuración preparada
                para que ese consumo sea el más bajo posible</strong>, y enseñarte a
                mantenerlo así. Es la diferencia entre pagar por cinco mensajes y
                pagar por uno.
            </p>

            <div class="mt-8 grid gap-4 md:grid-cols-2">
                <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
                    <p class="text-lg font-black text-slate-950">
                        Plantillas de utilidad, no de publicidad
                    </p>

                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        Meta clasifica cada plantilla: las de <strong>utilidad</strong>
                        —recordatorios de pago, avisos de cuenta— cuestan una fracción de
                        las de <strong>marketing</strong>, y reclasifica sola cuando el
                        texto suena a promoción. Te ayudamos a redactarlas con lenguaje
                        transaccional, y el panel <strong>te avisa</strong> si Meta las
                        mueve de categoría antes de que mandes una campaña.
                    </p>
                </div>

                <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
                    <p class="text-lg font-black text-slate-950">
                        Un botón en lugar de cinco mensajes
                    </p>

                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        La plantilla puede llevar botones —«ya pagué», «quiero que me
                        llame un asesor»—: el cliente resuelve en un toque y su
                        respuesta queda registrada en el hilo. Cada mensaje de ida y
                        vuelta que te ahorras es un mensaje que ya no pagas.
                    </p>
                </div>

                <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
                    <p class="text-lg font-black text-slate-950">
                        Bajas y calidad cuidadas
                    </p>

                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        Si el cliente escribe <span class="font-mono">STOP</span> queda
                        dado de baja al instante y sale de las campañas siguientes; la
                        calidad se vigila <strong>por número</strong>, así que uno con
                        problemas no arrastra a los demás. Escribirle a quien pidió no
                        recibir mensajes es lo que más caro sale.
                    </p>
                </div>

                <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
                    <p class="text-lg font-black text-slate-950">
                        La guía de plantillas, para tu equipo
                    </p>

                    <p class="mt-2 text-sm leading-6 text-slate-600">
                        Al contratar te entregamos el documento de cómo crearlas: qué
                        texto sí y qué texto no, cómo se clasifican, qué variables admite
                        cada parte y cómo revisar que Meta no las haya movido de lugar.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-6 py-16">
            <h2 class="text-2xl font-black text-slate-950">
                Lo que necesitas de tu lado
            </h2>

            <p class="mt-2 max-w-3xl text-sm text-slate-600">
                Para que funcione no basta la herramienta: hay cosas que solo puede
                resolver la empresa. Preferimos decirlo antes.
            </p>

            <ul class="mt-6 grid gap-3 text-sm text-slate-700 md:grid-cols-2">
                <li class="rounded-xl bg-slate-50 px-4 py-3">
                    Una cuenta de <strong>Meta Business</strong> (con verificación de negocio
                    si vas a enviar a volumen).
                </li>
                <li class="rounded-xl bg-slate-50 px-4 py-3">
                    Un <strong>número dedicado</strong> que no esté en uso en la app normal
                    de WhatsApp (ordinario o Business).
                </li>
                <li class="rounded-xl bg-slate-50 px-4 py-3">
                    Un <strong>método de pago</strong> válido en Meta: sin él la cuenta no
                    envía, aunque la herramienta diga que todo está listo.
                </li>
                <li class="rounded-xl bg-slate-50 px-4 py-3">
                    <strong>Plantillas aprobadas</strong> para iniciar conversaciones y
                    respetar las <strong>bajas</strong> de quien pida no recibir mensajes.
                </li>
            </ul>

        </div>
    </section>

    <section id="contacto" class="scroll-mt-8 border-t border-slate-200 bg-margarita-50">
        <div class="mx-auto max-w-5xl px-6 py-16">
            <div class="text-center">
                <p class="text-sm font-black uppercase tracking-wide text-margarita-700">
                    Contacto
                </p>

                <h2 class="mt-2 text-3xl font-black text-slate-950">
                    ¡Quiero saber más!
                </h2>

                <p class="mt-3 text-slate-600">
                    Escríbenos y te contestamos en horario hábil. Te mostramos la
                    herramienta con un caso de cobranza real antes de que decidas nada.
                </p>
            </div>

            <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                <% if (whatsappInformes) { %>
                    <a href="<%= whatsappInformes %>" class="rounded-xl bg-margarita-600 px-6 py-4 text-center text-sm font-black text-white shadow-sm hover:bg-margarita-700">
                        Escribir por WhatsApp
                    </a>
                <% } %>

                <% if (correoInformes) { %>
                    <a href="<%= correoInformes %>" class="rounded-xl bg-white px-6 py-4 text-center text-sm font-black text-margarita-700 ring-1 ring-margarita-200 hover:bg-margarita-100">
                        Mandar correo
                    </a>
                <% } %>
            </div>

            <% if (supportEmail) { %>
                <p class="mt-4 text-center text-sm text-slate-600">
                    <%= supportEmail %>
                    <% if (supportWhatsappDisplay || supportWhatsappNumber) { %>
                        · WhatsApp <%= supportWhatsappDisplay || supportWhatsappNumber %>
                    <% } %>
                </p>
            <% } %>

            <div class="mx-auto mt-10 max-w-2xl rounded-2xl bg-white p-6 text-center ring-1 ring-margarita-200">
                <p class="text-lg font-black text-slate-950">
                    ¿Ya apartaste tu lugar?
                </p>

                <p class="mt-2 text-sm leading-6 text-slate-600">
                    Si ya pagaste la instalación y necesitas tus informes (alta,
                    día de la conexión con Meta, capacitación o la factura),
                    escríbenos por el mismo medio con el asunto ya puesto:
                </p>

                <% if (correoPago) { %>
                    <a href="<%= correoPago %>" class="mt-4 inline-flex rounded-xl bg-slate-950 px-5 py-3 text-sm font-black text-white hover:bg-slate-800">
                        Pedir mis informes
                    </a>
                <% } %>
            </div>
        </div>
    </section>
</main>

<% if (contactUrl) { %>
    <%#
        Botón flotante: en el celular estorba (tapa los botones de abajo), así
        que solo aparece en pantallas grandes, donde el contenido no llega al
        borde.
    %>
    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 hidden justify-end p-4 sm:flex">
        <a
            href="<%= whatsappInformes || correoInformes || contactUrl %>"
            class="pointer-events-auto flex items-center gap-2 rounded-full bg-margarita-600 py-3 pl-3 pr-5 text-sm font-black text-white shadow-lg shadow-margarita-900/20 hover:bg-margarita-700"
        >
            <img src="/brand/img/margarita-icon-64.png" alt="" class="h-7 w-7" />
            ¡Quiero saber más!
        </a>
    </div>
<% } %>

<%- include("../../partials/footer") %>

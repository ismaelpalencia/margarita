<%- include("../../partials/header", { title: "Dashboard Admin" }) %>

<div class="min-h-screen bg-slate-100">
    <%- include("../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-4 py-8">
        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-wide text-margarita-600">
                Panel operativo
            </p>

            <h1 class="mt-1 text-3xl font-bold text-slate-900">
                Dashboard
            </h1>

            <p class="mt-2 text-slate-600">
                Vista rápida del estado actual de conversaciones, agentes y eventos recientes.
            </p>

            <% if (typeof activeNumber !== "undefined" && activeNumber) { %>
                <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-margarita-50 px-3 py-1 text-xs font-semibold text-margarita-800 ring-1 ring-margarita-200">
                    Mostrando el número
                    <strong><%= activeNumber.displayName || activeNumber.phoneNumber %></strong>
                    · cambia de número en el encabezado para ver el otro dashboard
                </p>
            <% } %>
        </div>

        <% if (typeof unassignedCount !== "undefined" && unassignedCount > 0) { %>
            <div class="mb-6 flex items-center justify-between gap-4 rounded-2xl bg-red-50 px-5 py-4 ring-1 ring-red-200">
                <p class="text-sm font-semibold text-red-800">
                    <%= unassignedCount %> conversación(es) sin asignar — ningún agente en línea.
                </p>
                <a href="/admin/conversations?assigned=unassigned" class="shrink-0 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                    Ver y asignar
                </a>
            </div>
        <% } %>

        <section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <div class="card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium" style="color: var(--text-secondary)">Conversaciones abiertas</p>
                    <span class="badge badge--info">Abiertas</span>
                </div>
                <p class="mt-3 text-3xl font-bold" style="color: var(--text-primary)">
                    <%= dashboard.stats.openConversations %>
                </p>
            </div>

            <div class="card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium" style="color: var(--text-secondary)">Sin asignar</p>
                    <span class="badge badge--danger">Atención</span>
                </div>
                <p class="mt-3 text-3xl font-bold" style="color: var(--danger)">
                    <%= dashboard.stats.unassignedConversations %>
                </p>
            </div>

            <div class="card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium" style="color: var(--text-secondary)">Asignadas</p>
                    <span class="badge badge--neutral">En curso</span>
                </div>
                <p class="mt-3 text-3xl font-bold" style="color: var(--text-primary)">
                    <%= dashboard.stats.assignedConversations %>
                </p>
            </div>

            <div class="card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium" style="color: var(--text-secondary)">En progreso</p>
                    <span class="badge badge--success">Activas</span>
                </div>
                <p class="mt-3 text-3xl font-bold" style="color: var(--success)">
                    <%= dashboard.stats.inProgressConversations %>
                </p>
            </div>
        </section>

        <% if (typeof error !== "undefined" && error === "cobranza_desactivada") { %>
            <div class="mb-6 rounded-xl bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
                El módulo de cobranza está apagado para esta instalación.
                Puedes encenderlo en <a href="/admin/system" class="underline">Sistema → Giro de la operación</a>.
            </div>
        <% } %>

        <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
        <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-margarita-200">
                <p class="text-sm font-medium text-margarita-700">
                    Gestiones de hoy
                </p>

                <p class="mt-3 text-4xl font-bold text-margarita-700">
                    <%= dashboard.outcomes.markedToday %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-red-200">
                <p class="text-sm font-medium text-red-700">
                    Promesas vencidas
                </p>

                <p class="mt-3 text-4xl font-bold text-red-700">
                    <%= dashboard.outcomes.overduePromises %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    Sin pago registrado
                </p>
            </div>

            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-sky-200">
                <p class="text-sm font-medium text-sky-700">
                    Compromisos esta semana
                </p>

                <p class="mt-3 text-4xl font-bold text-sky-700">
                    <%= dashboard.outcomes.promisesSoon %>
                </p>
            </div>

            <a
                href="/admin/reports"
                class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:bg-slate-50"
            >
                <p class="text-sm font-medium text-slate-500">
                    Cobrado este mes
                </p>

                <p class="mt-3 text-2xl font-bold text-slate-900">
                    <%= dashboard.outcomes.paidAmountLabel %>
                </p>

                <p class="mt-1 text-xs text-slate-500">
                    <%= dashboard.outcomes.paidThisMonth %> pago(s) · ver reportes
                </p>
            </a>
        </section>
        <% } %>

        <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">
                    Agentes disponibles
                </p>

                <p class="mt-2 text-3xl font-bold text-margarita-600">
                    <%= dashboard.agents.available %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">
                    Ocupados
                </p>

                <p class="mt-2 text-3xl font-bold text-yellow-600">
                    <%= dashboard.agents.busy %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">
                    En break
                </p>

                <p class="mt-2 text-3xl font-bold text-blue-600">
                    <%= dashboard.agents.break %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">
                    Offline
                </p>

                <p class="mt-2 text-3xl font-bold text-slate-500">
                    <%= dashboard.agents.offline %>
                </p>
            </div>
        </section>

        <section class="mt-8 grid gap-6 xl:grid-cols-2">
            <div class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
                <div class="border-b border-slate-200 px-6 py-4">
                    <h2 class="font-bold text-slate-900">
                        Conversaciones recientes
                    </h2>
                </div>

                <div class="divide-y divide-slate-100">
                    <% if (dashboard.recentConversations.length === 0) { %>
                        <div class="px-6 py-8 text-sm text-slate-500">
                            No hay conversaciones abiertas todavía.
                        </div>
                    <% } %>

                    <% dashboard.recentConversations.forEach((conversation) => { %>
                        <a href="/admin/conversations/<%= conversation.id %>" class="block px-6 py-4 hover:bg-slate-50">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="font-semibold text-slate-900">
                                        <%= conversation.contact.name || conversation.contact.profileName || conversation.contact.phone %>
                                    </p>

                                    <p class="mt-1 line-clamp-1 text-sm text-slate-500">
                                        <% if (conversation.messages.length > 0) { %>
                                            <%= conversation.messages[0].body || "[" + conversation.messages[0].type + "]" %>
                                        <% } else { %>
                                            Sin mensajes todavía
                                        <% } %>
                                    </p>
                                </div>

                                <div class="text-right">
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                                        <%= conversation.operationalStatus %>
                                    </span>

                                    <p class="mt-2 text-xs text-slate-400">
                                        <%= conversation.assignedUser ? conversation.assignedUser.name : "Sin agente" %>
                                    </p>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </div>

            <div class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
                <div class="border-b border-slate-200 px-6 py-4">
                    <h2 class="font-bold text-slate-900">
                        Mensajes entrantes recientes
                    </h2>
                </div>

                <div class="divide-y divide-slate-100">
                    <% if (dashboard.recentIncomingMessages.length === 0) { %>
                        <div class="px-6 py-8 text-sm text-slate-500">
                            No hay mensajes entrantes todavía.
                        </div>
                    <% } %>

                    <% dashboard.recentIncomingMessages.forEach((message) => { %>
                        <div class="flex items-start gap-3 px-6 py-4 hover:bg-slate-50">
                            <a href="/admin/conversations/<%= message.conversation.id %>" class="min-w-0 flex-1">
                                <p class="font-semibold text-slate-900">
                                    <%= message.conversation.contact.name || message.conversation.contact.profileName || message.conversation.contact.phone %>
                                </p>

                                <p class="mt-1 line-clamp-2 text-sm text-slate-600">
                                    <%= message.body || "[" + message.type + "]" %>
                                </p>

                                <p class="mt-2 text-xs text-slate-400">
                                    Agente:
                                    <%= message.conversation.assignedUser ? message.conversation.assignedUser.name : "Sin asignar" %>
                                </p>
                            </a>

                            <%#
                                Ocultar desde aquí: es el mismo ocultado del hilo
                                (reversible, con bitácora), pero sin tener que
                                entrar a la conversación.
                            %>
                            <form
                                action="/admin/conversations/<%= message.conversation.id %>/messages/<%= message.id %>/delete"
                                method="POST"
                                class="shrink-0"
                                onsubmit="return confirm('¿Ocultar este mensaje del dashboard? El administrador puede restaurarlo desde el hilo.');"
                            >
                                <input type="hidden" name="redirectTo" value="/admin/dashboard" />

                                <button class="rounded-lg px-2 py-1 text-[11px] font-semibold text-slate-400 hover:bg-slate-100 hover:text-slate-700">
                                    Ocultar
                                </button>
                            </form>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>

        <section class="mt-8 rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="font-bold text-slate-900">
                    Últimos errores o advertencias
                </h2>
            </div>

            <div class="divide-y divide-slate-100">
                <% if (dashboard.recentErrors.length === 0) { %>
                    <div class="px-6 py-8 text-sm text-slate-500">
                        No hay errores recientes.
                    </div>
                <% } %>

                <% dashboard.recentErrors.forEach((log) => { %>
                    <div class="px-6 py-4">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700">
                                <%= log.level %>
                            </span>

                            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                                <%= log.module %>
                            </span>

                            <span class="text-xs text-slate-400">
                                <%= log.createdAt.toLocaleString("es-MX") %>
                            </span>
                        </div>

                        <p class="mt-2 font-semibold text-slate-800">
                            <%= log.action %>
                        </p>

                        <p class="mt-1 text-sm text-slate-600">
                            <%= log.message %>
                        </p>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>
</div>

<%- include("../../partials/footer") %>

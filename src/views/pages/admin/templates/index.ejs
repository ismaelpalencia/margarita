<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Plantillas | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />
    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-50 text-slate-900">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <% if (success === "sync") { %>
            <div class="mb-5 rounded-xl border border-margarita-200 bg-margarita-50 px-4 py-3 text-sm font-semibold text-margarita-800" role="status">
                Plantillas de Meta sincronizadas correctamente.
            </div>
        <% } %>
        <% if (error === "sync") { %>
            <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                No se pudieron sincronizar las plantillas. Revisa la configuración de WhatsApp y los logs.
            </div>
        <% } %>

        <section class="mb-8 overflow-hidden rounded-3xl bg-gradient-to-br from-margarita-800 via-margarita-700 to-margarita-600 px-6 py-8 text-white shadow-sm sm:px-9 sm:py-10">
            <div class="max-w-3xl">
                <p class="text-xs font-black uppercase tracking-[0.18em] text-white/75"><%= (typeof collectionsEnabled !== "undefined" && collectionsEnabled) ? "Biblioteca para equipos de cobranza" : "Biblioteca de ideas para WhatsApp" %></p>
                <h1 class="mt-3 text-3xl font-black tracking-tight sm:text-4xl">¿No sabes qué plantilla crear?</h1>
                <p class="mt-4 max-w-2xl text-sm leading-6 text-white/90 sm:text-base">
                    <%= (typeof collectionsEnabled !== "undefined" && collectionsEnabled) ? "Usa estas ideas como punto de partida para primer contacto, recordatorios y promesas de pago." : "Usa estas ideas como punto de partida para primer contacto, seguimiento y avisos." %>
                    Adáptalas a tu operación y crea la versión final en Meta.
                </p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="#biblioteca" class="rounded-xl bg-white px-5 py-3 text-sm font-black text-margarita-800 hover:bg-margarita-50">Explorar ideas</a>
                    <a href="#mis-plantillas" class="rounded-xl border border-white/40 px-5 py-3 text-sm font-bold text-white hover:bg-white/10">Ver mis plantillas de Meta</a>
                </div>
            </div>
        </section>

        <section class="mb-10 rounded-2xl border border-amber-300 bg-amber-50 p-5 sm:p-6">
            <div class="flex gap-3">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-200 font-black text-amber-900" aria-hidden="true">!</span>
                <div>
                    <h2 class="font-black text-amber-950">Son ideas de Margarita; ninguna está aprobada por Meta.</h2>
                    <p class="mt-1 text-sm leading-6 text-amber-900">
                        Copia la ficha, revísala y crea la plantilla en tu cuenta de Meta. Meta decide su aprobación y categoría final. Después, usa “Sincronizar desde Meta” para traerla al panel. No la envíes a clientes hasta que aparezca aprobada.
                    </p>
                </div>
            </div>
        </section>

        <section id="biblioteca" class="scroll-mt-6">
            <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-black uppercase tracking-widest text-margarita-700">Ideas listas para adaptar</p>
                    <h2 class="mt-1 text-2xl font-black tracking-tight"><%= (typeof collectionsEnabled !== "undefined" && collectionsEnabled) ? "Biblioteca de cobranza" : "Biblioteca de ideas" %></h2>
                    <p class="mt-1 max-w-2xl text-sm text-slate-600">Cada ficha incluye el momento de uso, variables compatibles con Margarita y botones de respuesta sugeridos.</p>
                </div>
                <label class="block sm:w-72">
                    <span class="sr-only">Buscar ideas de plantilla</span>
                    <input id="template-library-search" type="search" placeholder="<%= (typeof collectionsEnabled !== "undefined" && collectionsEnabled) ? "Buscar: promesa, pago…" : "Buscar por nombre o situación…" %>" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100" />
                </label>
            </div>

            <div id="template-library-grid" class="grid gap-5 lg:grid-cols-2">
                <% templateIdeas.forEach((idea) => { %>
                    <article class="template-library-card flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" data-search="<%= `${idea.name} ${idea.scenario} ${idea.whenToUse} ${idea.body} ${idea.buttons.join(" ")}`.toLocaleLowerCase("es-MX") %>">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <span class="inline-flex rounded-full bg-margarita-50 px-3 py-1 text-xs font-bold text-margarita-800"><%= idea.scenario %></span>
                                <h3 class="mt-3 text-xl font-black tracking-tight"><%= idea.name %></h3>
                            </div>
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-[11px] font-bold text-slate-700">
                                <img src="/brand/img/margarita-icon-64.png" alt="" class="h-4 w-4" />
                                Plantilla hecha por Margarita
                            </span>
                        </div>

                        <p class="mt-3 text-sm leading-6 text-slate-600"><%= idea.whenToUse %></p>

                        <div class="mt-4 rounded-xl bg-[#eaf7ef] p-4">
                            <p class="mb-2 text-[11px] font-black uppercase tracking-wider text-emerald-800">Vista previa del mensaje</p>
                            <p class="whitespace-pre-line text-sm leading-6 text-slate-800"><%= idea.body %></p>
                        </div>

                        <div class="mt-4 grid gap-4 sm:grid-cols-2">
                            <div>
                                <h4 class="text-xs font-black uppercase tracking-wide text-slate-500">Variables para personalizar</h4>
                                <ul class="mt-2 space-y-2">
                                    <% idea.variables.forEach((variable) => { %>
                                        <li class="text-xs leading-5 text-slate-600">
                                            <code class="rounded bg-slate-100 px-1.5 py-0.5 font-bold text-slate-800"><%= variable.token %></code>
                                            <%= variable.meaning %>
                                            <span class="block pl-1 text-slate-400">Ejemplo: <%= variable.example %></span>
                                        </li>
                                    <% }) %>
                                </ul>
                            </div>
                            <div>
                                <h4 class="text-xs font-black uppercase tracking-wide text-slate-500">Botones sugeridos</h4>
                                <div class="mt-2 flex flex-wrap gap-2">
                                    <% idea.buttons.forEach((button) => { %>
                                        <span class="rounded-full border border-margarita-200 bg-margarita-50 px-2.5 py-1 text-xs font-semibold text-margarita-800"><%= button %></span>
                                    <% }) %>
                                </div>
                                <p class="mt-2 text-xs leading-5 text-slate-500">Configura las respuestas en Admin → Botones para que Margarita registre lo que el cliente elija.</p>
                            </div>
                        </div>

                        <% if (idea.caution) { %>
                            <p class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900"><strong>Ten en cuenta:</strong> <%= idea.caution %></p>
                        <% } %>

                        <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-slate-100 pt-4">
                            <span class="text-xs font-semibold text-slate-500">Categoría sugerida: Utilidad*</span>
                            <button type="button" data-copy-target="template-idea-<%= idea.id %>" class="ml-auto rounded-xl bg-margarita-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-margarita-800">Copiar ficha para Meta</button>
                        </div>
                        <pre id="template-idea-<%= idea.id %>" class="sr-only"><%= formatTemplateLibraryIdea(idea) %></pre>
                    </article>
                <% }) %>
                <p id="template-library-empty" class="hidden rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 lg:col-span-2">No encontramos ideas con esa búsqueda.</p>
            </div>

            <p class="mt-4 text-xs leading-5 text-slate-500">*La categoría es una sugerencia. Meta puede reclasificar la plantilla. Revisa la normativa aplicable, el consentimiento de contacto y la información que tu organización está autorizada a compartir.</p>
        </section>

        <section class="my-10 rounded-2xl border border-margarita-200 bg-white p-5 shadow-sm sm:flex sm:items-center sm:justify-between sm:gap-6 sm:p-6">
            <div class="flex items-start gap-3">
                <img src="/brand/img/margarita-icon-64.png" alt="Margarita" class="h-10 w-10 shrink-0" />
                <div>
                    <h2 class="font-black">¿Tienes una plantilla que compartir?</h2>
                    <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
                        Cuéntanos cuál te ha funcionado. La revisaremos y, si la aprobamos para la biblioteca, la publicaremos como una idea de la comunidad. No envíes nombres, teléfonos, saldos ni datos de clientes.
                    </p>
                </div>
            </div>
            <a href="<%= shareTemplateUrl %>" target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex shrink-0 items-center justify-center rounded-xl bg-[#128c4a] px-5 py-3 text-sm font-black text-white hover:bg-[#0e743d] sm:mt-0">
                Compartir por WhatsApp
                <span class="ml-2 text-white/80">55 3878 3682</span>
            </a>
        </section>

        <section id="mis-plantillas" class="scroll-mt-6">
            <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-black uppercase tracking-widest text-slate-500">Tu cuenta de WhatsApp</p>
                    <h2 class="mt-1 text-2xl font-black tracking-tight">Mis plantillas de Meta</h2>
                    <p class="mt-1 text-sm text-slate-600">Solo las plantillas sincronizadas desde Meta aparecen aquí y pueden usarse según su estado.</p>
                </div>
                <form action="/admin/templates/sync" method="POST">
                    <button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-700">Sincronizar desde Meta</button>
                </form>
            </div>

            <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
                <table class="w-full min-w-[760px] text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                        <tr>
                            <th class="px-5 py-4">Nombre</th>
                            <th class="px-5 py-4">Idioma</th>
                            <th class="px-5 py-4">Categoría</th>
                            <th class="px-5 py-4">Estado en Meta</th>
                            <th class="px-5 py-4">Última sincronización</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (templates.length === 0) { %>
                            <tr>
                                <td colspan="5" class="px-5 py-10 text-center">
                                    <p class="font-bold text-slate-700">Todavía no hay plantillas sincronizadas.</p>
                                    <p class="mt-1 text-sm text-slate-500">Elige una idea de arriba, créala en Meta y vuelve a sincronizar cuando esté lista.</p>
                                </td>
                            </tr>
                        <% } %>
                        <% templates.forEach((template) => { %>
                            <tr>
                                <td class="px-5 py-4">
                                    <div class="font-bold text-slate-800"><%= template.name %></div>
                                    <% if (template.metaTemplateId) { %><div class="mt-1 text-xs text-slate-400">ID: <%= template.metaTemplateId %></div><% } %>
                                </td>
                                <td class="px-5 py-4 text-slate-600"><%= template.language %></td>
                                <td class="px-5 py-4">
                                    <%
                                        const shape = templateVariableShape(template.components);
                                        const tieneBotones = shape.url > 0 || shape.header > 0;
                                        const esMarketing = (template.category || "").toUpperCase() === "MARKETING";
                                    %>
                                    <span class="text-slate-700"><%= template.category || "—" %></span>
                                    <% if (tieneBotones) { %><span class="ml-2 rounded-full bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600">con variables/botón URL</span><% } %>
                                    <% if (esMarketing) { %><span class="ml-2 rounded-full bg-amber-100 px-2 py-1 text-[10px] font-bold text-amber-800">marketing</span><% } %>
                                </td>
                                <td class="px-5 py-4">
                                    <% if (template.status === "APPROVED") { %>
                                        <span class="rounded-full bg-margarita-100 px-3 py-1 text-xs font-bold text-margarita-800">Aprobada</span>
                                    <% } else if (template.status === "REJECTED") { %>
                                        <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-bold text-red-700">Rechazada</span>
                                    <% } else if (template.status === "PENDING") { %>
                                        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">Pendiente</span>
                                    <% } else if (template.status === "PAUSED" || template.status === "DISABLED") { %>
                                        <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-bold text-red-700"><%= template.status === "PAUSED" ? "Pausada" : "Deshabilitada" %></span>
                                    <% } else { %>
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700"><%= template.status %></span>
                                    <% } %>
                                </td>
                                <td class="px-5 py-4 text-slate-600"><%= template.lastSyncedAt ? formatDateTimeMX(template.lastSyncedAt) : "—" %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script src="/js/copy.js"></script>
    <script>
        (function () {
            var input = document.getElementById("template-library-search");
            var cards = Array.prototype.slice.call(document.querySelectorAll(".template-library-card"));
            var empty = document.getElementById("template-library-empty");

            if (!input) return;

            input.addEventListener("input", function () {
                var query = input.value.trim().toLocaleLowerCase("es-MX");
                var visible = 0;

                cards.forEach(function (card) {
                    var matches = (card.getAttribute("data-search") || "").indexOf(query) !== -1;
                    card.classList.toggle("hidden", !matches);
                    if (matches) visible += 1;
                });

                if (empty) empty.classList.toggle("hidden", visible !== 0);
            });
        })();
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Equipo | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-4 py-8">
        <section class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl font-bold text-slate-800">Equipo</h2>

                <p class="mt-1 max-w-3xl text-slate-500">
                    Quién entra a esta instalación y con qué rol. Los
                    <strong>administradores</strong> ven todo y configuran la cuenta;
                    los <strong>agentes</strong> solo ven las conversaciones que se les
                    asignan. Hay <strong><%= activeAdmins %></strong> administrador(es) activo(s).
                </p>
            </div>

            <a
                href="/admin/users/new"
                class="rounded-xl bg-margarita-600 px-4 py-3 text-sm font-semibold text-white hover:bg-margarita-700"
            >
                Nuevo usuario
            </a>
        </section>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                Acción realizada correctamente.
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <%= error %>
            </div>
        <% } %>

        <section class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <table class="w-full text-left text-sm tabla-usuarios">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-5 py-4">Nombre</th>
                        <th class="px-5 py-4">Rol</th>
                        <th class="px-5 py-4">Estado</th>
                        <th class="px-5 py-4">Activo</th>
                        <th class="px-5 py-4">Manual</th>
                        <th class="px-5 py-4">Manuales hoy</th>
                        <th class="px-5 py-4 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    <% if (team.length === 0) { %>
                        <tr>
                            <td colspan="7" class="px-5 py-8 text-center text-slate-500">
                                Todavía no hay usuarios.
                            </td>
                        </tr>
                    <% } %>

                    <% team.forEach((member) => { %>
                        <%
                            const usedToday = (usageToday || {})[member.id] || 0;
                            const limit = member.manualMessageLimit;
                            const isAdmin = member.role === "ADMIN";
                            /** El último admin activo no se puede desactivar. */
                            const cannotDeactivate =
                                isAdmin && member.isActive && activeAdmins <= 1;
                        %>
                        <tr>
                            <td class="px-5 py-4">
                                <div class="font-medium text-slate-800">
                                    <%= member.name %>
                                    <% if (member.id === user.id) { %>
                                        <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-600">
                                            tú
                                        </span>
                                    <% } %>
                                </div>
                                <div class="mt-1 hidden text-xs text-slate-400 md:block"><%= member.email %></div>
                            </td>

                            <td class="px-5 py-4">
                                <span class="rounded-full px-3 py-1 text-xs font-bold <%= isAdmin ? 'bg-margarita-50 text-margarita-700' : 'bg-sky-50 text-sky-700' %>">
                                    <%= isAdmin ? "Administrador" : "Agente" %>
                                </span>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <% if (member.role !== "ADMIN") { %>
                                    <% if (member.status === "AVAILABLE") { %>Disponible<% } %>
                                    <% if (member.status === "BUSY") { %>Ocupado<% } %>
                                    <% if (member.status === "BREAK") { %>Pausa<% } %>
                                    <% if (member.status === "OFFLINE") { %>Desconectado<% } %>
                                <% } else { %>
                                    <span class="text-slate-400">—</span>
                                <% } %>
                            </td>

                            <td class="px-5 py-4">
                                <% if (member.isActive) { %>
                                    <span class="rounded-full bg-margarita-100 px-3 py-1 text-xs font-medium text-margarita-700">
                                        Activo
                                    </span>
                                <% } else { %>
                                    <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-red-700">
                                        Inactivo
                                    </span>
                                <% } %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <% if (isAdmin) { %>
                                    <span class="text-slate-400">Sin tope</span>
                                <% } else if (member.canSendManualMessages) { %>
                                    Sí
                                <% } else { %>
                                    No
                                <% } %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <% if (isAdmin) { %>
                                    <span class="text-slate-400">—</span>
                                <% } else { %>
                                    <span class="<%= limit !== null && usedToday >= limit ? 'font-bold text-red-700' : '' %>">
                                        <%= usedToday %>
                                    </span>

                                    <span class="text-slate-400">
                                        / <%= limit === null ? "sin tope" : limit %>
                                    </span>
                                <% } %>
                            </td>

                            <td class="px-5 py-4">
                                <div class="flex justify-end gap-2">
                                    <a
                                        href="/admin/users/<%= member.id %>/edit"
                                        class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200"
                                    >
                                        Editar
                                    </a>

                                    <% if (cannotDeactivate) { %>
                                        <button
                                            disabled
                                            title="Es el único administrador activo: crea otro antes de desactivarlo."
                                            class="hidden cursor-not-allowed rounded-lg bg-slate-200 px-3 py-2 text-xs font-medium text-slate-500 md:inline-flex"
                                        >
                                            Desactivar
                                        </button>
                                    <% } else { %>
                                        <form action="/admin/users/<%= member.id %>/toggle-status" method="POST" class="hidden md:block">
                                            <button
                                                class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-medium text-white"
                                            >
                                                <%= member.isActive ? "Desactivar" : "Activar" %>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>

        <p class="mt-4 text-xs text-slate-500">
            Cada persona puede cambiar su propia contraseña en
            <a href="/account/password" class="font-semibold text-margarita-700 hover:underline">Mi cuenta</a>.
            Si alguien la olvida, un administrador puede restablecerla desde su ficha.
        </p>
    </main>
</body>
</html>

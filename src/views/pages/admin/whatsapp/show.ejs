<%- include("../../../partials/header", { title: "Cuenta WhatsApp - Admin" }) %>

<div class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-5xl px-4 py-8">
        <div class="mb-6">
            <p class="text-sm font-semibold uppercase tracking-wide text-margarita-600">
                Operación
            </p>

            <h1 class="mt-1 text-3xl font-black text-slate-900">
                Cuenta de WhatsApp
            </h1>

            <p class="mt-2 max-w-3xl text-slate-600">
                Una cuenta de WhatsApp Business (WABA) con sus credenciales y varios
                números. Cada número tiene su propia calidad y sus propios hilos.
            </p>
        </div>

        <% if (success === "connection" || success === "updated" || success === "encrypted" || success === "already_encrypted" || success === "number_created" || success === "number_updated" || success === "number_ai" || success === "number_flows" || success === "number_guided_flows" || success === "account_created") { %>
            <p class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm font-semibold text-margarita-700">
                <% if (success === "account_created") { %>
                    Cuenta configurada. Ahora registra tu primer número aquí abajo.
                <% } else if (success === "connection") { %>
                    Conexión con Meta validada correctamente.
                <% } else if (success === "number_created") { %>
                    Número agregado. Ya puedes elegirlo en el encabezado.
                <% } else if (success === "number_updated") { %>
                    Número actualizado.
                <% } else if (success === "number_ai") { %>
                    Preferencia de IA del número actualizada.
                <% } else if (success === "number_flows") { %>
                    Preferencia de flujos del número actualizada.
                <% } else if (success === "number_guided_flows") { %>
                    Preferencia de flujos guiados del número actualizada.
                <% } else if (success === "encrypted") { %>
                    Credenciales cifradas en la base de datos.
                <% } else if (success === "already_encrypted") { %>
                    Las credenciales ya estaban cifradas.
                <% } else { %>
                    Credenciales actualizadas correctamente.
                <% } %>
            </p>
        <% } %>

        <% if (error) { %>
            <p class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">
                <% if (error === "connection") { %>
                    No se pudo validar la conexión de ese número con Meta.
                <% } else if (error === "account_create") { %>
                    No se pudo configurar la cuenta. Revisa que no exista ya una.
                <% } else if (error === "validation" || error === "number_validation") { %>
                    Revisa los datos: hay valores con formato inválido.
                <% } else if (error === "number_create") { %>
                    No se pudo agregar el número. Revisa que el Phone Number ID no esté repetido.
                <% } else if (error === "encrypt") { %>
                    No se pudieron cifrar las credenciales. Verifica que ENCRYPTION_KEY esté configurada.
                <% } else { %>
                    No se pudo completar la acción.
                <% } %>
            </p>
        <% } %>

        <% if (!account) { %>
            <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <h2 class="text-xl font-bold text-slate-900">
                    Conectar tu cuenta de WhatsApp
                </h2>

                <p class="mt-2 text-sm text-slate-600">
                    Copia estos datos del panel de tu app en Meta (WhatsApp →
                    Configuración de la API). Se guardan cifrados.
                </p>

                <div class="mt-4 rounded-xl bg-slate-50 p-4 text-xs text-slate-600">
                    <p class="font-semibold text-slate-700">
                        De dónde sale cada dato
                    </p>

                    <ul class="mt-2 list-disc space-y-1 pl-5">
                        <li>
                            <strong>Business Account ID</strong>: el identificador de tu
                            cuenta de WhatsApp Business (WABA).
                        </li>
                        <li>
                            <strong>Access token</strong>: el token permanente de un usuario
                            del sistema con permiso sobre la WABA.
                        </li>
                        <li>
                            <strong>Verify token</strong>: una cadena que tú eliges; se pega
                            igual aquí y en la configuración del webhook en Meta.
                        </li>
                    </ul>
                </div>

                <form action="/admin/whatsapp/account" method="POST" class="mt-5 grid gap-4 md:grid-cols-2">
                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            Business Account ID
                        </label>
                        <input
                            name="businessAccountId"
                            required
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            API Version
                        </label>
                        <input
                            name="apiVersion"
                            value="v23.0"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            Access token
                        </label>
                        <input
                            name="accessToken"
                            required
                            autocomplete="off"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            Verify token
                        </label>
                        <input
                            name="verifyToken"
                            required
                            autocomplete="off"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div class="md:col-span-2">
                        <button class="rounded-xl bg-margarita-600 px-5 py-3 text-sm font-semibold text-white hover:bg-margarita-700">
                            Guardar la cuenta
                        </button>
                    </div>
                </form>

                <p class="mt-4 text-xs text-slate-500">
                    El webhook de Meta es
                    <code class="break-all font-semibold"><%= webhookUrl %></code>
                    y se configura una sola vez para toda la cuenta.
                </p>
            </section>
        <% } else { %>
            <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <div class="flex flex-col justify-between gap-3 md:flex-row md:items-start">
                    <div>
                        <h2 class="text-xl font-bold text-slate-900">
                            Números
                        </h2>

                        <p class="mt-1 text-sm text-slate-600">
                            El número activo del encabezado es el que envía los mensajes y
                            campañas, y el que se muestra en la bandeja.
                        </p>
                    </div>

                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                        <%= numbers.length %> registrado(s)
                    </span>
                </div>

                <div class="mt-5 space-y-4">
                    <% if (numbers.length === 0) { %>
                        <p class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
                            No hay números registrados. Agrega el primero para poder enviar.
                        </p>
                    <% } %>

                    <%
                        /** Consumo del mes por número (se calcula en el controlador). */
                        const usageByNumber = new Map(
                            (usage || []).map((item) => [item.numberId, item])
                        );
                    %>

                    <% numbers.forEach((number) => { %>
                        <%
                            const consumo = usageByNumber.get(number.id) || null;
                        %>
                        <div class="rounded-xl border border-slate-200 p-4">
                            <div class="flex flex-col justify-between gap-3 md:flex-row md:items-start">
                                <div>
                                    <p class="font-bold text-slate-900">
                                        <%= number.displayName || number.phoneNumber %>
                                    </p>

                                    <p class="mt-0.5 text-xs text-slate-500">
                                        <%= number.phoneNumber %> · ID <%= number.phoneNumberId %>
                                    </p>

                                    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                                        <span class="rounded-full px-3 py-1 font-semibold <%= number.isActive ? 'bg-margarita-50 text-margarita-700' : 'bg-slate-100 text-slate-500' %>">
                                            <%= number.isActive ? "Activo" : "Inactivo" %>
                                        </span>

                                        <span class="rounded-full px-3 py-1 font-semibold <%= number.aiEnabled ? 'bg-margarita-50 text-margarita-700' : 'bg-amber-50 text-amber-800' %>">
                                            IA <%= number.aiEnabled ? "activa" : "apagada" %>
                                        </span>

                                        <span class="rounded-full px-3 py-1 font-semibold <%= number.flowsEnabled ? 'bg-margarita-50 text-margarita-700' : 'bg-amber-50 text-amber-800' %>">
                                            Flujos <%= number.flowsEnabled ? "activos" : "apagados" %>
                                        </span>

                                        <span class="rounded-full px-3 py-1 font-semibold <%= number.guidedFlowsEnabled ? 'bg-margarita-50 text-margarita-700' : 'bg-amber-50 text-amber-800' %>">
                                            Guiados <%= number.guidedFlowsEnabled ? "activos" : "apagados" %>
                                        </span>

                                        <% if (number.status === "CONNECTED") { %>
                                            <span class="rounded-full bg-margarita-50 px-3 py-1 font-semibold text-margarita-700">
                                                Conectado
                                            </span>
                                        <% } else if (number.status === "ERROR") { %>
                                            <span class="rounded-full bg-red-50 px-3 py-1 font-semibold text-red-700">
                                                Error
                                            </span>
                                        <% } %>

                                        <span class="text-slate-500">
                                            Calidad: <%= number.qualityRating || "sin dato" %>
                                        </span>

                                        <% if (suggestedNumberId === number.id) { %>
                                            <span class="rounded-full bg-sol-100 px-3 py-1 font-semibold text-sol-800">
                                                Con más tramo: sugerido para abrir conversaciones
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="flex flex-wrap gap-2">
                                    <form action="/admin/whatsapp/numbers/<%= number.id %>/test" method="POST">
                                        <button class="rounded-xl bg-margarita-600 px-4 py-2 text-xs font-semibold text-white hover:bg-margarita-700">
                                            Probar conexión
                                        </button>
                                    </form>

                                    <form action="/admin/whatsapp/numbers/<%= number.id %>/toggle" method="POST">
                                        <button class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">
                                            <%= number.isActive ? "Desactivar" : "Activar" %>
                                        </button>
                                    </form>

                                    <form action="/admin/whatsapp/numbers/<%= number.id %>/ai" method="POST">
                                        <input type="hidden" name="enabled" value="<%= number.aiEnabled ? "false" : "true" %>" />
                                        <button class="rounded-xl px-4 py-2 text-xs font-semibold <%= number.aiEnabled ? 'bg-amber-50 text-amber-800 hover:bg-amber-100' : 'bg-margarita-600 text-white hover:bg-margarita-700' %>">
                                            <%= number.aiEnabled ? "Apagar IA" : "Encender IA" %>
                                        </button>
                                    </form>

                                    <form action="/admin/whatsapp/numbers/<%= number.id %>/flows" method="POST">
                                        <input type="hidden" name="enabled" value="<%= number.flowsEnabled ? "false" : "true" %>" />
                                        <button class="rounded-xl px-4 py-2 text-xs font-semibold <%= number.flowsEnabled ? 'bg-amber-50 text-amber-800 hover:bg-amber-100' : 'bg-margarita-600 text-white hover:bg-margarita-700' %>">
                                            <%= number.flowsEnabled ? "Apagar flujos" : "Encender flujos" %>
                                        </button>
                                    </form>

                                    <form action="/admin/whatsapp/numbers/<%= number.id %>/guided-flows" method="POST">
                                        <input type="hidden" name="enabled" value="<%= number.guidedFlowsEnabled ? "false" : "true" %>" />
                                        <button class="rounded-xl px-4 py-2 text-xs font-semibold <%= number.guidedFlowsEnabled ? 'bg-amber-50 text-amber-800 hover:bg-amber-100' : 'bg-margarita-600 text-white hover:bg-margarita-700' %>">
                                            <%= number.guidedFlowsEnabled ? "Apagar guiados" : "Encender guiados" %>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <% if (consumo) { %>
                                <div class="mt-4 rounded-xl bg-slate-50 p-4 ring-1 <%= consumo.alert ? 'ring-amber-200' : 'ring-slate-200' %>">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">
                                            Tramo del mes · servicio
                                        </p>

                                        <% if (consumo.alert) { %>
                                            <span class="rounded-full bg-amber-100 px-3 py-1 text-[11px] font-bold text-amber-900">
                                                Pasó el <%= consumo.service.percent %>% del tramo
                                            </span>
                                        <% } %>
                                    </div>

                                    <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-slate-200">
                                        <div
                                            class="h-full rounded-full <%= consumo.alert ? 'bg-amber-500' : 'bg-margarita-500' %>"
                                            style="width: <%= consumo.service.percent %>%"
                                        ></div>
                                    </div>

                                    <p class="mt-2 text-xs text-slate-600">
                                        <strong><%= consumo.service.used %></strong> de
                                        <%= consumo.service.limit %> mensajes ·
                                        quedan <strong><%= consumo.service.remaining %></strong>
                                        · <%= consumo.service.percent %>%
                                    </p>

                                    <p class="mt-1 text-xs text-slate-500">
                                        Plantillas de utilidad: <%= consumo.utility.used %>
                                        (~<%= consumo.currency %> <%= consumo.utility.cost.toFixed(2) %>)
                                        · marketing: <%= consumo.marketing.used %>
                                        (~<%= consumo.currency %> <%= consumo.marketing.cost.toFixed(2) %>)
                                        <% if (consumo.otherTemplates > 0) { %>
                                            · otras plantillas: <%= consumo.otherTemplates %>
                                        <% } %>
                                    </p>

                                    <p class="mt-1 text-[11px] text-slate-400">
                                        Costo estimado del mes:
                                        <%= consumo.currency %> <%= consumo.estimatedCost.toFixed(2) %>.
                                        Cuenta solo lo entregado o leído; el cargo real lo hace Meta.
                                    </p>
                                </div>
                            <% } %>

                            <form
                                action="/admin/whatsapp/numbers/<%= number.id %>"
                                method="POST"
                                class="mt-4 grid gap-3 border-t border-slate-100 pt-4 md:grid-cols-4"
                            >
                                <input
                                    name="displayName"
                                    value="<%= number.displayName || '' %>"
                                    placeholder="Nombre visible"
                                    class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                />

                                <input
                                    name="phoneNumber"
                                    value="<%= number.phoneNumber %>"
                                    placeholder="Número"
                                    class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                />

                                <input
                                    name="phoneNumberId"
                                    value="<%= number.phoneNumberId %>"
                                    placeholder="Phone Number ID"
                                    class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                />

                                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                                    Guardar
                                </button>
                            </form>
                        </div>
                    <% }) %>
                </div>

                <details class="mt-5">
                    <summary class="inline-flex cursor-pointer items-center gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50">
                        Agregar otro número
                    </summary>

                    <form
                        action="/admin/whatsapp/numbers"
                        method="POST"
                        class="mt-3 grid gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 md:grid-cols-4"
                    >
                        <input
                            name="displayName"
                            placeholder="Nombre (seguimientos)"
                            class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />

                        <input
                            name="phoneNumber"
                            required
                            placeholder="Número con lada"
                            class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />

                        <input
                            name="phoneNumberId"
                            required
                            placeholder="Phone Number ID"
                            class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />

                        <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                            Agregar
                        </button>
                    </form>

                    <p class="mt-2 text-xs text-slate-500">
                        Usa las mismas credenciales de la cuenta: el número se registra con
                        su Phone Number ID y su nombre visible.
                    </p>
                </details>
            </section>

            <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <h2 class="text-xl font-bold text-slate-900">
                    Credenciales de la cuenta
                </h2>

                <p class="mt-1 text-sm text-slate-600">
                    Se comparten entre todos los números. Deja un campo vacío para conservar
                    el valor actual; los tokens se guardan cifrados.
                </p>

                <dl class="mt-4 grid gap-3 md:grid-cols-2">
                    <div class="rounded-xl bg-slate-50 p-4">
                        <dt class="text-xs font-semibold uppercase text-slate-500">
                            Business Account ID
                        </dt>
                        <dd class="mt-1 break-all text-sm text-slate-800">
                            <%= account.businessAccountId %>
                        </dd>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <dt class="text-xs font-semibold uppercase text-slate-500">
                            API Version
                        </dt>
                        <dd class="mt-1 text-sm text-slate-800">
                            <%= account.apiVersion %>
                        </dd>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <dt class="text-xs font-semibold uppercase text-slate-500">
                            Access Token
                        </dt>
                        <dd class="mt-1 break-all text-sm text-slate-800">
                            <%= account.maskedAccessToken %>
                        </dd>
                    </div>

                    <div class="rounded-xl bg-slate-50 p-4">
                        <dt class="text-xs font-semibold uppercase text-slate-500">
                            Verify Token
                        </dt>
                        <dd class="mt-1 break-all text-sm text-slate-800">
                            <%= account.maskedVerifyToken %>
                        </dd>
                    </div>
                </dl>

                <form
                    action="/admin/whatsapp/credentials"
                    method="POST"
                    class="mt-5 grid gap-4 md:grid-cols-2"
                >
                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            Business Account ID
                        </label>
                        <input
                            name="businessAccountId"
                            value="<%= account.businessAccountId %>"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            API Version
                        </label>
                        <input
                            name="apiVersion"
                            value="<%= account.apiVersion %>"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            Access Token (nuevo)
                        </label>
                        <input
                            name="accessToken"
                            placeholder="Deja vacío para no cambiarlo"
                            autocomplete="off"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase text-slate-500">
                            Verify Token (nuevo)
                        </label>
                        <input
                            name="verifyToken"
                            placeholder="Deja vacío para no cambiarlo"
                            autocomplete="off"
                            class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                        />
                    </div>

                    <div class="md:col-span-2">
                        <button class="rounded-xl bg-margarita-600 px-5 py-3 text-sm font-semibold text-white hover:bg-margarita-700">
                            Guardar credenciales
                        </button>
                    </div>
                </form>
            </section>

            <section class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <h2 class="text-xl font-bold text-slate-900">
                    Cifrado de credenciales
                </h2>

                <% if (account.encryptedAtRest) { %>
                    <p class="mt-2 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                        Las credenciales están cifradas en la base de datos (AES-256-GCM).
                    </p>
                <% } else { %>
                    <p class="mt-2 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
                        Las credenciales todavía están en texto plano. Configura ENCRYPTION_KEY
                        en las variables de entorno y pulsa el botón para cifrarlas.
                    </p>

                    <form action="/admin/whatsapp/encrypt-secrets" method="POST" class="mt-4">
                        <button class="rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                            Cifrar credenciales existentes
                        </button>
                    </form>
                <% } %>
            </section>

            <section class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5">
                <h3 class="font-bold text-amber-800">
                    Webhook
                </h3>

                <p class="mt-2 text-sm text-amber-800">
                    El callback que debes registrar en Meta es
                    <code class="break-all font-semibold"><%= webhookUrl %></code>
                    y el campo suscrito es <code class="font-semibold">messages</code>.
                    Los eventos de todos los números llegan a esa misma dirección.
                </p>
            </section>
        <% } %>
    </main>
</div>

<%- include("../../../partials/footer") %>

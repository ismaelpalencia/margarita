<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sesiones | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-4 py-8">
        <section class="mb-6">
            <h2 class="text-2xl font-bold text-slate-800">Sesiones activas</h2>

            <p class="mt-1 max-w-3xl text-slate-500">
                Cada quien entra con su usuario; aquí se ve desde qué dispositivo
                y desde qué IP. Una sesión se cierra sola después de
                <strong><%= idleHours %> horas</strong> sin usarse, y cada
                usuario puede tener cuando mucho <strong><%= maxActive %></strong>
                abiertas a la vez: al entrar en una más, se cierra la más vieja.
            </p>
        </section>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                <%= success === "revoked-others"
                    ? "Se cerraron tus otras sesiones."
                    : "Sesión cerrada." %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <%= error === "current"
                    ? "Esa es tu sesión actual: para cerrarla usa «Salir»."
                    : "No se pudo cerrar la sesión." %>
            </div>
        <% } %>

        <section class="mb-4 flex flex-wrap items-center gap-3">
            <form action="/admin/sessions/revoke-others" method="POST">
                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                    Cerrar mis otras sesiones
                </button>
            </form>

            <p class="text-xs text-slate-500">
                Úsalo si viste algo que no reconoces en la lista.
            </p>
        </section>

        <%- include("../../../partials/sessions-table", {
            sessions,
            basePath: "/admin/sessions",
            showUser: true
        }) %>
    </main>
</body>
</html>

<%- include("../../../partials/header", { title: "Botones y listas - Admin" }) %>

<div class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-5xl px-4 py-8">
        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-wide text-margarita-600">
                Cobranza
            </p>

            <h1 class="mt-1 text-3xl font-black text-slate-900">
                Botones y listas
            </h1>

            <p class="mt-2 text-slate-600">
                Cuando el deudor toca un botón, la respuesta se traduce sola al
                resultado de gestión que ya usa el equipo. Aquí se define esa
                traducción: es lo que convierte un toque en un renglón del reporte.
            </p>
        </div>

        <% if (success === "created") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
                Se crearon las reglas recomendadas para cobranza.
            </div>
        <% } else if (success === "saved") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
                Regla guardada.
            </div>
        <% } else if (success === "removed") { %>
            <div class="mb-5 rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-700">
                Regla eliminada.
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <%= error %>
            </div>
        <% } %>

        <section class="mb-6 rounded-2xl bg-slate-950 p-6 text-white">
            <p class="font-black">
                Lo que un botón resuelve
            </p>

            <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-300">
                <li>
                    <strong class="text-white">«Ya pagué» no marca pagado.</strong>
                    Entra como <em>pago reportado, por confirmar</em>: si se contara
                    como recuperación, estaríamos reportando dinero que nadie verificó.
                </li>
                <li>
                    <strong class="text-white">«No reconozco la deuda» pausa la cuenta</strong>
                    y deja el incidente con nivel de error, que es lo que dispara las
                    alertas: se revisa hoy, no al cierre del mes.
                </li>
                <li>
                    <strong class="text-white">«No quiero ser contactado» da de baja</strong>
                    el mismo día, sin depender de la palabra clave.
                </li>
            </ul>

            <form action="/admin/replies/recommended" method="POST" class="mt-5">
                <button class="rounded-xl bg-sol-400 px-5 py-3 text-sm font-black text-margarita-950 hover:bg-sol-300">
                    Crear las reglas recomendadas
                </button>
            </form>

            <p class="mt-2 text-xs text-slate-400">
                No pisa las que ya editaste: solo agrega las que faltan.
            </p>
        </section>

        <section class="mb-8 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <table class="w-full text-left text-sm tabla-botones">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-5 py-4">Identificador</th>
                        <th class="px-5 py-4">Texto del botón</th>
                        <th class="px-5 py-4">Resultado de gestión</th>
                        <th class="px-5 py-4">Efecto</th>
                        <th class="px-5 py-4 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    <% if (rules.length === 0) { %>
                        <tr>
                            <td colspan="5" class="px-5 py-8 text-center text-slate-500">
                                Todavía no hay reglas. Crea las recomendadas y ajústalas.
                            </td>
                        </tr>
                    <% } %>

                    <% rules.forEach((rule) => { %>
                        <tr class="<%= rule.isActive ? '' : 'opacity-50' %>">
                            <td class="px-5 py-4">
                                <p class="font-mono text-xs font-semibold text-slate-700">
                                    <%= rule.replyId %>
                                </p>

                                <% if (!rule.isActive) { %>
                                    <p class="mt-1 text-[11px] font-bold uppercase text-slate-400">
                                        Inactiva
                                    </p>
                                <% } %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <%= rule.replyTitle || "—" %>
                            </td>

                            <td class="px-5 py-4">
                                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= outcomeBadgeClasses[rule.outcomeType] || 'bg-slate-100 text-slate-600' %>">
                                    <%= outcomeLabels[rule.outcomeType] || rule.outcomeType %>
                                </span>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <%= effectLabels[rule.effect] || rule.effect %>
                            </td>

                            <td class="px-5 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <form action="/admin/replies/<%= rule.id %>/active" method="POST">
                                        <input type="hidden" name="isActive" value="<%= rule.isActive ? "0" : "1" %>" />

                                        <button class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">
                                            <%= rule.isActive ? "Desactivar" : "Activar" %>
                                        </button>
                                    </form>

                                    <form
                                        action="/admin/replies/<%= rule.id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('¿Eliminar esta regla? Las respuestas de ese botón dejarán de registrarse solas.');"
                                    >
                                        <button class="rounded-xl bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-100">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>

        <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h2 class="text-lg font-bold text-slate-900">
                Agregar o corregir una regla
            </h2>

            <p class="mt-2 text-xs text-slate-500">
                Se guarda por identificador: si ya existe una regla con ese
                identificador, se actualiza. Deja el texto del botón escrito igual
                que en el mensaje: sirve de respaldo para cuando Meta no manda un
                identificador propio.
            </p>

            <form action="/admin/replies" method="POST" class="mt-4 grid gap-4 md:grid-cols-2">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Identificador del botón
                    </label>

                    <input
                        name="replyId"
                        required
                        placeholder="YA_PAGUE"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Texto del botón
                    </label>

                    <input
                        name="replyTitle"
                        placeholder="Ya pagué"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Resultado de gestión
                    </label>

                    <select
                        name="outcomeType"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    >
                        <% outcomeTypes.forEach((type) => { %>
                            <option value="<%= type %>"><%= outcomeLabels[type] %></option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Efecto automático
                    </label>

                    <select
                        name="effect"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    >
                        <% effects.forEach((effect) => { %>
                            <option value="<%= effect %>"><%= effectLabels[effect] %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Nota (queda en el historial del cliente)
                    </label>

                    <input
                        name="note"
                        placeholder="Ej. Entra como pago reportado: hay que confirmarlo."
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <button class="md:col-span-2 rounded-xl bg-margarita-600 px-4 py-3 font-semibold text-white hover:bg-margarita-700">
                    Guardar regla
                </button>
            </form>
        </section>
    </main>
</div>

<%- include("../../../partials/footer") %>

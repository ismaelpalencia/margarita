<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conversaciones | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body
    class="min-h-screen bg-slate-100"
    data-live-page="inbox"
    data-live-base="/admin/conversations"
>
    <header class="border-b bg-white">
        <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div>
                <a href="/admin/dashboard" class="flex items-center gap-3">
                    <img
                        src="/brand/img/margarita-icon-64.png"
                        alt="Margarita"
                        class="h-9 w-9"
                    />

                    <span class="min-w-0">
                        <span class="block text-base font-black leading-tight text-slate-900">
                            Margarita
                        </span>

                        <span class="block text-xs font-medium text-slate-500">
                            Conversaciones
                        </span>
                    </span>
                </a>
            </div>

            <nav class="no-scrollbar -mx-4 flex items-center gap-3 overflow-x-auto whitespace-nowrap px-4 sm:mx-0 sm:flex-wrap sm:overflow-x-visible sm:px-0">
                <a href="/admin/dashboard" class="text-sm font-medium text-slate-700">Dashboard</a>
                <a href="/admin/users" class="text-sm font-medium text-slate-700">Agentes</a>
                <a href="/admin/contacts" class="text-sm font-medium text-slate-700">Contactos</a>
                <a href="/admin/tags" class="text-sm font-medium text-slate-700">Etiquetas</a>
                <a href="/admin/whatsapp" class="text-sm font-medium text-slate-700">WhatsApp</a>
                <a href="/admin/templates" class="text-sm font-medium text-slate-700">Plantillas</a>
                <a href="/admin/conversations" class="text-sm font-medium text-margarita-700">Conversaciones</a>

                <%- include("../../../partials/theme-toggle") %>

                <form action="/auth/logout" method="POST">
                    <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white">
                        Cerrar sesión
                    </button>
                </form>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8">
        <section class="mb-6 flex items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl font-bold text-slate-800">
                    Conversaciones
                </h2>

                <p class="mt-1 text-slate-500">
                    Vista general de las conversaciones de la empresa.
                </p>

                <% if (typeof suggestedNumber !== "undefined" && suggestedNumber) { %>
                    <p class="mt-2 inline-flex flex-wrap items-center gap-2 rounded-full bg-margarita-50 px-3 py-1 text-xs font-semibold text-margarita-800 ring-1 ring-margarita-200">
                        Para conversaciones nuevas, el número con más tramo es
                        <strong><%= suggestedNumber.displayName %></strong>
                        (quedan <%= suggestedNumber.service.remaining %> de
                        <%= suggestedNumber.service.limit %> mensajes de servicio este mes).
                    </p>
                <% } %>
            </div>
        </section>

        <form action="/admin/conversations" method="GET" class="mb-6 grid gap-3 md:grid-cols-[1fr_180px_180px_auto_auto]">
            <input
                type="search"
                name="search"
                value="<%= search %>"
                placeholder="Buscar por nombre o teléfono"
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            />

            <select
                name="status"
                class="rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            >
                <option value="">Todos los estados</option>
                <option value="OPEN" <% if (status === "OPEN") { %> selected <% } %>>Abiertas</option>
                <option value="CLOSED" <% if (status === "CLOSED") { %> selected <% } %>>Cerradas</option>
                <option value="ARCHIVED" <% if (status === "ARCHIVED") { %> selected <% } %>>Archivadas</option>
            </select>

            <select
                name="assigned"
                class="rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            >
                <option value="">Todas las asignaciones</option>
                <option value="mine" <% if (assigned === "mine") { %> selected <% } %>>Asignadas a mí</option>
                <option value="unassigned" <% if (assigned === "unassigned") { %> selected <% } %>>Sin asignar</option>
            </select>

            <label class="flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
                <input
                    type="checkbox"
                    name="unread"
                    value="1"
                    class="h-4 w-4 rounded border-slate-300"
                    <% if (onlyUnread) { %> checked <% } %>
                />

                Sin leer
            </label>

            <button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white">
                Filtrar
            </button>

            <% if (status || search || assigned || onlyUnread) { %>
                <a href="/admin/conversations" class="rounded-xl bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-700">
                    Limpiar
                </a>
            <% } %>
        </form>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                Acción realizada correctamente.
            </div>
        <% } %>

        <section class="overflow-x-auto rounded-2xl bg-white shadow">
            <table class="w-full text-left text-sm tabla-conversaciones">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-5 py-4">Contacto</th>
                        <th class="px-5 py-4">Estado</th>
                        <th class="px-5 py-4">Operación</th>
                        <th class="px-5 py-4">Asignado a</th>
                        <th class="px-5 py-4">Último mensaje</th>
                        <th class="px-5 py-4 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    <% if (conversations.length === 0) { %>
                        <tr>
                            <td colspan="6" class="px-5 py-8 text-center text-slate-500">
                                No hay conversaciones para mostrar.
                            </td>
                        </tr>
                    <% } %>

                    <% conversations.forEach((conversation) => { %>
                        <% const lastMessage = conversation.messages[0]; %>

                        <tr>
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-slate-800">
                                        <%= conversation.contact.customName || conversation.contact.profileName || conversation.contact.phone %>
                                    </span>

                                    <%- include("../../../partials/number-badge", { number: conversation.whatsappNumber }) %>

                                    <% if (conversation.unreadCount > 0) { %>
                                        <span class="rounded-full bg-margarita-600 px-2 py-0.5 text-[11px] font-bold text-white">
                                            <%= conversation.unreadCount %>
                                        </span>
                                    <% } %>

                                    <% if (conversation.contact.optOutAt) { %>
                                        <span
                                            class="rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-bold text-red-700"
                                            title="Pidió la baja: no se le envían mensajes"
                                        >
                                            BAJA
                                        </span>
                                    <% } %>
                                </div>
                                <div class="mt-1 text-xs text-slate-400">
                                    <%= conversation.contact.phone %>
                                </div>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <%= conversation.status %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <%= conversation.operationalStatus %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <% if (conversation.assignedUser) { %>
                                    <%= conversation.assignedUser.name %>
                                <% } else { %>
                                    Sin asignar
                                <% } %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <% if (lastMessage) { %>
                                    <span class="line-clamp-1">
                                        <%= lastMessage.body || lastMessage.type %>
                                    </span>
                                <% } else { %>
                                    —
                                <% } %>
                            </td>

                            <td class="px-5 py-4 text-right">
                                <a
                                    href="/admin/conversations/<%= conversation.id %>"
                                    class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-medium text-white"
                                >
                                    Ver
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/copy.js"></script>
    <script src="/js/live.js"></script>
</body>
</html>

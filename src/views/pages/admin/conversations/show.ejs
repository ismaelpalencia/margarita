<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conversación | Margarita</title>
    <link rel="stylesheet" href="/css/style.css" />

    <%- include("../../../partials/brand-head") %>
</head>

<body
    class="min-h-screen bg-slate-100"
    data-live-page="conversation"
    data-conversation-id="<%= conversation.id %>"
    data-live-base="/admin/conversations"
>
<%
    const contactName =
        conversation.contact.customName ||
        conversation.contact.profileName ||
        conversation.contact.phone;

    const initials = contactName
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((word) => word[0])
        .join("")
        .toUpperCase();

    const hasOpenWindow =
        conversation.lastIncomingMessageAt &&
        new Date().getTime() - new Date(conversation.lastIncomingMessageAt).getTime() <=
            24 * 60 * 60 * 1000;

    const logsUrl = "/admin/logs?module=MESSAGE";
%>

    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
            <a href="/admin/dashboard" class="inline-block">
                <img
                    src="/brand/img/margarita-wordmark-256.png"
                    alt="Margarita"
                    class="h-7 w-auto"
                />
            </a>

            <nav class="flex items-center gap-3">
                <a href="/admin/conversations" class="text-sm font-medium text-slate-700">
                    ← Conversaciones
                </a>

                <form action="/auth/logout" method="POST">
                    <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white">
                        Cerrar sesión
                    </button>
                </form>
            </nav>
        </div>
    </header>

    <main class="mx-auto grid w-full max-w-7xl gap-4 px-3 py-4 lg:grid-cols-[1fr_340px] lg:px-4">
        <section class="flex h-[calc(100vh-130px)] flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <div class="flex items-center gap-3 border-b border-slate-200 px-4 py-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700">
                    <%= initials %>
                </div>

                <div class="min-w-0">
                    <p class="truncate font-bold text-slate-900">
                        <%= contactName %>
                    </p>

                    <p class="truncate text-xs text-slate-500">
                        <%= conversation.contact.phone %>
                    </p>
                </div>

                <div class="ml-auto flex shrink-0 items-center gap-2">
                    <% if (showDeleted) { %>
                        <a
                            href="/admin/conversations/<%= conversation.id %>"
                            class="rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white"
                        >
                            Ocultar eliminados
                        </a>
                    <% } else { %>
                        <a
                            href="/admin/conversations/<%= conversation.id %>?deleted=1"
                            class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"
                        >
                            Ver eliminados
                        </a>
                    <% } %>

                    <span class="rounded-full px-3 py-1 text-xs font-semibold <%= hasOpenWindow ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                        <%= hasOpenWindow ? "Ventana abierta" : "Ventana cerrada" %>
                    </span>
                </div>
            </div>

            <% if (success === "assigned" || success === "closed" || success === "reopened" || success === "deleted" || success === "restored" || success === "purged" || success === "free_text" || success === "template" || success === "message") { %>
                <p class="border-b border-emerald-100 bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-700">
                    Acción realizada correctamente.
                </p>
            <% } %>

            <% if (error === "confirm") { %>
                <p class="border-b border-red-100 bg-red-50 px-4 py-2 text-xs font-semibold text-red-700">
                    Para borrar todo el chat hay que escribir BORRAR en la confirmación.
                </p>
            <% } else if (error) { %>
                <p class="border-b border-red-100 bg-red-50 px-4 py-2 text-xs font-semibold text-red-700">
                    No se pudo completar la acción.
                </p>
            <% } %>

            <div
                class="flex-1 space-y-2 overflow-y-auto px-3 py-4 sm:px-5"
                style="background-color: #f4f7f5; background-image: radial-gradient(#dde5e0 1px, transparent 1px); background-size: 22px 22px;"
                data-live-messages
            >
                <% if (conversation.messages.length === 0) { %>
                    <div class="rounded-xl bg-white p-5 text-center text-sm text-slate-500" data-live-empty>
                        Todavía no hay mensajes en esta conversación.
                    </div>
                <% } %>

                <% let lastDay = null; %>

                <% conversation.messages.forEach((message) => { %>
                    <% const day = message.createdAt.toDateString(); %>

                    <% if (day !== lastDay) { %>
                        <% lastDay = day; %>

                        <div class="flex justify-center py-2">
                            <span class="rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold text-slate-500 shadow-sm">
                                <%= formatDayLabelMX(message.createdAt) %>
                            </span>
                        </div>
                    <% } %>

                    <%- include("../../../partials/message-bubble", {
                        message,
                        logsUrl,
                        deleteUrl: `/admin/conversations/${conversation.id}/messages/${message.id}/delete`,
                        restoreUrl: `/admin/conversations/${conversation.id}/messages/${message.id}/restore`
                    }) %>
                <% }) %>
            </div>

            <div class="border-t border-slate-200 bg-white p-3">
                <% if (conversation.status !== "OPEN") { %>
                    <p class="rounded-xl bg-slate-50 px-4 py-3 text-center text-sm text-slate-500">
                        Esta conversación está cerrada. Reábrela para responder.
                    </p>
                <% } else if (hasOpenWindow) { %>
                    <form
                        action="/admin/conversations/<%= conversation.id %>/messages/free-text"
                        method="POST"
                        class="flex items-end gap-2"
                    >
                        <textarea
                            name="body"
                            rows="1"
                            required
                            placeholder="Escribe un mensaje"
                            class="max-h-32 flex-1 resize-none rounded-2xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"
                        ></textarea>

                        <button class="rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700">
                            Enviar
                        </button>
                    </form>

                    <p class="mt-2 text-[11px] text-slate-400">
                        Envío libre habilitado: el cliente respondió en las últimas 24 horas.
                    </p>
                <% } else { %>
                    <div class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
                        La ventana de 24 horas está cerrada: para reabrir la conversación hay que enviar una plantilla.
                    </div>
                <% } %>

                <details class="mt-3">
                    <summary class="cursor-pointer text-xs font-semibold text-slate-500">
                        Más opciones: plantilla, nota interna y borrado
                    </summary>

                    <div class="mt-3 grid gap-3">
                        <form
                            action="/admin/conversations/<%= conversation.id %>/messages/template"
                            method="POST"
                            class="space-y-2 rounded-xl border border-emerald-200 bg-emerald-50 p-3"
                        >
                            <p class="text-sm font-semibold text-slate-800">
                                Enviar plantilla
                            </p>

                            <% if (templates.length === 0) { %>
                                <p class="text-xs text-slate-500">
                                    No hay plantillas aprobadas sincronizadas.
                                </p>
                            <% } else { %>
                                <select
                                    name="templateId"
                                    required
                                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                >
                                    <option value="">Selecciona plantilla</option>

                                    <% templates.forEach((template) => { %>
                                        <option value="<%= template.id %>">
                                            <%= template.name %> · <%= template.language %>
                                        </option>
                                    <% }) %>
                                </select>

                                <div class="grid gap-2 sm:grid-cols-3">
                                    <% [1, 2, 3].forEach((position) => { %>
                                        <input
                                            name="variable<%= position %>"
                                            placeholder="Variable <%= position %>"
                                            class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                        />
                                    <% }) %>
                                </div>

                                <button class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
                                    Enviar plantilla
                                </button>
                            <% } %>
                        </form>

                        <form
                            action="/admin/conversations/<%= conversation.id %>/messages/local"
                            method="POST"
                            class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-3"
                        >
                            <p class="text-sm font-semibold text-slate-800">
                                Nota interna
                            </p>

                            <textarea
                                name="body"
                                rows="2"
                                required
                                placeholder="Solo la ve el equipo. No se envía a WhatsApp."
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                            ></textarea>

                            <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                                Guardar nota
                            </button>
                        </form>

                        <form
                            action="/admin/conversations/<%= conversation.id %>/purge"
                            method="POST"
                            class="space-y-2 rounded-xl border border-red-200 bg-red-50 p-3"
                            onsubmit="return confirm('Se eliminarán TODOS los mensajes de esta conversación. Esta acción no se puede deshacer. ¿Continuar?');"
                        >
                            <p class="text-sm font-semibold text-red-800">
                                Borrar todo el chat
                            </p>

                            <p class="text-xs text-red-700">
                                Elimina definitivamente los mensajes de esta conversación. Para
                                confirmar, escribe <strong>BORRAR</strong>.
                            </p>

                            <input
                                name="confirm"
                                placeholder="BORRAR"
                                autocomplete="off"
                                class="w-full rounded-xl border border-red-300 px-3 py-2 text-sm"
                            />

                            <button class="rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">
                                Borrar todo el chat
                            </button>
                        </form>
                    </div>
                </details>
            </div>
        </section>

        <aside class="space-y-4">
            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Asignación
                </h3>

                <form action="/admin/conversations/<%= conversation.id %>/assign" method="POST" class="mt-4 space-y-3">
                    <select
                        name="agentId"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"
                    >
                        <option value="">Sin asignar</option>

                        <% agents.forEach((agent) => { %>
                            <option
                                value="<%= agent.id %>"
                                <% if (conversation.assignedUserId === agent.id) { %> selected <% } %>
                            >
                                <%= agent.name %> · <%= agent.status %>
                            </option>
                        <% }) %>
                    </select>

                    <button class="w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-700">
                        Guardar asignación
                    </button>
                </form>
            </section>

            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Datos
                </h3>

                <dl class="mt-4 space-y-3 text-sm">
                    <div>
                        <dt class="text-slate-500">Estado</dt>
                        <dd class="font-medium text-slate-800"><%= conversation.status %></dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Operación</dt>
                        <dd class="font-medium text-slate-800"><%= conversation.operationalStatus %></dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Origen</dt>
                        <dd class="font-medium text-slate-800"><%= conversation.source %></dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Asignado a</dt>
                        <dd class="font-medium text-slate-800">
                            <%= conversation.assignedUser ? conversation.assignedUser.name : "Sin asignar" %>
                        </dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Último mensaje entrante</dt>
                        <dd class="font-medium text-slate-800">
                            <% if (conversation.lastIncomingMessageAt) { %>
                                <%= formatDateTimeMX(conversation.lastIncomingMessageAt) %>
                            <% } else { %>
                                —
                            <% } %>
                        </dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Ventana 24h</dt>
                        <dd class="font-medium <%= hasOpenWindow ? 'text-emerald-700' : 'text-red-700' %>">
                            <%= hasOpenWindow ? "Abierta" : "Cerrada" %>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Etiquetas
                </h3>

                <div class="mt-4 flex flex-wrap gap-2">
                    <% if (conversation.contact.tags.length === 0) { %>
                        <span class="text-sm text-slate-400">Sin etiquetas</span>
                    <% } %>

                    <% conversation.contact.tags.forEach((contactTag) => { %>
                        <span
                            class="rounded-full px-3 py-1 text-xs font-semibold text-white"
                            style="background-color: <%= contactTag.tag.color || '#10b981' %>;"
                        >
                            <%= contactTag.tag.name %>
                        </span>
                    <% }) %>
                </div>
            </section>

            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Acciones
                </h3>

                <div class="mt-4 space-y-3">
                    <% if (conversation.status === "OPEN") { %>
                        <form action="/admin/conversations/<%= conversation.id %>/close" method="POST">
                            <button class="w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white">
                                Cerrar conversación
                            </button>
                        </form>
                    <% } else { %>
                        <form action="/admin/conversations/<%= conversation.id %>/reopen" method="POST">
                            <button class="w-full rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white">
                                Reabrir conversación
                            </button>
                        </form>
                    <% } %>
                </div>
            </section>

            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Historial de asignación
                </h3>

                <div class="mt-4 space-y-3 text-sm text-slate-600">
                    <% if (conversation.assignments.length === 0) { %>
                        <p class="text-slate-400">Sin asignaciones registradas.</p>
                    <% } %>

                    <% conversation.assignments.forEach((assignment) => { %>
                        <div class="rounded-xl bg-slate-50 p-3">
                            <p>
                                <strong><%= assignment.assignedBy.name %></strong>
                                asignó de
                                <strong><%= assignment.fromUser ? assignment.fromUser.name : 'Sin asignar' %></strong>
                                a
                                <strong><%= assignment.toUser ? assignment.toUser.name : 'Sin asignar' %></strong>
                            </p>

                            <p class="mt-1 text-xs text-slate-400">
                                <%= formatDateTimeMX(assignment.createdAt) %>
                            </p>
                        </div>
                    <% }) %>
                </div>
            </section>
        </aside>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/live.js"></script>
</body>
</html>

<%- include("../../../partials/header", { title: "Nueva campaña - Admin" }) %>

<div class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-4 py-8">
        <div class="mb-8">
            <a href="/admin/campaigns" class="text-sm font-semibold text-margarita-600 hover:text-margarita-700">
                ← Volver a campañas
            </a>

            <h1 class="mt-3 text-3xl font-bold text-slate-900">
                Nueva campaña
            </h1>

            <p class="mt-2 text-slate-600">
                Crea una campaña con contactos seleccionados o importando un Excel.
            </p>
        </div>

        <% if (error) { %>
            <div class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <% if (error === "excel_validation") { %>
                    Sube un archivo Excel/CSV válido y completa nombre/plantilla.
                <% } else if (error === "excel_create") { %>
                    No se pudo crear la campaña desde Excel. Verifica que exista la columna phone.
                <% } else if (error === "validation") { %>
                    Completa el nombre, la plantilla y selecciona al menos un contacto.
                <% } else if (error === "variables") { %>
                    A la plantilla le falta algún valor: las variables del cuerpo, la del
                    <strong>encabezado</strong> o la del <strong>botón de enlace</strong>, o bien algún
                    contacto quedó sin el dato. Recuerda que puedes usar
                    <code class="font-semibold">{nombre}</code>, <code class="font-semibold">{telefono}</code>
                    y, desde Excel, <code class="font-semibold">{columna:Nombre}</code>.
                <% } else if (error === "marketing") { %>
                    Meta clasificó esa plantilla como <strong>marketing</strong>: cada mensaje cuesta
                    varias veces más que una de utilidad, así que no se puede usar en una campaña.
                    Revisa el texto (nada de promociones, urgencias ni mayúsculas sostenidas), vuelve a
                    aprobarla en Meta y sincroniza las plantillas.
                <% } else if (error === "column") { %>
                    El archivo no tiene la columna que referenciaste en una variable.
                    Revisa que el nombre coincida exactamente con el encabezado del Excel.
                <% } else if (error === "contacts") { %>
                    No hay contactos válidos seleccionados para la campaña.
                <% } else if (error === "recipients") { %>
                    Algunos destinatarios no tienen los valores de las variables de la plantilla.
                    Crea la campaña de nuevo con esos datos.
                <% } else { %>
                    No se pudo crear la campaña. Revisa plantilla, contactos o archivo Excel.
                <% } %>
            </div>
        <% } %>

        <section class="mb-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
                <div>
                    <h2 class="text-xl font-bold text-slate-900">
                        Crear desde Excel
                    </h2>

                    <p class="mt-2 text-sm text-slate-600">
                        El archivo debe tener una columna <strong>phone</strong>. Opcionalmente puede tener <strong>name</strong>.
                    </p>

                    <div class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-600">
                        Ejemplo de columnas:
                        <code class="font-semibold">phone | name</code>
                    </div>
                </div>

                <div class="rounded-xl bg-margarita-50 px-4 py-3 text-xs text-margarita-800 md:max-w-sm">
                    Si la plantilla tiene variables, puedes usar
                    <code class="font-semibold">{nombre}</code>,
                    <code class="font-semibold">{telefono}</code> y cualquier columna del archivo como
                    <code class="font-semibold">{columna:Pedido}</code>.
                </div>
            </div>

            <form
                action="/admin/campaigns/excel"
                method="POST"
                enctype="multipart/form-data"
                class="mt-6 grid gap-4 lg:grid-cols-[1fr_1fr_1fr_auto]"
            >
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Nombre de campaña
                    </label>

                    <input
                        name="name"
                        placeholder="Ej. Recordatorio julio Excel"
                        required
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Plantilla aprobada
                    </label>

                    <select
                        name="templateId"
                        required
                        data-template-select
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    >
                        <option value="">Selecciona plantilla</option>

                        <% templates.forEach((template) => { %>
                            <option
                                value="<%= template.id %>"
                                data-variable-count="<%= template.variableCount %>"
                                data-header-variable="<%= template.headerVariableCount %>"
                                data-url-variable="<%= template.urlVariableCount %>"
                            >
                                <%= template.name %> · <%= template.language %>
                            </option>
                        <% }) %>
                    </select>

                    <% if (templates.length === 0) { %>
                        <p class="mt-2 text-xs text-red-600">
                            No hay plantillas aprobadas. Sincroniza plantillas desde Meta.
                        </p>
                    <% } %>
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Excel / CSV
                    </label>

                    <input
                        type="file"
                        name="excel"
                        accept=".xlsx,.xls,.csv"
                        required
                        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />

                    <p class="mt-2 text-xs text-slate-500">
                        Acepta .xlsx, .xls o .csv.
                    </p>
                </div>

                <div class="lg:col-span-4">
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Programar para (opcional)
                    </label>

                    <input
                        type="datetime-local"
                        name="scheduledFor"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                    />

                    <p class="mt-1 text-xs text-slate-500">
                        Déjalo vacío para enviar ahora. Se usa la hora de la empresa.
                    </p>
                </div>

                <div class="flex items-end">
                    <button class="w-full rounded-xl bg-margarita-600 px-5 py-3 text-sm font-semibold text-white hover:bg-margarita-700">
                        Crear desde Excel
                    </button>
                </div>

                <div data-variable-fields class="hidden lg:col-span-4">
                    <%- include("../../../partials/campaign-variable-fields") %>
                </div>

                <%
                    /**
                     * Estructura del Excel para la plantilla elegida. Se llena
                     * con el script de abajo: la forma depende de la plantilla
                     * (variables del cuerpo, encabezado y botón).
                     */
                %>
                <div
                    data-example-panel
                    class="hidden rounded-xl bg-margarita-50 p-4 ring-1 ring-margarita-200 lg:col-span-4"
                >
                    <p class="text-sm font-bold text-margarita-900">
                        Tu Excel debe traer estas columnas
                    </p>

                    <p class="mt-1 font-mono text-xs text-margarita-800" data-example-columns></p>

                    <div class="mt-3 flex flex-wrap items-center gap-3">
                        <a
                            href="/admin/campaigns/example"
                            data-example-link
                            class="rounded-xl bg-margarita-600 px-4 py-2 text-sm font-bold text-white hover:bg-margarita-700"
                        >
                            Descargar ejemplo (.csv)
                        </a>

                        <span class="text-[11px] text-margarita-800">
                            Ya viene con los encabezados y una fila de ejemplo:
                            llénalo y súbelo tal cual.
                        </span>
                    </div>
                </div>
            </form>
        </section>

        <%
            /**
             * Campaña manual: primero a quién, después qué se le manda.
             *
             * Antes la plantilla iba arriba y los contactos abajo, así que en
             * el celular había que elegir el mensaje antes de ver a quién. El
             * orden del documento manda en pantalla pequeña, y el orden natural
             * es: nombre → contactos → plantilla.
             */
            const activeContacts = contacts.filter((contact) => !contact.optOutAt);
        %>

        <form action="/admin/campaigns" method="POST" class="grid gap-6 lg:grid-cols-[1fr_380px]">
            <section class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
                <div class="border-b border-slate-200 px-6 py-4">
                    <h2 class="font-bold text-slate-900">
                        Contactos
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Selecciona los destinatarios. Se muestran los contactos activos.
                    </p>

                    <% if (contacts.length > 0) { %>
                        <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                            <input
                                type="search"
                                data-contact-filter
                                placeholder="Filtrar por nombre o teléfono"
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                            />

                            <label class="flex shrink-0 items-center gap-2 rounded-xl bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-700">
                                <input
                                    type="checkbox"
                                    data-select-visible
                                    class="h-4 w-4 rounded border-slate-300"
                                />
                                Todos los visibles
                            </label>
                        </div>

                        <p class="mt-2 text-xs font-semibold text-margarita-800">
                            <span data-selected-count>0</span> seleccionado(s) ·
                            <%= activeContacts.length %> disponible(s)
                        </p>
                    <% } %>
                </div>

                <% if (contacts.length === 0) { %>
                    <div class="px-6 py-10 text-sm text-slate-500">
                        No hay contactos activos.
                    </div>
                <% } else { %>
                    <div class="max-h-[520px] divide-y divide-slate-100 overflow-y-auto" data-contact-list>
                        <% contacts.forEach((contact) => { %>
                            <label
                                class="flex cursor-pointer items-center gap-4 px-6 py-4 hover:bg-slate-50"
                                data-contact-row
                                data-search="<%= `${contact.customName || contact.profileName || ""} ${contact.phone}`.toLowerCase() %>"
                            >
                                <input
                                    type="checkbox"
                                    name="contactIds"
                                    value="<%= contact.id %>"
                                    class="h-4 w-4 rounded border-slate-300 text-margarita-600"
                                />

                                <div>
                                    <p class="font-semibold text-slate-900">
                                        <%= contact.customName || contact.profileName || contact.phone %>

                                        <% if (contact.optOutAt) { %>
                                            <span
                                                class="ml-1 rounded-full bg-red-50 px-2 py-0.5 text-[10px] font-bold text-red-700"
                                                title="Pidió la baja: se excluirá de la campaña"
                                            >
                                                BAJA · se excluye
                                            </span>
                                        <% } %>
                                    </p>

                                    <p class="text-sm text-slate-500">
                                        <%= contact.phone %>
                                    </p>
                                </div>
                            </label>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="space-y-5 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <div>
                    <h2 class="text-xl font-bold text-slate-900">
                        Crear manualmente
                    </h2>

                    <p class="mt-2 text-sm text-slate-600">
                        Primero eliges a quién; después, qué se le manda.
                    </p>
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Nombre de campaña
                    </label>

                    <input
                        name="name"
                        placeholder="Ej. Recordatorio de pago julio"
                        required
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Plantilla aprobada
                    </label>

                    <select
                        name="templateId"
                        required
                        data-template-select
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    >
                        <option value="">Selecciona plantilla</option>

                        <% templates.forEach((template) => { %>
                            <option
                                value="<%= template.id %>"
                                data-variable-count="<%= template.variableCount %>"
                                data-header-variable="<%= template.headerVariableCount %>"
                                data-url-variable="<%= template.urlVariableCount %>"
                            >
                                <%= template.name %> · <%= template.language %>
                            </option>
                        <% }) %>
                    </select>

                    <% if (templates.length === 0) { %>
                        <p class="mt-2 text-xs text-red-600">
                            No hay plantillas aprobadas. Sincroniza plantillas desde Meta.
                        </p>
                    <% } %>
                </div>

                <div data-variable-fields class="hidden">
                    <%- include("../../../partials/campaign-variable-fields") %>
                </div>

                <div class="rounded-xl bg-amber-50 px-4 py-3 text-xs text-amber-800">
                    Solo usa campañas para contactos que aceptaron recibir mensajes.
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Programar para (opcional)
                    </label>

                    <input
                        type="datetime-local"
                        name="scheduledFor"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                    />

                    <p class="mt-1 text-xs text-slate-500">
                        Déjalo vacío para enviar ahora. Se usa la hora de la empresa.
                    </p>
                </div>

                <button class="w-full rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                    Crear manualmente
                </button>
            </section>
        </form>
    </main>
</div>

<script>
    /**
     * Muestra solo las variables que necesita la plantilla elegida. Cada
     * opción trae su número en data-variable-count, así que el formulario
     * se ajusta sin recargar la página.
     */
    document.querySelectorAll("[data-template-select]").forEach((select) => {
        const form = select.closest("form");
        const container = form ? form.querySelector("[data-variable-fields]") : null;

        if (!container) {
            return;
        }

        const fields = Array.from(container.querySelectorAll("[data-variable-field]"));
        const headerField = container.querySelector("[data-header-field]");
        const headerInput = container.querySelector("[data-header-input]");
        const urlField = container.querySelector("[data-url-field]");
        const urlInput = container.querySelector("[data-url-input]");
        const examplePanel = form.querySelector("[data-example-panel]");
        const exampleColumns = form.querySelector("[data-example-columns]");
        const exampleLink = form.querySelector("[data-example-link]");

        /** Solo el formulario de Excel puede resolver {columna:…}. */
        const isExcelForm = (form.getAttribute("action") || "").endsWith("/excel");

        /**
         * Muestra u oculta un campo y, si no aplica, lo desactiva: un campo
         * desactivado no viaja en el formulario, que es justo lo que se busca
         * (Meta rechaza un componente que la plantilla no pide).
         */
        const toggle = (field, input, visible) => {
            if (!field || !input) {
                return;
            }

            field.classList.toggle("hidden", !visible);
            input.disabled = !visible;
            input.required = visible;
        };

        const sync = () => {
            const option = select.selectedOptions[0];
            const count = option ? Number(option.dataset.variableCount || 0) : 0;
            const header = option ? Number(option.dataset.headerVariable || 0) : 0;
            const url = option ? Number(option.dataset.urlVariable || 0) : 0;

            container.classList.toggle(
                "hidden",
                count === 0 && header === 0 && url === 0
            );

            fields.forEach((field, index) => {
                const visible = index < count;
                field.classList.toggle("hidden", !visible);

                const input = field.querySelector("input");

                if (input) {
                    input.required = visible;

                    if (!visible) {
                        input.value = "";
                    }
                }
            });

            toggle(headerField, headerInput, header > 0);
            toggle(urlField, urlInput, url > 0);

            /**
             * Estructura del archivo: teléfono, nombre y una columna por
             * variable. Se muestra al elegir la plantilla y el enlace apunta al
             * ejemplo de esa plantilla.
             */
            if (examplePanel && exampleColumns) {
                const columns = ["phone", "name"];

                for (let index = 1; index <= count; index++) {
                    columns.push(`var${index}`);
                }

                if (header > 0) {
                    columns.push("encabezado");
                }

                if (url > 0) {
                    columns.push("enlace");
                }

                exampleColumns.textContent = columns.join(" · ");
                examplePanel.classList.toggle("hidden", !select.value);

                if (exampleLink) {
                    exampleLink.href =
                        "/admin/campaigns/example?templateId=" +
                        encodeURIComponent(select.value);
                }
            }

            /**
             * Precarga la referencia a la columna si el campo está vacío: quien
             * baja el ejemplo solo tiene que llenarlo, no aprender la sintaxis.
             */
            if (isExcelForm) {
                fields.forEach((field, index) => {
                    const input = field.querySelector("input");

                    if (index < count && input && !input.value.trim()) {
                        input.value = `{columna:var${index + 1}}`;
                    }
                });

                if (header > 0 && headerInput && !headerInput.value.trim()) {
                    headerInput.value = "{columna:encabezado}";
                }

                if (url > 0 && urlInput && !urlInput.value.trim()) {
                    urlInput.value = "{columna:enlace}";
                }
            }
        };

        select.addEventListener("change", sync);
        sync();
    });

    /**
     * Campaña manual: filtro de contactos, «todos los visibles» y contador.
     * El contador evita el error clásico de crear una campaña sin destinatarios.
     */
    document.querySelectorAll("[data-contact-list]").forEach((list) => {
        const form = list.closest("form");
        const filter = form.querySelector("[data-contact-filter]");
        const selectAll = form.querySelector("[data-select-visible]");
        const counter = form.querySelector("[data-selected-count]");
        const rows = Array.from(list.querySelectorAll("[data-contact-row]"));

        const visibleRows = () =>
            rows.filter((row) => !row.classList.contains("hidden"));

        const updateCount = () => {
            if (!counter) {
                return;
            }

            counter.textContent = String(
                form.querySelectorAll('input[name="contactIds"]:checked').length
            );
        };

        if (filter) {
            filter.addEventListener("input", () => {
                const term = filter.value.trim().toLowerCase();

                rows.forEach((row) => {
                    row.classList.toggle(
                        "hidden",
                        term !== "" && !(row.dataset.search || "").includes(term)
                    );
                });

                if (selectAll) {
                    selectAll.checked = false;
                }
            });
        }

        if (selectAll) {
            selectAll.addEventListener("change", () => {
                visibleRows().forEach((row) => {
                    const box = row.querySelector('input[name="contactIds"]');

                    if (box) {
                        box.checked = selectAll.checked;
                    }
                });

                updateCount();
            });
        }

        form.addEventListener("change", (event) => {
            if (event.target.matches('input[name="contactIds"]')) {
                updateCount();
            }
        });

        updateCount();
    });
</script>

<%- include("../../../partials/footer") %>

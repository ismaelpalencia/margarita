<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar respuesta rápida | Margarita</title>
    <link rel="stylesheet" href="/css/style.css" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-3xl px-6 py-8">
        <section class="mb-6">
            <h2 class="text-2xl font-bold text-slate-800">
                Editar respuesta rápida
            </h2>

            <a href="/admin/quick-replies" class="mt-2 inline-block text-sm font-medium text-slate-500 hover:text-slate-700">
                ← Volver a la lista
            </a>
        </section>

        <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <% if (error) { %>
                <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/quick-replies/<%= quickReply.id %>" method="POST" class="space-y-5">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Título
                    </label>

                    <input
                        name="title"
                        value="<%= quickReply.title %>"
                        required
                        maxlength="60"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Texto
                    </label>

                    <textarea
                        name="body"
                        rows="5"
                        required
                        maxlength="2000"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"
                    ><%= quickReply.body %></textarea>

                    <p class="mt-2 text-xs text-slate-500">
                        <span class="font-mono">{nombre}</span> y
                        <span class="font-mono">{telefono}</span> se reemplazan con los datos del contacto.
                    </p>
                </div>

                <button class="w-full rounded-xl bg-emerald-600 px-4 py-3 font-semibold text-white hover:bg-emerald-700">
                    Guardar cambios
                </button>
            </form>
        </section>
    </main>
</body>
</html>

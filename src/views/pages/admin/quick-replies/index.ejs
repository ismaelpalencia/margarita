<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Respuestas rápidas | Margarita</title>
    <link rel="stylesheet" href="/css/style.css" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-6xl px-6 py-8">
        <section class="mb-6">
            <h2 class="text-2xl font-bold text-slate-800">
                Respuestas rápidas
            </h2>

            <p class="mt-1 max-w-3xl text-slate-500">
                Textos que el equipo inserta en la conversación con un clic.
                Puedes usar <span class="font-mono text-slate-600">{nombre}</span> y
                <span class="font-mono text-slate-600">{telefono}</span> y se
                reemplazan con los del contacto al momento de usarlas.
            </p>
        </section>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                Acción realizada correctamente.
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <%= error === "validation"
                    ? "Revisa el título y el texto: el título necesita 2 caracteres y el texto no puede quedar vacío."
                    : "No se pudo guardar la respuesta rápida." %>
            </div>
        <% } %>

        <section class="mb-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h3 class="text-lg font-bold text-slate-800">Nueva respuesta</h3>

            <form action="/admin/quick-replies" method="POST" class="mt-4 grid gap-4">
                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Título
                    </label>

                    <input
                        name="title"
                        required
                        maxlength="60"
                        placeholder="Por ejemplo: Saludo inicial"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">
                        Texto
                    </label>

                    <textarea
                        name="body"
                        rows="3"
                        required
                        maxlength="2000"
                        placeholder="Hola {nombre}, con gusto te ayudamos."
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    ></textarea>
                </div>

                <button class="justify-self-start rounded-xl bg-margarita-600 px-5 py-3 text-sm font-semibold text-white hover:bg-margarita-700">
                    Guardar respuesta
                </button>
            </form>
        </section>

        <section class="overflow-hidden rounded-2xl bg-white shadow">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-5 py-4">Título</th>
                        <th class="px-5 py-4">Texto</th>
                        <th class="px-5 py-4">Estado</th>
                        <th class="px-5 py-4 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    <% if (quickReplies.length === 0) { %>
                        <tr>
                            <td colspan="4" class="px-5 py-8 text-center text-slate-500">
                                Todavía no hay respuestas rápidas.
                            </td>
                        </tr>
                    <% } %>

                    <% quickReplies.forEach((quickReply) => { %>
                        <tr>
                            <td class="px-5 py-4 font-medium text-slate-800">
                                <%= quickReply.title %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <span class="line-clamp-2 max-w-md">
                                    <%= quickReply.body %>
                                </span>
                            </td>

                            <td class="px-5 py-4">
                                <span class="rounded-full px-3 py-1 text-xs font-semibold <%= quickReply.isActive ? 'bg-margarita-50 text-margarita-700' : 'bg-slate-100 text-slate-500' %>">
                                    <%= quickReply.isActive ? "Activa" : "Inactiva" %>
                                </span>
                            </td>

                            <td class="px-5 py-4">
                                <div class="flex justify-end gap-2">
                                    <a
                                        href="/admin/quick-replies/<%= quickReply.id %>/edit"
                                        class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200"
                                    >
                                        Editar
                                    </a>

                                    <form action="/admin/quick-replies/<%= quickReply.id %>/active" method="POST">
                                        <input
                                            type="hidden"
                                            name="isActive"
                                            value="<%= quickReply.isActive ? "false" : "true" %>"
                                        />

                                        <button class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-medium text-white">
                                            <%= quickReply.isActive ? "Desactivar" : "Activar" %>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>
</body>
</html>

<%- include("../../../partials/header", { title: "Estado del sistema - Admin" }) %>

<div class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-4 py-8">
        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-wide text-margarita-600">
                Producción
            </p>

            <h1 class="mt-1 text-3xl font-black text-slate-900">
                Estado del sistema
            </h1>

            <p class="mt-2 text-slate-600">
                Revisa si Margarita está lista para operar con WhatsApp Cloud API.
            </p>

            <p class="mt-2 text-xs text-slate-400">
                Versión <span class="font-semibold text-slate-500"><%= version %></span>
                <% if (commit) { %>
                    · commit <span class="font-mono text-slate-500"><%= commit %></span>
                <% } %>
            </p>
        </div>

        <section class="mb-8 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">WhatsApp</p>

                <p class="mt-2 text-lg font-black <%= status.checks.whatsappConfigured ? 'text-margarita-700' : 'text-red-700' %>">
                    <%= status.checks.whatsappConfigured ? "Configurado" : "Pendiente" %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">Plantillas aprobadas</p>

                <p class="mt-2 text-3xl font-black text-slate-900">
                    <%= status.approvedTemplates %>
                </p>

                <p class="mt-1 text-xs text-slate-400">
                    Total: <%= status.totalTemplates %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">Contactos activos</p>

                <p class="mt-2 text-3xl font-black text-slate-900">
                    <%= status.totalContacts %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">Agentes activos</p>

                <p class="mt-2 text-3xl font-black text-slate-900">
                    <%= status.activeAgents %>
                </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm text-slate-500">Workspace</p>

                <p class="mt-2 text-lg font-black <%= status.checks.workspaceReady ? 'text-margarita-700' : 'text-red-700' %>">
                    <%= status.workspace?.status || "Sin estado" %>
                </p>
            </div>
        </section>

        <section class="mb-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-center">
                <div>
                    <h2 class="text-xl font-black text-slate-900">
                        Webhook de Meta
                    </h2>

                    <p class="mt-2 text-sm text-slate-500">
                        Usa esta URL en Meta Developers para recibir mensajes y estados.
                    </p>
                </div>

                <a href="<%= status.webhookUrl %>" target="_blank" class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                    Probar URL
                </a>
            </div>

            <div class="mt-5 rounded-xl bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                    Callback URL
                </p>

                <p class="mt-2 break-all font-mono text-sm text-slate-800">
                    <%= status.webhookUrl %>
                </p>
            </div>

            <% if (status.whatsappAccount) { %>
                <div class="mt-5 grid gap-4 md:grid-cols-3">
                    <div class="rounded-xl border border-slate-200 p-4">
                        <p class="text-xs text-slate-500">Phone Number ID</p>
                        <p class="mt-1 break-all text-sm font-semibold text-slate-800">
                            <%= status.whatsappAccount.phoneNumberId %>
                        </p>
                    </div>

                    <div class="rounded-xl border border-slate-200 p-4">
                        <p class="text-xs text-slate-500">WABA ID</p>
                        <p class="mt-1 break-all text-sm font-semibold text-slate-800">
                            <%= status.whatsappAccount.businessAccountId %>
                        </p>
                    </div>

                    <div class="rounded-xl border border-slate-200 p-4">
                        <p class="text-xs text-slate-500">API Version</p>
                        <p class="mt-1 text-sm font-semibold text-slate-800">
                            <%= status.whatsappAccount.apiVersion %>
                        </p>
                    </div>
                </div>
            <% } else { %>
                <div class="mt-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                    No hay cuenta de WhatsApp configurada. Revisa variables de entorno y ejecuta seed.
                </div>
            <% } %>
        </section>

        <section class="mb-8 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h2 class="text-xl font-black text-slate-900">
                Seguridad y robustez
            </h2>

            <p class="mt-2 text-sm text-slate-500">
                Estado de las protecciones que se verifican en cada petición.
            </p>

            <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl p-4 ring-1 <%= status.hardening.credentialsEncrypted ? 'bg-margarita-50 ring-margarita-200' : 'bg-amber-50 ring-amber-200' %>">
                    <p class="text-sm font-bold <%= status.hardening.credentialsEncrypted ? 'text-margarita-800' : 'text-amber-800' %>">
                        Credenciales cifradas
                    </p>
                    <p class="mt-1 text-xs <%= status.hardening.credentialsEncrypted ? 'text-margarita-700' : 'text-amber-700' %>">
                        <% if (status.hardening.credentialsEncrypted) { %>
                            Los tokens de Meta están cifrados en la base de datos.
                        <% } else if (status.hardening.encryptionKeyConfigured) { %>
                            ENCRYPTION_KEY está configurada. Falta cifrar los tokens actuales desde la pantalla de WhatsApp.
                        <% } else { %>
                            Falta ENCRYPTION_KEY en las variables de entorno.
                        <% } %>
                    </p>
                </div>

                <%
                    const pendingPlaintext =
                        status.hardening.plaintextContacts +
                        status.hardening.plaintextMessages +
                        status.hardening.plaintextEmails;
                    const encryptionComplete =
                        pendingPlaintext === 0 &&
                        status.hardening.pendingPhoneHashes === 0 &&
                        status.hardening.pendingEmailHashes === 0;
                %>
                <div class="rounded-xl p-4 ring-1 <%= encryptionComplete ? 'bg-margarita-50 ring-margarita-200' : 'bg-amber-50 ring-amber-200' %>">
                    <p class="text-sm font-bold <%= encryptionComplete ? 'text-margarita-800' : 'text-amber-800' %>">
                        Cifrado en reposo
                    </p>
                    <p class="mt-1 text-xs <%= encryptionComplete ? 'text-margarita-700' : 'text-amber-700' %>">
                        <% if (encryptionComplete) { %>
                            Teléfonos, mensajes, notas, archivos, eventos de Meta, bitácora y los correos de acceso se guardan cifrados con AES-256-GCM.
                        <% } else { %>
                            Quedan <%= pendingPlaintext %> registro(s) guardados en claro de antes del cifrado<% if (status.hardening.pendingPhoneHashes > 0) { %>, <%= status.hardening.pendingPhoneHashes %> contacto(s) sin índice de teléfono<% } %><% if (status.hardening.pendingEmailHashes > 0) { %>, <%= status.hardening.pendingEmailHashes %> usuario(s) sin índice de correo<% } %>.
                            Ejecuta <span class="font-mono">npm run db:encrypt-data</span> para cifrarlos.
                        <% } %>
                    </p>
                </div>

                <%
                    const backup = status.hardening.backups;
                    const backupOk = Boolean(
                        backup && backup.enabled && !backup.stale
                    );
                %>
                <div class="rounded-xl p-4 ring-1 <%= backupOk ? 'bg-margarita-50 ring-margarita-200' : 'bg-amber-50 ring-amber-200' %>">
                    <p class="text-sm font-bold <%= backupOk ? 'text-margarita-800' : 'text-amber-800' %>">
                        Respaldos automáticos
                    </p>
                    <p class="mt-1 text-xs <%= backupOk ? 'text-margarita-700' : 'text-amber-700' %>">
                        <% if (!backup) { %>
                            No se pudo revisar el estado de los respaldos.
                        <% } else if (!backup.enabled) { %>
                            Están apagados (BACKUP_ENABLED=false).
                        <% } else if (backup.count === 0) { %>
                            Todavía no hay ninguna copia. Se creará sola en las próximas horas.
                        <% } else if (backup.stale) { %>
                            La última copia tiene <%= Math.round(backup.ageHours || 0) %> h (el límite es <%= backup.maxAgeHours %> h). Revisa la bitácora: el respaldo está fallando.
                        <% } else { %>
                            <%= backup.count %> copia(s), la última hace <%= Math.round(backup.ageHours || 0) %> h. Se conservan <%= backup.keep %>.
                        <% } %>
                    </p>
                </div>

                <div class="rounded-xl p-4 ring-1 <%= status.hardening.webhookSignatureConfigured ? 'bg-margarita-50 ring-margarita-200' : 'bg-amber-50 ring-amber-200' %>">
                    <p class="text-sm font-bold <%= status.hardening.webhookSignatureConfigured ? 'text-margarita-800' : 'text-amber-800' %>">
                        Firma del webhook
                    </p>
                    <p class="mt-1 text-xs <%= status.hardening.webhookSignatureConfigured ? 'text-margarita-700' : 'text-amber-700' %>">
                        <% if (status.hardening.webhookSignatureConfigured) { %>
                            Cada webhook se valida con X-Hub-Signature-256.
                        <% } else { %>
                            Falta META_APP_SECRET. En producción el webhook responde 401.
                        <% } %>
                    </p>
                </div>

                <div class="rounded-xl p-4 ring-1 <%= status.checks.webhookHealthy ? 'bg-margarita-50 ring-margarita-200' : 'bg-red-50 ring-red-200' %>">
                    <p class="text-sm font-bold <%= status.checks.webhookHealthy ? 'text-margarita-800' : 'text-red-800' %>">
                        Cola de webhooks
                    </p>
                    <p class="mt-1 text-xs <%= status.checks.webhookHealthy ? 'text-margarita-700' : 'text-red-700' %>">
                        <% if (status.hardening.webhookQueueEnabled) { %>
                            Activa. Pendientes: <%= status.pendingWebhookEvents %>.
                            Fallidos: <%= status.failedWebhookEvents %>.
                        <% } else { %>
                            Deshabilitada: los webhooks se procesan en línea.
                        <% } %>
                    </p>
                </div>

                <div class="rounded-xl p-4 ring-1 <%= status.hardening.alertsConfigured ? 'bg-margarita-50 ring-margarita-200' : 'bg-slate-50 ring-slate-200' %>">
                    <p class="text-sm font-bold <%= status.hardening.alertsConfigured ? 'text-margarita-800' : 'text-slate-700' %>">
                        Alertas externas
                    </p>
                    <p class="mt-1 text-xs <%= status.hardening.alertsConfigured ? 'text-margarita-700' : 'text-slate-500' %>">
                        <% if (status.hardening.alertsConfigured) { %>
                            Los errores se envían a ALERT_WEBHOOK_URL.
                        <% } else { %>
                            Opcional: define ALERT_WEBHOOK_URL para recibir avisos de error.
                        <% } %>
                    </p>
                </div>

                <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                    <p class="text-sm font-bold text-slate-700">
                        Bloqueo por intentos fallidos
                    </p>
                    <p class="mt-1 text-xs text-slate-500">
                        La cuenta se bloquea <%= status.hardening.loginLockMinutes %>
                        minuto(s) tras <%= status.hardening.loginMaxAttempts %>
                        intentos fallidos.
                    </p>
                </div>

                <%
                    const twoFactor = status.hardening.twoFactor;
                    const adminsCovered =
                        twoFactor.admins > 0 && twoFactor.adminsEnabled === twoFactor.admins;
                %>
                <div class="rounded-xl p-4 ring-1 <%= twoFactor.enabled > 0 ? 'bg-margarita-50 ring-margarita-200' : 'bg-amber-50 ring-amber-200' %>">
                    <p class="text-sm font-bold <%= twoFactor.enabled > 0 ? 'text-margarita-800' : 'text-amber-800' %>">
                        Verificación en dos pasos
                    </p>
                    <p class="mt-1 text-xs <%= twoFactor.enabled > 0 ? 'text-margarita-700' : 'text-amber-700' %>">
                        <% if (twoFactor.enabled === 0) { %>
                            Ninguna cuenta la usa todavía. Se activa desde
                            <a href="/account/security" class="font-semibold underline">Mi cuenta → Seguridad</a>.
                        <% } else if (adminsCovered) { %>
                            <%= twoFactor.enabled %> cuenta(s) la usan y
                            todos los administradores están cubiertos.
                        <% } else { %>
                            <%= twoFactor.enabled %> cuenta(s) la usan, pero solo
                            <%= twoFactor.adminsEnabled %> de <%= twoFactor.admins %>
                            administrador(es) la tienen activada.
                        <% } %>
                    </p>
                </div>

                <div class="rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
                    <p class="text-sm font-bold text-slate-700">
                        Retención de datos
                    </p>
                    <p class="mt-1 text-xs text-slate-500">
                        Logs: <%= status.hardening.logRetentionDays %> días.
                        Eventos de webhook: <%= status.hardening.webhookEventRetentionDays %> días.
                    </p>
                </div>
            </div>
        </section>

        <section class="mb-8 grid gap-6 lg:grid-cols-2">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <h2 class="text-xl font-black text-slate-900">
                    Últimos logs Webhook
                </h2>

                <div class="mt-5 space-y-3">
                    <% if (status.recentWebhookLogs.length === 0) { %>
                        <p class="text-sm text-slate-500">
                            Todavía no hay logs de webhook.
                        </p>
                    <% } %>

                    <% status.recentWebhookLogs.forEach((log) => { %>
                        <div class="rounded-xl bg-slate-50 p-4">
                            <div class="flex justify-between gap-4">
                                <p class="text-sm font-bold text-slate-800">
                                    <%= log.action %>
                                </p>

                                <span class="text-xs font-semibold text-slate-400">
                                    <%= log.level %>
                                </span>
                            </div>

                            <p class="mt-1 text-sm text-slate-500">
                                <%= log.message %>
                            </p>

                            <p class="mt-2 text-xs text-slate-400">
                                <%= formatDateTimeMX(log.createdAt) %>
                            </p>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <h2 class="text-xl font-black text-slate-900">
                    Últimos logs Meta
                </h2>

                <div class="mt-5 space-y-3">
                    <% if (status.recentMetaLogs.length === 0) { %>
                        <p class="text-sm text-slate-500">
                            Todavía no hay logs de Meta.
                        </p>
                    <% } %>

                    <% status.recentMetaLogs.forEach((log) => { %>
                        <div class="rounded-xl bg-slate-50 p-4">
                            <div class="flex justify-between gap-4">
                                <p class="text-sm font-bold text-slate-800">
                                    <%= log.action %>
                                </p>

                                <span class="text-xs font-semibold text-slate-400">
                                    <%= log.level %>
                                </span>
                            </div>

                            <p class="mt-1 text-sm text-slate-500">
                                <%= log.message %>
                            </p>

                            <p class="mt-2 text-xs text-slate-400">
                                <%= formatDateTimeMX(log.createdAt) %>
                            </p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>

        <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h2 class="text-xl font-black text-slate-900">
                Errores recientes
            </h2>

            <div class="mt-5 space-y-3">
                <% if (status.recentErrors.length === 0) { %>
                    <div class="rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                        No hay errores recientes.
                    </div>
                <% } %>

                <% status.recentErrors.forEach((log) => { %>
                    <div class="rounded-xl bg-red-50 p-4">
                        <div class="flex justify-between gap-4">
                            <p class="text-sm font-bold text-red-800">
                                <%= log.action %>
                            </p>

                            <span class="text-xs font-semibold text-red-500">
                                <%= log.level %>
                            </span>
                        </div>

                        <p class="mt-1 text-sm text-red-700">
                            <%= log.message %>
                        </p>

                        <p class="mt-2 text-xs text-red-400">
                            <%= formatDateTimeMX(log.createdAt) %>
                        </p>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>
</div>

<%- include("../../../partials/footer") %>

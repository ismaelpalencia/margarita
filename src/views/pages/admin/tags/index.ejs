<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Etiquetas | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-6 py-8">
        <section class="mb-6 flex items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl font-bold text-slate-800">Etiquetas</h2>
                <p class="mt-1 text-slate-500">
                    Organiza contactos para operación y campañas.
                </p>
            </div>

            <a
                href="/admin/tags/new"
                class="rounded-xl bg-margarita-600 px-4 py-3 text-sm font-semibold text-white hover:bg-margarita-700"
            >
                Nueva etiqueta
            </a>
        </section>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                Acción realizada correctamente.
            </div>
        <% } %>

        <section class="overflow-x-auto rounded-2xl bg-white shadow">
            <table class="w-full text-left text-sm tabla-etiquetas">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <th class="px-5 py-4">Etiqueta</th>
                        <th class="px-5 py-4">Color</th>
                        <th class="px-5 py-4">Creada</th>
                        <th class="px-5 py-4 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    <% if (tags.length === 0) { %>
                        <tr>
                            <td colspan="4" class="px-5 py-8 text-center text-slate-500">
                                Todavía no hay etiquetas creadas.
                            </td>
                        </tr>
                    <% } %>

                    <% tags.forEach((tag) => { %>
                        <tr>
                            <td class="px-5 py-4">
                                <span
                                    class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold text-white"
                                    style="background-color: <%= tag.color || '#1fa06a' %>;"
                                >
                                    <%= tag.name %>
                                </span>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <%= tag.color || "—" %>
                            </td>

                            <td class="px-5 py-4 text-slate-600">
                                <%= formatDateTimeMX(tag.createdAt) %>
                            </td>

                            <td class="px-5 py-4">
                                <div class="flex justify-end gap-2">
                                    <a
                                        href="/admin/tags/<%= tag.id %>/edit"
                                        class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200"
                                    >
                                        Editar
                                    </a>

                                    <form
                                        action="/admin/tags/<%= tag.id %>/deactivate"
                                        method="POST"
                                        onsubmit="return confirm('¿Desactivar esta etiqueta?');"
                                    >
                                        <button class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-medium text-white">
                                            Desactivar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>
</body>
</html>

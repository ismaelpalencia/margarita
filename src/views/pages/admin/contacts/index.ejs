<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contactos | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-6 py-8">
        <section class="mb-6 flex items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl font-bold text-slate-800">Contactos</h2>
                <p class="mt-1 text-slate-500">
                    Administra los números que se comunicarán por WhatsApp.
                </p>
            </div>

            <a
                href="/admin/contacts/new"
                class="rounded-xl bg-margarita-600 px-4 py-3 text-sm font-semibold text-white hover:bg-margarita-700"
            >
                Nuevo contacto
            </a>
        </section>

        <form action="/admin/contacts" method="GET" class="mb-4 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <div>
                <input
                    name="search"
                    value="<%= search %>"
                    placeholder="Buscar por nombre o teléfono"
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                />

                <p class="mt-1 text-xs text-slate-400">
                    El teléfono se busca completo: 10 dígitos en México o con +
                    y lada para otro país. Está cifrado en la base.
                </p>
            </div>

            <select
                name="tagId"
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            >
                <option value="">Todas las etiquetas</option>

                <% tags.forEach((tag) => { %>
                    <option value="<%= tag.id %>" <% if (tagId === tag.id) { %> selected <% } %>>
                        <%= tag.name %>
                    </option>
                <% }) %>
            </select>

            <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
            <select
                name="resultado"
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            >
                <option value="">Todos los resultados</option>

                <% outcomeTypes.forEach((type) => { %>
                    <option value="<%= type %>" <% if (outcomeType === type) { %> selected <% } %>>
                        <%= outcomeLabels[type] %>
                    </option>
                <% }) %>
            </select>
            <% } %>

            <input
                type="number"
                name="intentos"
                min="1"
                value="<%= minAttempts %>"
                placeholder="Intentos sin respuesta ≥"
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            />

            <button class="h-fit rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white self-start">
                Buscar
            </button>

            <div class="flex flex-wrap items-center gap-3 md:col-span-2 lg:col-span-2">
                <label class="flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
                    <input
                        type="checkbox"
                        name="bajas"
                        value="1"
                        class="h-4 w-4 rounded border-slate-300"
                        <% if (onlyOptedOut) { %> checked <% } %>
                    />

                    Solo bajas
                </label>

                <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
                <label class="flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
                    <input
                        type="checkbox"
                        name="vencidas"
                        value="1"
                        class="h-4 w-4 rounded border-slate-300"
                        <% if (overdueOnly) { %> checked <% } %>
                    />

                    Promesas vencidas
                </label>

                <label class="flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
                    <input
                        type="checkbox"
                        name="sinResultado"
                        value="1"
                        class="h-4 w-4 rounded border-slate-300"
                        <% if (withoutOutcomeOnly) { %> checked <% } %>
                    />

                    Sin resultado
                </label>
                <% } %>

                <label class="flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
                    <input
                        type="checkbox"
                        name="nuncaRespondio"
                        value="1"
                        class="h-4 w-4 rounded border-slate-300"
                        <% if (neverAnsweredOnly) { %> checked <% } %>
                    />

                    Nunca respondió
                </label>
            </div>

            <% if (search || tagId || onlyOptedOut || outcomeType || overdueOnly || withoutOutcomeOnly || neverAnsweredOnly || minAttempts) { %>
                <a href="/admin/contacts" class="rounded-xl bg-slate-100 px-5 py-3 text-center text-sm font-semibold text-slate-700">
                    Limpiar
                </a>
            <% } %>
        </form>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                Acción realizada correctamente.
            </div>
        <% } %>

        <%
            /**
             * El marcado en bloque se manda como un formulario aparte: los
             * checkboxes de la tabla lo referencian con `form=`, porque
             * meter la tabla dentro de un form anidaría los formularios que
             * ya tiene cada fila (abrir conversación, desactivar…).
             *
             * Solo existe con el módulo de cobranza encendido.
             */
        %>
        <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
        <form
            id="bulk-outcomes"
            action="/admin/contacts/outcomes/bulk"
            method="POST"
            class="mb-4 flex flex-wrap items-end gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200"
        >
            <input type="hidden" name="redirectTo" value="<%= currentPath %>" />

            <label class="block">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Marcar seleccionados como
                </span>

                <select
                    name="type"
                    required
                    class="mt-1 rounded-xl border border-slate-300 px-3 py-2 text-sm"
                >
                    <option value="">Resultado…</option>

                    <% outcomeTypes.forEach((type) => { %>
                        <option value="<%= type %>"><%= outcomeLabels[type] %></option>
                    <% }) %>
                </select>
            </label>

            <label class="block">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Monto (opcional)
                </span>

                <input
                    name="amount"
                    inputmode="decimal"
                    placeholder="1250.00"
                    class="mt-1 w-32 rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />
            </label>

            <label class="block">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Fecha compromiso (promesa/convenio)
                </span>

                <input
                    type="date"
                    name="dueDate"
                    class="mt-1 rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />
            </label>

            <label class="block flex-1">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Nota (opcional)
                </span>

                <input
                    name="note"
                    class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />
            </label>

            <button class="rounded-xl bg-margarita-600 px-5 py-2 text-sm font-semibold text-white hover:bg-margarita-700">
                Aplicar a los seleccionados
            </button>
        </form>
        <% } %>

        <section class="overflow-x-auto rounded-2xl bg-white shadow">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500">
                    <tr>
                        <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
                        <th class="px-3 py-4 md:px-5">
                            <span class="sr-only">Seleccionar</span>
                        </th>
                        <% } %>
                        <th class="px-3 py-4 md:px-5">Nombre</th>
                        <th class="hidden px-3 py-4 md:table-cell md:px-5">Teléfono</th>
                        <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
                        <th class="px-3 py-4 md:px-5">Resultado</th>
                        <% } %>
                        <th class="hidden px-3 py-4 md:table-cell md:px-5">Intentos</th>
                        <th class="hidden px-3 py-4 md:table-cell md:px-5">Etiquetas</th>
                        <th class="hidden px-3 py-4 md:table-cell md:px-5">Notas</th>
                        <th class="px-3 py-4 md:px-5 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100">
                    <% if (contacts.length === 0) { %>
                        <tr>
                            <td colspan="<%= (typeof collectionsEnabled === "undefined" || collectionsEnabled) ? 8 : 6 %>" class="px-5 py-8 text-center text-slate-500">
                                No hay contactos para mostrar.
                            </td>
                        </tr>
                    <% } %>

                    <% contacts.forEach((contact) => { %>
                        <%
                            const contactAttempts = attempts.get(contact.id) || {
                                attempts: 0,
                                hasInbound: false
                            };
                            const late = daysLate(contact);
                        %>
                        <tr>
                            <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
                            <td class="px-3 py-4 md:px-5">
                                <input
                                    type="checkbox"
                                    name="contactIds"
                                    value="<%= contact.id %>"
                                    form="bulk-outcomes"
                                    class="h-4 w-4 rounded border-slate-300"
                                />
                            </td>
                            <% } %>

                            <td class="px-3 py-4 md:px-5">
                                <div class="flex items-center gap-2">
                                    <a href="/admin/contacts/<%= contact.id %>/edit" class="font-medium text-slate-800 underline-offset-2 hover:text-margarita-700 hover:underline">
                                        <%= contact.customName || contact.profileName || contact.phone %>
                                    </a>

                                    <% if (contact.optOutAt) { %>
                                        <span
                                            class="rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-bold text-red-700"
                                            title="Pidió la baja: no se le envían mensajes"
                                        >
                                            BAJA
                                        </span>
                                    <% } else if (contact.pausedAt) { %>
                                        <span
                                            class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-800"
                                            title="<%= contact.pausedReason || 'En pausa: no se le escribe' %>"
                                        >
                                            pausa
                                        </span>
                                        <% if (!contact.optInAt) { %>
                                            <span
                                                class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700"
                                                title="No hay consentimiento registrado"
                                            >
                                                sin opt-in
                                            </span>
                                        <% } %>
                                    <% } else if (!contact.optInAt) { %>
                                        <span
                                            class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700"
                                            title="No hay consentimiento registrado"
                                        >
                                            sin opt-in
                                        </span>
                                    <% } %>
                                </div>
                            </td>

                            <td class="hidden px-5 py-4 text-slate-600 md:table-cell">
                                <%= contact.phone %>
                            </td>

                            <% if (typeof collectionsEnabled === "undefined" || collectionsEnabled) { %>
                            <td class="px-3 py-4 md:px-5">
                                <% if (contact.outcomeType) { %>
                                    <span class="rounded-full px-2 py-0.5 text-[11px] font-bold <%= outcomeBadgeClasses[contact.outcomeType] %>">
                                        <%= outcomeLabels[contact.outcomeType] %>
                                    </span>

                                    <% if (late > 0) { %>
                                        <span class="ml-1 rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-bold text-red-700">
                                            <%= late %> d
                                        </span>
                                    <% } %>

                                    <% if (contact.outcomeAmount) { %>
                                        <div class="mt-1 text-xs text-slate-500">
                                            <%= formatAmount(Number(contact.outcomeAmount)) %>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <span class="text-slate-400">—</span>
                                <% } %>
                            </td>
                            <% } %>

                            <td class="hidden px-5 py-4 text-slate-600 md:table-cell">
                                <span class="<%= contactAttempts.attempts >= 3 ? 'font-bold text-amber-700' : '' %>">
                                    <%= contactAttempts.attempts %>
                                </span>

                                <% if (!contactAttempts.hasInbound && contactAttempts.attempts > 0) { %>
                                    <div class="text-[11px] text-amber-700">
                                        nunca respondió
                                    </div>
                                <% } %>
                            </td>

                            <td class="hidden px-3 py-4 md:table-cell md:px-5">
                                <div class="flex flex-wrap gap-1">
                                    <% if (contact.tags.length === 0) { %>
                                        <span class="text-slate-400">—</span>
                                    <% } %>

                                    <% contact.tags.forEach((contactTag) => { %>
                                        <span
                                            class="rounded-full px-2 py-1 text-xs font-semibold text-white"
                                            style="background-color: <%= contactTag.tag.color || '#1fa06a' %>;"
                                        >
                                            <%= contactTag.tag.name %>
                                        </span>
                                    <% }) %>
                                </div>
                            </td>

                            <td class="hidden px-5 py-4 text-slate-600 md:table-cell">
                                <%= contact.notes || "—" %>
                            </td>

                            <td class="px-3 py-4 md:px-5">
                                <div class="flex flex-wrap justify-end gap-2">
                                    <form action="/admin/conversations/from-contact/<%= contact.id %>" method="POST">
                                        <button class="rounded-lg bg-margarita-600 px-3 py-2 text-xs font-medium text-white hover:bg-margarita-700">
                                            <span class="md:hidden">Abrir</span>
                                            <span class="hidden md:inline">Abrir conversación</span>
                                        </button>
                                    </form>

                                    <a
                                        href="/admin/contacts/<%= contact.id %>/edit"
                                        class="hidden rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-200 md:inline-flex"
                                    >
                                        Editar
                                    </a>

                                    <form
                                        action="/admin/contacts/<%= contact.id %>/deactivate"
                                        method="POST"
                                        onsubmit="return confirm('¿Desactivar este contacto?');"
                                        class="hidden md:block"
                                    >
                                        <button class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-medium text-white">
                                            Desactivar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </section>
    </main>
</body>
</html>

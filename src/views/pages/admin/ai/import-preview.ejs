<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Revisar importación | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />
    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
        <div class="mb-6">
            <a href="/admin/ai/import" class="text-sm font-semibold text-slate-500">← Volver a importaciones</a>
            <h2 class="mt-2 text-2xl font-bold text-slate-800">Revisar lo que entendió la IA</h2>
            <p class="mt-1 text-sm text-slate-500">
                Este borrador queda guardado. Puedes editarlo o aplicarlo cuando esté listo.
            </p>
            <% if (typeof success !== "undefined" && success === "saved") { %>
                <div class="mt-3 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
                    Borrador guardado.
                </div>
            <% } %>
        </div>

        <section class="card mb-5">
            <div class="grid gap-3 sm:grid-cols-4">
                <div class="rounded-xl bg-slate-50 p-4">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Negocio</p>
                    <p class="mt-1 font-semibold text-slate-900"><%= data.business.name || "Sin nombre" %></p>
                    <p class="mt-1 text-xs text-slate-500"><%= data.business.tone || "Tono no especificado" %></p>
                </div>
                <div class="rounded-xl bg-slate-50 p-4">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Conocimiento</p>
                    <p class="mt-1 text-2xl font-black text-slate-900"><%= data.knowledge.length %></p>
                    <p class="text-xs text-slate-500">entradas propuestas</p>
                </div>
                <div class="rounded-xl bg-slate-50 p-4">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Flujos</p>
                    <p class="mt-1 text-2xl font-black text-slate-900"><%= data.flows.length %></p>
                    <p class="text-xs text-slate-500">respuestas automáticas</p>
                </div>
                <div class="rounded-xl bg-slate-50 p-4">
                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Guiados</p>
                    <p class="mt-1 text-2xl font-black text-slate-900"><%= data.guidedFlows.length %></p>
                    <p class="text-xs text-slate-500">borradores</p>
                </div>
            </div>

            <% if (data.business.description) { %>
                <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-600"><%= data.business.description %></p>
            <% } %>
        </section>

        <section class="card mb-5">
            <h3 class="font-bold text-slate-800">Base de conocimiento</h3>
            <div class="mt-3 space-y-3">
                <% data.knowledge.forEach((entry) => { %>
                    <article class="rounded-xl border border-slate-200 p-4">
                        <p class="font-semibold text-slate-800"><%= entry.question %></p>
                        <p class="mt-1 whitespace-pre-wrap text-sm text-slate-600"><%= entry.answer %></p>
                        <% if (entry.buttons && entry.buttons.length > 0) { %>
                            <p class="mt-2 text-xs text-slate-500">
                                Botones:
                                <% entry.buttons.forEach((button) => { %>
                                    <span class="ml-1 rounded-full bg-margarita-50 px-2 py-0.5 font-semibold text-margarita-700"><%= button.title %></span>
                                <% }) %>
                            </p>
                        <% } %>
                    </article>
                <% }) %>
            </div>
        </section>

        <% if (data.flows.length > 0) { %>
            <section class="card mb-5">
                <h3 class="font-bold text-slate-800">Flujos</h3>
                <div class="mt-3 space-y-3">
                    <% data.flows.forEach((flow) => { %>
                        <article class="rounded-xl border border-slate-200 p-4">
                            <p class="font-semibold text-slate-800"><%= flow.name %></p>
                            <p class="mt-1 text-xs text-slate-500">Dispara con: <%= flow.trigger %></p>
                            <p class="mt-2 whitespace-pre-wrap text-sm text-slate-600"><%= flow.reply %></p>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } %>

        <% if (data.guidedFlows.length > 0) { %>
            <section class="card mb-5">
                <h3 class="font-bold text-slate-800">Flujos guiados propuestos</h3>
                <p class="mt-1 text-xs text-slate-500">
                    Se crearán como borrador. Revísalos en Flujos guiados después de aplicar.
                </p>
                <div class="mt-3 space-y-3">
                    <% data.guidedFlows.forEach((flow) => { %>
                        <article class="rounded-xl border border-slate-200 p-4">
                            <p class="font-semibold text-slate-800"><%= flow.name %></p>
                            <p class="mt-1 text-xs text-slate-500">Dispara con: <%= flow.trigger %></p>
                            <p class="mt-1 text-xs text-slate-600"><%= flow.steps.length %> pasos</p>
                            <% if (flow.summary) { %>
                                <p class="mt-2 text-sm text-slate-600"><%= flow.summary %></p>
                            <% } %>
                            <% if (flow.missing.length > 0) { %>
                                <p class="mt-2 text-xs text-amber-800"><strong>Falta:</strong> <%= flow.missing.join(" · ") %></p>
                            <% } %>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } %>

        <% if (data.handoffKeywords.length > 0) { %>
            <section class="card mb-5">
                <h3 class="font-bold text-slate-800">Palabras que pasan a una persona</h3>
                <p class="mt-2 text-sm text-slate-600"><%= data.handoffKeywords.join(" · ") %></p>
            </section>
        <% } %>

        <section class="card">
            <p class="text-sm text-slate-600">
                <strong>Aplicar y sumar:</strong> crea entradas y flujos nuevos; lo que ya existe no se sobrescribe.
                <strong>Aplicar y reemplazar:</strong> desactiva el conocimiento y los flujos actuales del workspace
                y deja activos solo los de este borrador. Los datos anteriores no se borran, solo se desactivan.
                En ambos casos, los interruptores globales y por número siguen mandando.
                Los flujos con botones o listas se crean <strong>apagados</strong> porque sus
                botones no definen destinos; un flujo de texto simple sí se activa.
            </p>

            <div class="mt-4 flex flex-wrap gap-3">
                <form action="/admin/ai/import/<%= importId %>/apply" method="POST" class="flex flex-wrap gap-3">
                    <button name="mode" value="merge" class="btn btn--primary">Aplicar y sumar</button>
                    <button
                        name="mode"
                        value="replace"
                        class="btn btn--danger"
                        onclick="return confirm('Esto desactiva todo el conocimiento y los flujos actuales del workspace, y deja activos solo los de este borrador. No se borran los datos. ¿Continuar?');"
                    >
                        Aplicar y reemplazar
                    </button>
                </form>
                <a href="/admin/ai/import/<%= importId %>/edit" class="btn btn--secondary">Editar borrador</a>
                <a href="/admin/ai/import" class="btn btn--secondary">Volver a importaciones</a>
            </div>
        </section>
    </main>
</body>
</html>

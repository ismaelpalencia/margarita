<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Importar negocio | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />
    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
        <div class="mb-6">
            <a href="/admin/ai" class="text-sm font-semibold text-slate-500">← IA</a>
            <h2 class="mt-2 text-2xl font-bold text-slate-800">Importar negocio con IA</h2>
            <p class="mt-1 max-w-3xl text-sm text-slate-500">
                Pega la información del negocio (servicios, precios, horarios, preguntas frecuentes,
                tono, proceso de venta) o sube un archivo de texto. La IA la convierte en una
                propuesta de base de conocimiento y flujos; tú la revisas antes de aplicarla.
            </p>
        </div>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <%= error === "apply" ? "No se pudo aplicar la importación. Vuelve a generarla." : error %>
            </div>
        <% } %>

        <form action="/admin/ai/import" method="POST" class="space-y-5">
            <section class="card">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <label for="source" class="text-sm font-bold text-slate-800">Documento del negocio</label>
                    <label class="cursor-pointer text-xs font-semibold text-slate-500">
                        Subir .txt / .md / .csv / .json
                        <input id="source-file" type="file" accept=".txt,.md,.csv,.json,text/plain" class="hidden" />
                    </label>
                </div>

                <textarea
                    id="source"
                    name="source"
                    rows="14"
                    maxlength="30000"
                    required
                    class="input mt-2"
                    placeholder="Ejemplo: Somos una clínica dental en CDMX. Atendemos de lunes a sábado..."
                ><%= source %></textarea>

                <p class="mt-2 text-xs text-slate-500">
                    <span id="source-count">0</span> / 30,000 caracteres. No se guarda el documento:
                    solo el JSON validado que revisarás después.
                </p>
            </section>

            <section class="card">
                <label for="instructions" class="text-sm font-bold text-slate-800">Instrucciones para la IA (opcional)</label>
                <textarea
                    id="instructions"
                    name="instructions"
                    rows="4"
                    maxlength="2000"
                    class="input mt-2"
                    placeholder="Ejemplo: genera 25 preguntas frecuentes, tono cercano, incluye flujos para agendar y pedir cotización."
                ><%= instructions %></textarea>
                <p class="mt-2 text-xs text-slate-500">
                    No inventes datos que no estén en el documento. Si falta un precio u horario, omítelo.
                </p>
            </section>

            <div class="flex flex-wrap items-center gap-3">
                <button class="btn btn--primary">Analizar con IA</button>
                <a href="/admin/ai" class="btn btn--secondary">Cancelar</a>
                <span class="text-xs text-slate-500">La IA puede tardar unos segundos.</span>
            </div>
        </form>
    </main>

    <script>
        (function () {
            var source = document.getElementById("source");
            var count = document.getElementById("source-count");
            var file = document.getElementById("source-file");

            function refresh() {
                if (source && count) {
                    count.textContent = String(source.value.length);
                }
            }

            source.addEventListener("input", refresh);
            refresh();

            if (file) {
                file.addEventListener("change", function () {
                    var selected = file.files && file.files[0];

                    if (!selected) {
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function () {
                        source.value = String(reader.result || "").slice(0, 30000);
                        refresh();
                    };
                    reader.readAsText(selected);
                });
            }
        })();
    </script>
</body>
</html>

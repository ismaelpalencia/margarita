<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editar flujo | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />
    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <%- include("../../../partials/admin-nav", { user }) %>

    <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
        <div class="mb-6">
            <a href="/admin/ai/package" class="text-sm font-semibold text-slate-500">← Paquete inicial</a>
            <h2 class="mt-2 text-2xl font-bold text-slate-800">Editar flujo</h2>
            <p class="mt-1 text-sm text-slate-500">
                <strong><%= flow.name %></strong> · <%= flow.slug %>.
                El trigger admite varias palabras separadas por <code>|</code>.
            </p>
        </div>

        <% if (success === "saved") { %>
            <div class="mb-5 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">
                Flujo guardado.
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <% if (error === "empty") { %>
                    El trigger y la respuesta no pueden quedar vacíos.
                <% } else if (error === "title") { %>
                    Un botón pasa de 20 caracteres; WhatsApp lo rechazaría.
                <% } else if (error === "count") { %>
                    WhatsApp permite hasta 3 botones.
                <% } else if (error === "duplicate") { %>
                    Dos botones tienen el mismo identificador.
                <% } else { %>
                    No se pudo guardar el flujo.
                <% } %>
            </div>
        <% } %>

        <form action="/admin/ai/flows/<%= flow.id %>" method="POST" class="space-y-5">
            <section class="card">
                <label class="block text-sm font-bold text-slate-800">Dispara cuando el mensaje contiene</label>
                <input
                    name="trigger"
                    value="<%= flow.trigger %>"
                    class="input mt-2"
                    placeholder="hola|buenos dias|buenas tardes"
                />
                <p class="mt-2 text-xs text-slate-500">
                    Separa alternativas con <code>|</code>. Se compara sin acentos y en minúsculas.
                </p>
            </section>

            <section class="card">
                <label class="block text-sm font-bold text-slate-800">Respuesta</label>
                <textarea
                    name="reply"
                    rows="5"
                    class="input mt-2"
                    placeholder="¡Hola! ¿En qué te ayudamos?"
                ><%= flow.reply %></textarea>
            </section>

            <% if (isList) { %>
                <section class="card">
                    <p class="text-sm font-semibold text-slate-700">Este flujo usa una lista</p>
                    <p class="mt-1 text-xs text-slate-500">
                        Aquí puedes cambiar el trigger y el texto. Las opciones de la lista se conservan.
                    </p>
                </section>
            <% } else { %>
                <section class="card">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-sm font-bold text-slate-800">Botones (máx. 3, título de 20)</p>
                        <label class="flex items-center gap-2 text-xs text-slate-600">
                            <input type="checkbox" name="removeButtons" value="true" class="h-4 w-4" />
                            Quitar botones y responder solo texto
                        </label>
                    </div>

                    <div class="mt-3 space-y-3">
                        <% for (let index = 0; index < 3; index += 1) { %>
                            <% const button = buttons[index] || null; %>
                            <div class="grid gap-2 sm:grid-cols-[1fr_1fr]">
                                <input
                                    name="buttonId"
                                    value="<%= button ? button.id : "" %>"
                                    class="input"
                                    placeholder="ID (opcional)"
                                />
                                <input
                                    name="buttonTitle"
                                    value="<%= button ? button.title : "" %>"
                                    class="input"
                                    maxlength="20"
                                    placeholder="Título del botón"
                                />
                            </div>
                        <% } %>
                    </div>
                    <p class="mt-2 text-xs text-slate-500">
                        Si dejas un título vacío, ese botón no se envía. Los IDs deben ser únicos.
                    </p>
                </section>
            <% } %>

            <div class="flex gap-3">
                <button class="btn btn--primary">Guardar flujo</button>
                <a href="/admin/ai/package" class="btn btn--secondary">Cancelar</a>
            </div>
        </form>
    </main>
</body>
</html>

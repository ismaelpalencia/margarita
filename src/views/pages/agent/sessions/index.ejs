<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis sesiones | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body class="min-h-screen bg-slate-100">
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <a href="/agent/dashboard" class="flex shrink-0 items-center gap-3">
                <img src="/brand/img/margarita-icon-128.png" alt="Margarita" class="h-9 w-9" />

                <span class="text-base font-black leading-tight text-slate-900">
                    Margarita
                </span>
            </a>

            <nav class="no-scrollbar -mx-4 flex items-center gap-3 overflow-x-auto whitespace-nowrap px-4 sm:mx-0 sm:flex-wrap sm:overflow-x-visible sm:px-0">
                <a href="/agent/conversations" class="text-sm font-medium text-slate-700">
                    ← Mis conversaciones
                </a>

                <%- include("../../../partials/theme-toggle") %>

                <form action="/auth/logout" method="POST">
                    <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white">
                        Cerrar sesión
                    </button>
                </form>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
        <section class="mb-6">
            <h2 class="text-2xl font-bold text-slate-800">Mis sesiones</h2>

            <p class="mt-1 max-w-3xl text-slate-500">
                Los dispositivos desde donde tienes abierta la sesión. Se cierra
                sola después de <strong><%= idleHours %> horas</strong> sin
                usarse, y puedes tener cuando mucho
                <strong><%= maxActive %></strong> a la vez.
            </p>
        </section>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                <%= success === "revoked-others"
                    ? "Se cerraron tus otras sesiones."
                    : "Sesión cerrada." %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700">
                <%= error === "current"
                    ? "Esa es tu sesión actual: para cerrarla usa «Cerrar sesión»."
                    : "No se pudo cerrar la sesión." %>
            </div>
        <% } %>

        <section class="mb-4 flex flex-wrap items-center gap-3">
            <form action="/agent/sessions/revoke-others" method="POST">
                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                    Cerrar mis otras sesiones
                </button>
            </form>

            <p class="text-xs text-slate-500">
                Úsalo si viste algo que no reconoces en la lista.
            </p>
        </section>

        <%- include("../../../partials/sessions-table", {
            sessions,
            basePath: "/agent/sessions",
            showUser: false
        }) %>
    </main>
</body>
</html>

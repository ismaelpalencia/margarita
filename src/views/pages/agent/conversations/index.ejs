<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mis conversaciones | Margarita</title>
    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />

    <%- include("../../../partials/brand-head") %>
</head>

<body
    class="min-h-screen bg-slate-100"
    data-live-page="inbox"
    data-live-base="/agent/conversations"
    data-live-user-id="<%= user.id %>"
>
    <%- include("../../../partials/agent-nav", { user }) %>

    <main class="mx-auto max-w-7xl px-6 py-8">
        <section class="mb-6">
            <h2 class="text-2xl font-bold text-slate-800">
                Mis conversaciones
            </h2>

            <p class="mt-1 text-slate-500">
                Ves tus conversaciones asignadas y las que aún no tienen dueño.
            </p>
        </section>

        <form action="/agent/conversations" method="GET" class="mb-6 grid gap-3 md:grid-cols-[1fr_180px_auto_auto]">
            <input
                type="search"
                name="search"
                value="<%= search %>"
                placeholder="Buscar por nombre o teléfono"
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            />

            <select
                name="status"
                class="rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            >
                <option value="">Todos los estados</option>
                <option value="OPEN" <% if (status === "OPEN") { %> selected <% } %>>Abiertas</option>
                <option value="CLOSED" <% if (status === "CLOSED") { %> selected <% } %>>Cerradas</option>
            </select>

            <label class="flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-700">
                <input
                    type="checkbox"
                    name="unread"
                    value="1"
                    class="h-4 w-4 rounded border-slate-300"
                    <% if (onlyUnread) { %> checked <% } %>
                />

                Sin leer
            </label>

            <button class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white">
                Filtrar
            </button>
        </form>

        <% if (success) { %>
            <div class="mb-5 rounded-xl bg-margarita-50 px-4 py-3 text-sm text-margarita-700">
                Acción realizada correctamente.
            </div>
        <% } %>

        <% if (conversations.length === 0) { %>
            <div class="card">
                <div class="empty">
                    <div class="empty__icon">💬</div>
                    <p class="empty__title">No hay conversaciones para mostrar</p>
                    <p class="empty__copy">Cuando te asignen una o llegue una sin dueño, aparecerá aquí.</p>
                </div>
            </div>
        <% } else { %>
        <section class="card" style="padding: 0; overflow: hidden">
            <div class="flex items-center justify-between border-b px-5 py-3" style="border-color: var(--surface-border)">
                <h2 class="card__title">Bandeja <span class="chip"><%= conversations.length %></span></h2>
                <span class="text-xs" style="color: var(--text-tertiary)">Ordenadas por actividad reciente</span>
            </div>

            <% conversations.forEach((conversation) => { %>
                <% const lastMessage = conversation.messages[0]; %>
                <% const unread = conversation.unreadCount > 0; %>
                <% const name = conversation.contact.customName || conversation.contact.profileName || conversation.contact.phone; %>

                <div class="inbox-row" data-conversation-id="<%= conversation.id %>">
                    <div class="panel-avatar"><%= name.charAt(0).toUpperCase() %></div>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <a href="/agent/conversations/<%= conversation.id %>" class="truncate text-[13px] <%= unread ? 'font-bold' : 'font-semibold' %>" style="color: var(--text-primary)">
                                <%= name %>
                            </a>
                            <span class="shrink-0 text-[11px]" style="color: var(--text-tertiary)">
                                <% if (lastMessage) { %><%= new Date(lastMessage.createdAt).toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit" }) %><% } %>
                            </span>
                        </div>

                        <a href="/agent/conversations/<%= conversation.id %>" class="mt-0.5 block truncate text-[13px]" style="color: var(--text-secondary)">
                            <% if (lastMessage) { %><%= lastMessage.body || lastMessage.type %><% } else { %>—<% } %>
                        </a>

                        <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                            <span class="badge <%= conversation.status === 'OPEN' ? 'badge--success' : 'badge--neutral' %>"><%= conversation.operationalStatus %></span>
                            <% if (conversation.aiHandoffAt) { %><span class="badge badge--warning">Handoff</span><% } %>
                            <% if (!conversation.assignedUser) { %><span class="badge badge--danger">Sin asignar</span><% } %>
                            <% if (conversation.contact.optOutAt) { %><span class="badge badge--danger">BAJA</span><% } %>
                        </div>
                    </div>

                    <div class="flex shrink-0 flex-col items-end gap-1.5">
                        <span class="panel-sidebar__count <%= unread ? 'panel-sidebar__count--unread' : 'is-empty' %>" data-row-unread data-count="<%= conversation.unreadCount %>"><%= conversation.unreadCount %></span>

                        <div class="flex items-center gap-1.5">
                            <% if (!conversation.assignedUser) { %>
                                <form action="/agent/conversations/<%= conversation.id %>/claim" method="POST">
                                    <button class="btn btn--primary btn--sm">Reclamar</button>
                                </form>
                            <% } %>
                            <a href="/agent/conversations/<%= conversation.id %>" class="btn btn--secondary btn--sm">Abrir</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </section>
        <% } %>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/copy.js"></script>
    <script src="/js/live.js"></script>
</body>
</html>

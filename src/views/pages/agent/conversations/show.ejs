<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Conversación | Margarita</title>
    <link rel="stylesheet" href="/css/style.css" />

    <%- include("../../../partials/brand-head") %>
</head>

<body
    class="min-h-screen bg-slate-100"
    data-live-page="conversation"
    data-conversation-id="<%= conversation.id %>"
    data-live-base="/agent/conversations"
>
<%
    const contactName =
        conversation.contact.customName ||
        conversation.contact.profileName ||
        conversation.contact.phone;

    const initials = contactName
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((word) => word[0])
        .join("")
        .toUpperCase();

    const hasOpenWindow =
        conversation.lastIncomingMessageAt &&
        new Date().getTime() - new Date(conversation.lastIncomingMessageAt).getTime() <=
            24 * 60 * 60 * 1000;

    const deleteUrlFor = (messageId) =>
        `/agent/conversations/${conversation.id}/messages/${messageId}/delete`;
%>

    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
            <div class="flex items-center gap-3">
                <a href="/agent/dashboard" class="inline-block">
                    <img
                        src="/brand/img/margarita-wordmark-256.png"
                        alt="Margarita"
                        class="h-7 w-auto"
                    />
                </a>
            </div>

            <nav class="flex items-center gap-3">
                <a href="/agent/conversations" class="text-sm font-medium text-slate-700">
                    ← Mis conversaciones
                </a>

                <form action="/auth/logout" method="POST">
                    <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-medium text-white">
                        Cerrar sesión
                    </button>
                </form>
            </nav>
        </div>
    </header>

    <main class="mx-auto grid w-full max-w-7xl gap-4 px-3 py-4 lg:h-[calc(100dvh-88px)] lg:grid-cols-[1fr_320px] lg:px-4">
        <section class="flex h-[70dvh] min-h-[420px] flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 lg:h-full lg:min-h-0">
            <div class="flex shrink-0 items-center gap-3 border-b border-slate-200 px-4 py-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-sm font-bold text-emerald-700">
                    <%= initials %>
                </div>

                <div class="min-w-0">
                    <p class="truncate font-bold text-slate-900">
                        <%= contactName %>
                    </p>

                    <p class="truncate text-xs text-slate-500">
                        <%= conversation.contact.phone %>
                    </p>
                </div>

                <span class="ml-auto shrink-0 rounded-full px-3 py-1 text-xs font-semibold <%= hasOpenWindow ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                    <%= hasOpenWindow ? "Ventana abierta" : "Ventana cerrada" %>
                </span>
            </div>

            <% if (success === "free_text" || success === "template" || success === "message") { %>
                <p class="border-b border-emerald-100 bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-700">
                    Mensaje enviado.
                </p>
            <% } %>

            <% if (error === "free_text") { %>
                <p class="border-b border-red-100 bg-red-50 px-4 py-2 text-xs font-semibold text-red-700">
                    No se pudo enviar. Revisa que la ventana de 24 horas siga abierta.
                </p>
            <% } else if (error === "template") { %>
                <p class="border-b border-red-100 bg-red-50 px-4 py-2 text-xs font-semibold text-red-700">
                    No se pudo enviar la plantilla. Revisa las variables y que esté aprobada.
                </p>
            <% } else if (error === "message") { %>
                <p class="border-b border-red-100 bg-red-50 px-4 py-2 text-xs font-semibold text-red-700">
                    No se pudo guardar el mensaje.
                </p>
            <% } %>

            <div
                class="min-h-0 flex-1 space-y-2 overflow-y-auto px-3 py-4 sm:px-5"
                style="background-color: #f4f7f5; background-image: radial-gradient(#dde5e0 1px, transparent 1px); background-size: 22px 22px;"
                data-live-messages
            >
                <% if (conversation.messages.length === 0) { %>
                    <div class="rounded-xl bg-white p-5 text-center text-sm text-slate-500" data-live-empty>
                        Todavía no hay mensajes en esta conversación.
                    </div>
                <% } %>

                <% let lastDay = null; %>

                <% conversation.messages.forEach((message) => { %>
                    <%
                        const day = message.createdAt.toDateString();
                    %>

                    <% if (day !== lastDay) { %>
                        <% lastDay = day; %>

                        <div class="flex justify-center py-2">
                            <span class="rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold text-slate-500 shadow-sm">
                                <%= formatDayLabelMX(message.createdAt) %>
                            </span>
                        </div>
                    <% } %>

                    <%- include("../../../partials/message-bubble", {
                        message,
                        deleteUrl: deleteUrlFor(message.id),
                        restoreUrl: null,
                        logsUrl: null
                    }) %>
                <% }) %>
            </div>

            <div class="shrink-0 border-t border-slate-200 bg-white p-3">
                <% if (conversation.status !== "OPEN") { %>
                    <p class="rounded-xl bg-slate-50 px-4 py-3 text-center text-sm text-slate-500">
                        Esta conversación está cerrada.
                    </p>
                <% } else if (hasOpenWindow) { %>
                    <form
                        action="/agent/conversations/<%= conversation.id %>/messages/free-text"
                        method="POST"
                        class="flex items-end gap-2"
                    >
                        <textarea
                            name="body"
                            rows="1"
                            required
                            placeholder="Escribe un mensaje"
                            class="max-h-32 flex-1 resize-none rounded-2xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"
                        ></textarea>

                        <button class="rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700">
                            Enviar
                        </button>
                    </form>

                    <p class="mt-2 text-[11px] text-slate-400">
                        Puedes escribir libremente porque el cliente respondió en las últimas 24 horas.
                    </p>

                    <details class="mt-3">
                        <summary class="cursor-pointer text-xs font-semibold text-slate-500">
                            Más opciones: plantilla o nota interna
                        </summary>

                        <div class="mt-3 grid gap-3">
                            <form
                                action="/agent/conversations/<%= conversation.id %>/messages/template"
                                method="POST"
                                class="space-y-2 rounded-xl border border-emerald-200 bg-emerald-50 p-3"
                            >
                                <p class="text-sm font-semibold text-slate-800">
                                    Enviar plantilla
                                </p>

                                <% if (templates.length === 0) { %>
                                    <p class="text-xs text-slate-500">
                                        No hay plantillas aprobadas sincronizadas.
                                    </p>
                                <% } else { %>
                                    <select
                                        name="templateId"
                                        required
                                        class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                    >
                                        <option value="">Selecciona plantilla</option>

                                        <% templates.forEach((template) => { %>
                                            <option value="<%= template.id %>">
                                                <%= template.name %> · <%= template.language %>
                                            </option>
                                        <% }) %>
                                    </select>

                                    <div class="grid gap-2 sm:grid-cols-3">
                                        <% [1, 2, 3].forEach((position) => { %>
                                            <input
                                                name="variable<%= position %>"
                                                placeholder="Variable <%= position %>"
                                                class="rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                            />
                                        <% }) %>
                                    </div>

                                    <button class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
                                        Enviar plantilla
                                    </button>
                                <% } %>
                            </form>

                            <form
                                action="/agent/conversations/<%= conversation.id %>/messages/local"
                                method="POST"
                                class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-3"
                            >
                                <p class="text-sm font-semibold text-slate-800">
                                    Nota interna
                                </p>

                                <textarea
                                    name="body"
                                    rows="2"
                                    required
                                    placeholder="Solo la ve el equipo. No se envía a WhatsApp."
                                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                                ></textarea>

                                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                                    Guardar nota
                                </button>
                            </form>
                        </div>
                    </details>
                <% } else { %>
                    <div class="rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800">
                        La ventana de 24 horas está cerrada: para reabrir la conversación hay que enviar una plantilla.
                    </div>

                    <form
                        action="/agent/conversations/<%= conversation.id %>/messages/template"
                        method="POST"
                        class="mt-3 space-y-3"
                    >
                        <% if (templates.length === 0) { %>
                            <p class="text-sm text-slate-500">
                                No hay plantillas aprobadas sincronizadas.
                            </p>
                        <% } else { %>
                            <select
                                name="templateId"
                                required
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm"
                            >
                                <option value="">Selecciona plantilla</option>

                                <% templates.forEach((template) => { %>
                                    <option value="<%= template.id %>">
                                        <%= template.name %> · <%= template.language %>
                                    </option>
                                <% }) %>
                            </select>

                            <div class="grid gap-2 sm:grid-cols-3">
                                <% [1, 2, 3].forEach((position) => { %>
                                    <input
                                        name="variable<%= position %>"
                                        placeholder="Variable <%= position %>"
                                        class="rounded-xl border border-slate-300 px-4 py-2 text-sm"
                                    />
                                <% }) %>
                            </div>

                            <button class="w-full rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700">
                                Enviar plantilla
                            </button>
                        <% } %>
                    </form>
                <% } %>
            </div>
        </section>

        <aside class="space-y-4 lg:min-h-0 lg:overflow-y-auto lg:pr-1">
            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Datos
                </h3>

                <dl class="mt-4 space-y-3 text-sm">
                    <div>
                        <dt class="text-slate-500">Estado</dt>
                        <dd class="font-medium text-slate-800"><%= conversation.status %></dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Operación</dt>
                        <dd class="font-medium text-slate-800"><%= conversation.operationalStatus %></dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Origen</dt>
                        <dd class="font-medium text-slate-800"><%= conversation.source %></dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Último mensaje entrante</dt>
                        <dd class="font-medium text-slate-800">
                            <% if (conversation.lastIncomingMessageAt) { %>
                                <%= formatDateTimeMX(conversation.lastIncomingMessageAt) %>
                            <% } else { %>
                                —
                            <% } %>
                        </dd>
                    </div>

                    <div>
                        <dt class="text-slate-500">Ventana 24h</dt>
                        <dd class="font-medium <%= hasOpenWindow ? 'text-emerald-700' : 'text-red-700' %>">
                            <%= hasOpenWindow ? "Abierta" : "Cerrada" %>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Etiquetas
                </h3>

                <div class="mt-4 flex flex-wrap gap-2">
                    <% if (conversation.contact.tags.length === 0) { %>
                        <span class="text-sm text-slate-400">Sin etiquetas</span>
                    <% } %>

                    <% conversation.contact.tags.forEach((contactTag) => { %>
                        <span
                            class="rounded-full px-3 py-1 text-xs font-semibold text-white"
                            style="background-color: <%= contactTag.tag.color || '#10b981' %>;"
                        >
                            <%= contactTag.tag.name %>
                        </span>
                    <% }) %>
                </div>
            </section>

            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Acciones
                </h3>

                <div class="mt-4 space-y-3">
                    <% if (conversation.status === "OPEN") { %>
                        <form action="/agent/conversations/<%= conversation.id %>/close" method="POST">
                            <button class="w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white">
                                Cerrar conversación
                            </button>
                        </form>
                    <% } %>
                </div>
            </section>
        </aside>
    </main>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/live.js"></script>
</body>
</html>

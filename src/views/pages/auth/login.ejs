<%- include("../../partials/header", { title: "Iniciar sesión - Margarita" }) %>

<%
    /**
     * `typeof` en los locales opcionales: referenciar uno que no se pasó
     * rompe la plantilla (por eso el proyecto usa este patrón).
     */
    const needsTwoFactor =
        typeof twoFactor !== "undefined" &&
        twoFactor &&
        twoFactor.challengeToken;
%>

<main class="flex min-h-screen items-center justify-center bg-gradient-to-br from-margarita-50 via-slate-100 to-white px-4 py-10">
    <section class="grid w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-slate-200 lg:grid-cols-[1fr_440px]">
        <div class="hidden bg-slate-950 p-10 text-white lg:block">
            <div class="flex h-full flex-col justify-between">
                <div>
                    <img
                        src="/brand/img/margarita-icon-128.png"
                        alt="Margarita"
                        class="h-14 w-14"
                    />

                    <h1 class="mt-8 text-4xl font-black leading-tight">
                        Margarita
                    </h1>

                    <p class="mt-4 max-w-sm text-lg text-slate-300">
                        WhatsApp operativo para equipos pequeños.
                    </p>
                </div>

                <div class="space-y-4">
                    <div class="rounded-2xl bg-white/10 p-4">
                        <p class="text-sm font-semibold text-margarita-300">
                            Campañas
                        </p>

                        <p class="mt-1 text-sm text-slate-300">
                            Envía plantillas aprobadas y da seguimiento desde una sola bandeja.
                        </p>
                    </div>

                    <div class="rounded-2xl bg-white/10 p-4">
                        <p class="text-sm font-semibold text-margarita-300">
                            Agentes
                        </p>

                        <p class="mt-1 text-sm text-slate-300">
                            Asigna conversaciones y mantén control operativo del equipo.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-8 md:p-10">
            <div class="mb-4 flex justify-end">
                <%- include("../../partials/theme-toggle") %>
            </div>

            <div class="mb-8 lg:hidden">
                <img
                    src="/brand/img/margarita-icon-128.png"
                    alt="Margarita"
                    class="h-12 w-12"
                />

                <h1 class="mt-4 text-3xl font-black text-slate-900">
                    Margarita
                </h1>

                <p class="mt-2 text-slate-500">
                    WhatsApp operativo para equipos pequeños.
                </p>
            </div>

            <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-margarita-600">
                    Bienvenido
                </p>

                <h2 class="mt-2 text-3xl font-black text-slate-900">
                    Inicia sesión
                </h2>

                <p class="mt-2 text-sm text-slate-500">
                    Entra al panel para gestionar conversaciones, campañas y agentes.
                </p>
            </div>

            <%#
                Los avisos son opcionales: se preguntan con `typeof` porque no
                todas las rutas que pintan esta pantalla los pasan. Una
                referencia suelta convierte un "credenciales incorrectas" en un
                error 500.
            %>
            <% if (typeof error !== "undefined" && error) { %>
                <div class="mt-6 rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof notConfigured !== "undefined" && notConfigured) { %>
                <div class="mt-6 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-100">
                    <strong>Esta instalación todavía no está configurada.</strong>
                    Falta crear la empresa y el usuario administrador.
                    <a href="/setup" class="font-bold underline">Configurarla ahora</a>.
                </div>
            <% } %>

            <% if (typeof success !== "undefined" && success) { %>
                <div class="mt-6 rounded-xl bg-margarita-50 px-4 py-3 text-sm font-medium text-margarita-700">
                    <%= success %>
                </div>
            <% } %>

            <% if (needsTwoFactor) { %>
                <form action="/auth/login/2fa" method="POST" class="mt-8 space-y-5">
                    <input type="hidden" name="challengeToken" value="<%= twoFactor.challengeToken %>" />
                    <input type="hidden" name="email" value="<%= twoFactor.email || "" %>" />

                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-700">
                            Código de verificación
                        </label>

                        <input
                            name="code"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                            maxlength="7"
                            required
                            autofocus
                            placeholder="123456"
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-center text-lg font-bold tracking-[0.3em] outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                        />

                        <p class="mt-2 text-xs text-slate-500">
                            Es el código de 6 dígitos de tu app de autenticación.
                            Cambia cada 30 segundos.
                        </p>
                    </div>

                    <button
                        class="w-full rounded-xl bg-margarita-600 px-4 py-3 font-semibold text-white hover:bg-margarita-700"
                    >
                        Entrar
                    </button>

                    <a href="/auth/login" class="block text-center text-xs font-semibold text-slate-500 hover:text-slate-700">
                        Volver a escribir la contraseña
                    </a>
                </form>
            <% } else { %>
            <form action="/auth/login" method="POST" class="mt-8 space-y-5">
                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Correo
                    </label>

                    <input
                        type="email"
                        name="email"
                        required
                        value="<%= old.email %>"
                        placeholder="admin@margarita.local"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <div>
                    <label class="mb-1 block text-sm font-semibold text-slate-700">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        name="password"
                        required
                        placeholder="••••••••"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                    />
                </div>

                <button class="w-full rounded-xl bg-margarita-600 px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-margarita-700">
                    Entrar a Margarita
                </button>
            </form>
            <% } %>

            <p class="mt-8 text-center text-xs text-slate-400">
                Margarita V1 · Operación WhatsApp Cloud API
            </p>
        </div>
    </section>
</main>

<%- include("../../partials/footer") %>


<%
    const availableNumbers = (activeNumbers || []).filter((number) => number.isActive);
    const collectionsOn = typeof collectionsEnabled !== "undefined" ? collectionsEnabled : true;
    const moduleLinks = ["/admin/reports", "/admin/replies"];
    const navLinks = [
        { href: "/admin/dashboard", label: "Dashboard" },
        { href: "/admin/conversations", label: "Conversaciones", badge: unreadTotal || 0, badgeKind: "unread" },
        { href: "/admin/conversations?assigned=unassigned", label: "Sin asignar", badge: unassignedCount || 0, badgeKind: "unassigned" },
        { href: "/admin/campaigns", label: "Campañas" },
        { href: "/admin/contacts", label: "Contactos" },
        { href: "/admin/tags", label: "Etiquetas" },
        { href: "/admin/reports", label: "Reportes" },
        { href: "/admin/quick-replies", label: "Respuestas" },
        { href: "/admin/ai", label: "IA" },
        { href: "/admin/replies", label: "Botones y listas" },
        { href: "/admin/users", label: "Equipo" },
        { href: "/admin/templates", label: "Plantillas" },
        { href: "/admin/system", label: "Sistema" },
        { href: "/admin/hours", label: "Horarios" },
        { href: "/admin/leads", label: "Leads" },
        { href: "/admin/reports/service", label: "Reportes de servicio" },
        { href: "/admin/guia", label: "Guía" },
        { href: "/admin/whatsapp", label: "WhatsApp" },
        { href: "/admin/logs", label: "Logs" },
        { href: "/admin/backup", label: "Respaldos" },
        { href: "/admin/sessions", label: "Sesiones" },
        { href: "/account/password", label: "Mi cuenta" }
    ].filter((link) => collectionsOn || !moduleLinks.includes(link.href));
    const current = currentPath || "/";
%>

<aside class="panel-sidebar" id="panel-sidebar">
    <div class="panel-sidebar__brand">
        <img src="/brand/img/margarita-icon-128.png" alt="Margarita" />
        <div>
            <strong>Margarita</strong>
            <small>Panel Admin</small>
        </div>
    </div>

    <nav class="panel-sidebar__nav">
        <% navLinks.forEach((link) => { %>
            <a
                href="<%= link.href %>"
                class="panel-sidebar__link <%= current === link.href || (link.href !== "/admin/dashboard" && current.startsWith(link.href.split("?")[0])) ? "is-active" : "" %>"
            >
                <span><%= link.label %></span>

                <% if (typeof link.badge === "number") { %>
                    <span
                        <%= link.badgeKind === "unassigned" ? "data-badge=\"unassigned\"" : "data-unread-badge" %>
                        data-count="<%= link.badge %>"
                        class="panel-sidebar__count <%= link.badgeKind === "unassigned" ? "panel-sidebar__count--unassigned" : "panel-sidebar__count--unread" %> <%= link.badge > 0 ? "" : "is-empty" %>"
                    ><%= link.badge %></span>
                <% } %>
            </a>
        <% }) %>
    </nav>

    <div class="panel-sidebar__footer">
        <div class="panel-avatar"><%= (user?.name || "A").charAt(0).toUpperCase() %></div>
        <div class="meta">
            <div class="name"><%= user?.name || "Admin" %></div>
            <div class="role">Administrador</div>
        </div>
        <form action="/auth/logout" method="POST">
            <button class="btn btn--ghost btn--sm">Salir</button>
        </form>
    </div>
</aside>

<div class="panel-topbar">
    <button class="btn btn--ghost lg:hidden" id="panel-menu-toggle" aria-label="Menú">☰</button>

    <button class="btn btn--ghost hidden md:inline-flex" id="panel-hide" aria-label="Ocultar menú" title="Ocultar menú">⇤</button>

    <form action="/admin/conversations" method="GET" class="panel-topbar__search">
        <input type="search" name="search" class="input" placeholder="Buscar conversación o contacto…" />
    </form>

    <div class="panel-topbar__spacer"></div>

    <% if (typeof offHoursNow !== "undefined" && offHoursNow) { %>
        <span class="badge badge--warning" title="Fuera del horario de atención">Fuera de horario</span>
    <% } %>

    <% if (availableNumbers.length === 1) { %>
        <span class="badge badge--info" title="Número activo"><%= availableNumbers[0].displayName || availableNumbers[0].phoneNumber %></span>
    <% } else if (availableNumbers.length > 1) { %>
        <form action="/admin/number/switch" method="POST">
            <input type="hidden" name="redirectTo" value="<%= current || "/" %>" />
            <select name="numberId" class="input" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" title="Número activo">
                <% availableNumbers.forEach((number) => { %>
                    <option value="<%= number.id %>" <%= activeNumber && activeNumber.id === number.id ? "selected" : "" %>><%= number.displayName || number.phoneNumber %></option>
                <% }) %>
            </select>
        </form>
    <% } %>

    <%- include("theme-toggle") %>

    <div class="panel-bell">
        <button class="btn btn--ghost" id="panel-bell" aria-label="Notificaciones" title="Notificaciones">
            🔔
            <span class="panel-sidebar__count panel-sidebar__count--unread is-empty" id="panel-bell-count">0</span>
        </button>
        <div class="panel-bell__panel" id="panel-bell-panel" hidden></div>
    </div>
</div>

<script>
    window.__margaritaNotifications = {
        sound: <%= typeof notifySoundEnabled !== "undefined" && notifySoundEnabled ? "true" : "false" %>,
        browser: <%= typeof notifyBrowserEnabled !== "undefined" && notifyBrowserEnabled ? "true" : "false" %>
    };

    (function () {
        var toggle = document.getElementById("panel-menu-toggle");
        var sidebar = document.getElementById("panel-sidebar");

        if (toggle && sidebar) {
            toggle.addEventListener("click", function () {
                sidebar.classList.toggle("is-open");
            });
        }

        var hide = document.getElementById("panel-hide");

        if (hide) {
            if (localStorage.getItem("margarita:sidebar-hidden") === "1") {
                document.body.classList.add("sidebar-hidden");
            }

            hide.addEventListener("click", function () {
                document.body.classList.toggle("sidebar-hidden");
                localStorage.setItem(
                    "margarita:sidebar-hidden",
                    document.body.classList.contains("sidebar-hidden") ? "1" : "0"
                );
            });
        }

        var bell = document.getElementById("panel-bell");
        var bellPanel = document.getElementById("panel-bell-panel");
        var bellCount = document.getElementById("panel-bell-count");

        function readToasts() {
            try {
                return JSON.parse(localStorage.getItem("margarita:toasts") || "[]");
            } catch (error) {
                return [];
            }
        }

        function renderToasts() {
            var items = readToasts();

            var seenAt = Number(localStorage.getItem("margarita:toastsSeenAt") || 0);
            var unseen = items.filter(function (item) {
                return Number(item.at || 0) > seenAt;
            }).length;

            if (bellCount) {
                bellCount.textContent = String(unseen);
                bellCount.classList.toggle("is-empty", unseen === 0);
                bellCount.classList.toggle("hidden", unseen === 0);
            }

            if (!bellPanel) {
                return;
            }

            bellPanel.innerHTML = "";

            if (items.length === 0) {
                bellPanel.innerHTML = '<p class="toast__detail" style="padding:12px">Sin novedades.</p>';
                return;
            }

            items.forEach(function (item) {
                var node = document.createElement(item.href ? "a" : "div");
                node.className = "toast";

                if (item.href) {
                    node.href = item.href;
                }

                var title = document.createElement("div");
                title.className = "toast__title";
                title.textContent = item.title || "";
                node.appendChild(title);

                if (item.detail) {
                    var detail = document.createElement("div");
                    detail.className = "toast__detail";
                    detail.textContent = item.detail;
                    node.appendChild(detail);
                }

                bellPanel.appendChild(node);
            });
        }

        if (bell && bellPanel) {
            bell.addEventListener("click", function (event) {
                event.stopPropagation();
                bellPanel.hidden = !bellPanel.hidden;

                if (!bellPanel.hidden) {
                    localStorage.setItem("margarita:toastsSeenAt", String(Date.now()));
                }

                renderToasts();
            });

            document.addEventListener("click", function () {
                bellPanel.hidden = true;
            });

            bellPanel.addEventListener("click", function (event) {
                event.stopPropagation();
            });

            window.addEventListener("margarita:toast", renderToasts);
            renderToasts();
        }
    })();
</script>
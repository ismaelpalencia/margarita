<header class="border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 py-4 lg:flex-nowrap lg:justify-between">
        <div class="flex items-center gap-3">
            <a href="/admin/dashboard" class="shrink-0">
                <img src="/brand/img/margarita-icon-128.png" alt="Margarita" class="h-10 w-10" />
            </a>

            <div>
                <p class="text-lg font-black leading-tight text-slate-900">
                    Margarita
                </p>

                <p class="text-xs font-medium text-slate-500">
                    Panel Admin
                </p>
            </div>

            <%
                const availableNumbers = (activeNumbers || []).filter((number) => number.isActive);
            %>

            <% if (availableNumbers.length === 1) { %>
                <span
                    class="ml-1 rounded-full bg-margarita-50 px-3 py-1 text-xs font-semibold text-margarita-700 ring-1 ring-margarita-100"
                    title="Número activo"
                >
                    <%= availableNumbers[0].displayName || availableNumbers[0].phoneNumber %>
                </span>
            <% } else if (availableNumbers.length > 1) { %>
                <form action="/admin/number/switch" method="POST" class="ml-1">
                    <input type="hidden" name="redirectTo" value="<%= currentPath || '/' %>" />

                    <select
                        name="numberId"
                        onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()"
                        title="Número activo"
                        class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700"
                    >
                        <% availableNumbers.forEach((number) => { %>
                            <option
                                value="<%= number.id %>"
                                <%= activeNumber && activeNumber.id === number.id ? "selected" : "" %>
                            >
                                <%= number.displayName || number.phoneNumber %>
                            </option>
                        <% }) %>
                    </select>
                </form>
            <% } %>
        </div>

        <%
            /**
             * Los enlaces del panel se declaran una sola vez y se pintan dos:
             * en fila para pantallas grandes y dentro de un menú plegable en el
             * celular. Antes eran diecisiete enlaces que se envolvían y
             * empujaban el contenido media pantalla hacia abajo.
             */
            const navLinks = [
                { href: "/admin/dashboard", label: "Dashboard" },
                { href: "/admin/conversations", label: "Conversaciones", badge: unreadTotal || 0 },
                { href: "/admin/campaigns", label: "Campañas" },
                { href: "/admin/contacts", label: "Contactos" },
                { href: "/admin/tags", label: "Etiquetas" },
                { href: "/admin/reports", label: "Reportes" },
                { href: "/admin/quick-replies", label: "Respuestas" },
                { href: "/admin/replies", label: "Botones" },
                { href: "/admin/users", label: "Equipo" },
                { href: "/admin/templates", label: "Plantillas" },
                { href: "/admin/system", label: "Sistema" },
                { href: "/admin/roadmap", label: "Roadmap" },
                { href: "/admin/whatsapp", label: "WhatsApp" },
                { href: "/admin/logs", label: "Logs" },
                { href: "/admin/backup", label: "Respaldos" },
                { href: "/admin/sessions", label: "Sesiones" },
                { href: "/account/password", label: "Mi cuenta" }
            ];
        %>

        <nav class="hidden items-center gap-2 text-sm lg:flex lg:flex-wrap">
            <% navLinks.forEach((link) => { %>
                <a
                    href="<%= link.href %>"
                    class="inline-flex items-center gap-2 rounded-xl px-3 py-2 font-semibold text-slate-600 hover:bg-margarita-50 hover:text-margarita-700"
                >
                    <%= link.label %>

                    <% if (typeof link.badge === "number") { %>
                        <span
                            data-unread-badge
                            data-count="<%= link.badge %>"
                            class="rounded-full bg-margarita-600 px-2 py-0.5 text-[11px] font-bold text-white <%= link.badge > 0 ? '' : 'hidden' %>"
                            title="Mensajes sin leer"
                        >
                            <%= link.badge %>
                        </span>
                    <% } %>
                </a>
            <% }) %>
        </nav>

        <details class="order-last w-full lg:order-none lg:hidden">
            <summary
                class="flex cursor-pointer items-center justify-between rounded-xl bg-margarita-50 px-4 py-3 text-sm font-black text-margarita-800 ring-1 ring-margarita-100"
            >
                Menú del panel

                <span class="text-xs font-semibold text-margarita-700">
                    <%= navLinks.length %> secciones
                </span>
            </summary>

            <nav class="mt-2 grid grid-cols-2 gap-1 text-sm">
                <% navLinks.forEach((link) => { %>
                    <a
                        href="<%= link.href %>"
                        class="inline-flex items-center justify-between gap-2 rounded-xl px-3 py-2 font-semibold text-slate-600 hover:bg-margarita-50 hover:text-margarita-700"
                    >
                        <%= link.label %>

                        <% if (typeof link.badge === "number" && link.badge > 0) { %>
                            <span class="rounded-full bg-margarita-600 px-2 py-0.5 text-[11px] font-bold text-white">
                                <%= link.badge %>
                            </span>
                        <% } %>
                    </a>
                <% }) %>
            </nav>
        </details>

        <div class="ml-auto flex items-center gap-3">
            <div class="hidden text-right md:block">
                <p class="text-sm font-bold text-slate-800">
                    <%= user?.name || "Admin" %>
                </p>

                <p class="text-xs text-slate-500">
                    Administrador
                </p>
            </div>

            <form action="/auth/logout" method="POST">
                <button class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800">
                    Salir
                </button>
            </form>
        </div>
    </div>
</header>

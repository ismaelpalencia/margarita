<%#
    Resultado de la gestión con el cliente, con el estado vigente y el
    marcado en un clic.

    Va en la columna lateral del hilo: escribir un mensaje y decidir en qué
    quedó son cosas distintas, y mezclarlas fue lo que hizo que el
    compositor creciera de más.

    Espera: contact, actionUrl, outcomeLabels, outcomeBadgeClasses,
            outcomeTypes, attempts, daysLate, formatAmount
%>
<%
    const currentType = contact.outcomeType || null;
    const overdue = currentType
        ? isOpenPromise(currentType) && daysLate > 0
        : false;
%>

<section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <h3 class="font-bold text-slate-800">
        Resultado de la gestión
    </h3>

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <% if (currentType) { %>
            <span class="rounded-full px-3 py-1 text-xs font-bold <%= outcomeBadgeClasses[currentType] %>">
                <%= overdue ? "Promesa vencida" : outcomeLabels[currentType] %>
            </span>

            <% if (overdue) { %>
                <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">
                    <%= daysLate %> día<%= daysLate === 1 ? "" : "s" %> de atraso
                </span>
            <% } %>

            <% if (contact.outcomeAmount) { %>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                    <%= formatAmount(Number(contact.outcomeAmount)) %>
                </span>
            <% } %>

            <% if (contact.outcomeDueAt) { %>
                <span class="text-xs text-slate-500">
                    Compromiso: <%= formatDateMX(contact.outcomeDueAt) %>
                </span>
            <% } %>

            <% if (contact.outcomePaidAt) { %>
                <span class="text-xs text-slate-500">
                    Pagó: <%= formatDateMX(contact.outcomePaidAt) %>
                </span>
            <% } %>

            <%#
                Cuando lo que quedó pendiente es una llamada, lo que importa no
                es la hora exacta sino cuánto lleva esperando: en dos horas
                contesta cualquiera, en tres días ya no.
            %>
            <% if (currentType === "CALLBACK" && contact.outcomeAt) { %>
                <span
                    class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800"
                    title="Desde que pidió la llamada"
                >
                    Esperando llamada <%= typeof formatWaitingTime !== "undefined" ? formatWaitingTime(contact.outcomeAt) : "desde " + formatDateTimeMX(contact.outcomeAt) %>
                </span>
            <% } %>
        <% } else { %>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500">
                Sin resultado
            </span>
        <% } %>

        <span
            class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"
            title="Mensajes salientes sin respuesta desde el último mensaje del cliente"
        >
            <%= attempts.attempts %> intento<%= attempts.attempts === 1 ? "" : "s" %>
        </span>

        <% if (!attempts.hasInbound) { %>
            <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
                Nunca ha respondido
            </span>
        <% } %>
    </div>

    <% if (currentType === "CALLBACK") { %>
        <p class="mt-3 rounded-xl bg-sky-50 px-3 py-2 text-xs text-sky-900">
            Está en la lista de hoy (<strong>Reportes → Hoy</strong>). Llámalo
            dentro del horario permitido —<strong>8:00 a 21:00</strong>, hora de
            la empresa— y registra aquí en qué quedó para que salga de la lista.
        </p>
    <% } %>

    <form
        action="<%= actionUrl %>"
        method="POST"
        class="mt-4 space-y-3"
    >
        <div class="grid gap-2 sm:grid-cols-2">
            <label class="block">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Monto
                </span>

                <input
                    name="amount"
                    inputmode="decimal"
                    placeholder="1250.00"
                    class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />
            </label>

            <label class="block">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Fecha compromiso
                </span>

                <input
                    type="date"
                    name="dueDate"
                    class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />
            </label>
        </div>

        <label class="block">
            <span class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                Fecha en que pagó (si aplica)
            </span>

            <input
                type="date"
                name="paidDate"
                class="mt-1 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
            />
        </label>

        <input
            name="note"
            placeholder="Nota de la gestión (opcional)"
            class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
        />

        <p class="text-[11px] text-slate-500">
            Llena el monto y la fecha, y luego toca el resultado. Una promesa o un
            convenio necesitan fecha compromiso; si no la pones, no se guarda.
        </p>

        <div class="grid grid-cols-2 gap-2">
            <% outcomeTypes.forEach((type) => { %>
                <button
                    name="type"
                    value="<%= type %>"
                    class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200"
                >
                    <%= shortLabels[type] %>
                </button>
            <% }) %>
        </div>
    </form>
</section>

<!DOCTYPE html>
<%#
    `themeLock` deja una página en claro aunque el navegador prefiera oscuro.
    Se usa en las páginas de venta y en los textos legales, que se diseñaron
    con la paleta clara y no tienen interruptor de tema.
%>
<html lang="es"<%= typeof themeLock !== "undefined" && themeLock ? ' data-theme-lock="light"' : "" %>>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%= title || "Margarita" %></title>

    <%- include("brand-head") %>

    <link rel="stylesheet" href="<%= `/css/style.css${typeof assetVersion !== "undefined" && assetVersion ? `?v=${assetVersion}` : ""}` %>" />
</head>

<body class="min-h-screen bg-slate-100 text-slate-900 antialiased">

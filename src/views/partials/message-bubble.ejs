<%#
    Burbuja de un mensaje, con estilo de conversación.
    Espera: message
    Opcionales: deleteUrl, restoreUrl, logsUrl
%>
<%
    const isOut = message.direction === "OUT";
    const mediaTypes = ["IMAGE", "VIDEO", "AUDIO", "DOCUMENT"];
    const hasMedia = mediaTypes.includes(message.type) && Boolean(message.mediaId);
    const body = message.body || "";
    /* Los textos entre corchetes son rellenos internos ("[Imagen]"). */
    const isPlaceholder = body.startsWith("[") && body.endsWith("]");
    const showBody = body !== "" && !(hasMedia && isPlaceholder);
    const deleted = Boolean(message.deletedAt);
    const isNote = Boolean(message.isInternalNote);

    const tickByStatus = {
        CREATED: "🕓",
        SENDING: "🕓",
        SENT: "✓",
        DELIVERED: "✓✓",
        READ: "✓✓",
        FAILED: "⚠"
    };

    const labelByStatus = {
        CREATED: "Pendiente",
        SENDING: "Enviando",
        SENT: "Enviado",
        DELIVERED: "Entregado",
        READ: "Leído",
        FAILED: "No entregado"
    };

    const tick = tickByStatus[message.status] || "🕓";
    const tickLabel = labelByStatus[message.status] || message.status;
    const tickColor =
        message.status === "READ"
            ? "text-sky-300"
            : message.status === "FAILED"
              ? "text-red-200"
              : isOut
                ? "text-margarita-100"
                : "text-slate-400";

    const tone = isNote
        ? "rounded-tr-sm bg-amber-100 text-amber-900 ring-1 ring-amber-200"
        : isOut
          ? "rounded-tr-sm bg-margarita-600 text-white"
          : "rounded-tl-sm bg-white text-slate-800 ring-1 ring-slate-200";

    /**
     * Los enlaces son opcionales: cada vista decide cuáles ofrece. Se usa
     * typeof porque referenciar un local no declarado rompe EJS.
     */
    const canDelete = typeof deleteUrl === "string" && deleteUrl !== "";
    const canRestore = typeof restoreUrl === "string" && restoreUrl !== "";
    const hasLogs = typeof logsUrl === "string" && logsUrl !== "";
%>

<div class="flex <%= isOut ? 'justify-end' : 'justify-start' %>" data-message-id="<%= message.id %>">
    <div class="max-w-[85%] rounded-2xl px-3 py-2 shadow-sm sm:max-w-[75%] sm:px-4 <%= tone %> <%= deleted ? 'opacity-50' : '' %>">
        <% if (deleted) { %>
            <p class="mb-1 text-[10px] font-semibold uppercase tracking-wide opacity-80">
                Eliminado
            </p>
        <% } %>

        <% if (isNote) { %>
            <p class="mb-1 text-[10px] font-bold uppercase tracking-wide text-amber-700">
                Nota interna · solo la ve el equipo
            </p>
        <% } %>

        <% if (hasMedia && message.mediaDownloadError) { %>
            <p
                class="text-[11px] font-semibold text-red-600"
                title="<%= message.mediaDownloadError %>"
            >
                ⚠ Archivo no disponible ·
                <a href="/media/<%= message.id %>" target="_blank" rel="noopener" class="underline">
                    reintentar
                </a>
            </p>
        <% } else if (hasMedia && message.type === "IMAGE") { %>
            <a href="/media/<%= message.id %>" target="_blank" rel="noopener">
                <img
                    src="/media/<%= message.id %>"
                    alt="Imagen recibida"
                    loading="lazy"
                    class="max-h-72 w-auto max-w-full rounded-xl"
                />
            </a>
        <% } else if (hasMedia && message.type === "VIDEO") { %>
            <video controls preload="metadata" src="/media/<%= message.id %>" class="max-h-72 w-full rounded-xl"></video>
        <% } else if (hasMedia && message.type === "AUDIO") { %>
            <audio controls preload="none" src="/media/<%= message.id %>" class="w-full max-w-xs"></audio>
        <% } else if (hasMedia) { %>
            <a
                href="/media/<%= message.id %>?download=1"
                class="flex items-center gap-2 rounded-xl bg-black/5 px-3 py-2 text-sm font-semibold"
            >
                <span aria-hidden="true">📄</span>
                <span class="truncate"><%= message.mediaFilename || body || "Documento" %></span>
            </a>
        <% } %>

        <% if (showBody) { %>
            <p class="whitespace-pre-line break-words text-sm <%= hasMedia ? 'mt-2' : '' %>">
                <%= body %>
            </p>
        <% } else if (!hasMedia) { %>
            <p class="whitespace-pre-line break-words text-sm">
                <%= "[" + message.type + "]" %>
            </p>
        <% } %>

        <div class="mt-1 flex items-center justify-end gap-1.5 text-[10px] <%= isNote ? 'text-amber-600' : isOut ? 'text-margarita-100' : 'text-slate-400' %>">
            <span><%= message.createdAt.toLocaleTimeString("es-MX", { hour: "2-digit", minute: "2-digit" }) %></span>

            <% if (isNote) { %>
                <span title="No se envía a WhatsApp">📝</span>
            <% } else { %>
                <span
                    data-message-status
                    class="<%= tickColor %> font-semibold"
                    title="<%= tickLabel %>"
                ><%= tick %></span>
            <% } %>

            <%- include("message-actions", {
                message,
                isOut,
                deleteUrl: canDelete ? deleteUrl : null,
                restoreUrl: canRestore ? restoreUrl : null
            }) %>
        </div>

        <% if (message.status === "FAILED") { %>
            <p
                class="mt-1 text-[10px] font-semibold <%= isOut ? 'text-red-100' : 'text-red-600' %>"
                title="<%= message.errorText || 'Sin detalle en el mensaje' %>"
            >
                ⚠ No se pudo entregar
                <% if (hasLogs) { %>
                    ·
                    <a href="<%= logsUrl %>" class="underline">
                        ver motivo en Logs
                    </a>
                <% } %>
            </p>
        <% } %>
    </div>

</div>

<%#
    Acciones de una conversación que no son "escribir un mensaje":
    enviar plantilla y dejar una nota interna.

    Viven en la columna lateral, que tiene su propio scroll, para que el
    compositor de abajo nunca crezca y tape el hilo.

    Espera: conversation, templates, basePath
%>
<% if (!conversation.contact.optOutAt) { %>
    <%
        /**
         * La ventana de 24 horas se calcula igual que en el hilo: solo se
         * pueden enviar archivos mientras el cliente haya respondido.
         */
        const windowOpen =
            conversation.lastIncomingMessageAt &&
            Date.now() - new Date(conversation.lastIncomingMessageAt).getTime() <=
                24 * 60 * 60 * 1000;
    %>

    <% if (windowOpen) { %>
        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <h3 class="font-bold text-slate-800">
                Enviar archivo
            </h3>

            <p class="mt-1 text-xs text-slate-500">
                Imagen 5 MB · video y audio 16 MB · documentos 100 MB. El audio no
                lleva texto.
            </p>

            <form
                action="<%= basePath %>/<%= conversation.id %>/messages/media"
                method="POST"
                enctype="multipart/form-data"
                class="mt-4 space-y-3"
            >
                <input
                    type="file"
                    name="file"
                    required
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />

                <input
                    name="caption"
                    placeholder="Texto opcional"
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />

                <button class="w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                    Enviar archivo
                </button>
            </form>
        </section>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <h3 class="font-bold text-slate-800">
                Enviar botones
            </h3>

            <p class="mt-1 text-xs text-slate-500">
                Hasta 3 botones de 20 caracteres. Solo dentro de las 24 horas:
                cuando el cliente los toca, la respuesta llega al hilo y puede
                disparar su regla en <strong>Admin → Botones y listas</strong>.
            </p>

            <form
                action="<%= basePath %>/<%= conversation.id %>/messages/interactive"
                method="POST"
                class="mt-4 space-y-2"
            >
                <textarea
                    name="body"
                    rows="2"
                    maxlength="1024"
                    required
                    placeholder="Texto del mensaje"
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                ></textarea>

                <input
                    name="footer"
                    maxlength="60"
                    placeholder="Pie (opcional)"
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />

                <input
                    name="button1"
                    maxlength="20"
                    placeholder="Botón 1 · por ejemplo: Sí, pagaré"
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />

                <input
                    name="button2"
                    maxlength="20"
                    placeholder="Botón 2 (opcional)"
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />

                <input
                    name="button3"
                    maxlength="20"
                    placeholder="Botón 3 (opcional)"
                    class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                />

                <button class="w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                    Enviar botones
                </button>
            </form>
        </section>

        <% if (typeof interactiveListsEnabled !== "undefined" && interactiveListsEnabled) { %>
            <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                <h3 class="font-bold text-slate-800">
                    Enviar lista
                </h3>

                <p class="mt-1 text-xs text-slate-500">
                    Hasta 10 opciones en una sección. Título de la opción: 24
                    caracteres; descripción: 72. Solo dentro de las 24 horas y
                    con las listas activadas en el workspace.
                </p>

                <form
                    action="<%= basePath %>/<%= conversation.id %>/messages/interactive-list"
                    method="POST"
                    class="mt-4 space-y-2"
                    id="list-form"
                >
                    <textarea
                        name="body"
                        id="list-body"
                        rows="2"
                        maxlength="1024"
                        required
                        placeholder="Texto del mensaje"
                        class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                    ></textarea>

                    <input
                        name="footer"
                        id="list-footer"
                        maxlength="60"
                        placeholder="Pie (opcional)"
                        class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                    />

                    <div class="grid gap-2 sm:grid-cols-2">
                        <input
                            name="buttonLabel"
                            id="list-button"
                            maxlength="20"
                            required
                            placeholder="Botón que abre la lista"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />

                        <input
                            name="sectionTitle"
                            id="list-section"
                            maxlength="24"
                            placeholder="Título de la sección (opcional)"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />
                    </div>

                    <% for (let index = 1; index <= 10; index += 1) { %>
                        <div class="grid gap-2 sm:grid-cols-2">
                            <input
                                name="rowTitle"
                                data-row-title
                                maxlength="24"
                                placeholder="Opción <%= index %>"
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                            />

                            <input
                                name="rowDescription"
                                data-row-description
                                maxlength="72"
                                placeholder="Descripción (opcional)"
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                            />
                        </div>
                    <% } %>

                    <div class="rounded-xl bg-slate-50 p-3 text-sm text-slate-700 ring-1 ring-slate-200" id="list-preview">
                        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Vista previa</p>
                        <p class="mt-1" id="list-preview-body">Texto del mensaje</p>
                        <p class="mt-2 inline-flex rounded-lg bg-white px-3 py-1 text-xs font-bold text-margarita-700 ring-1 ring-margarita-200" id="list-preview-button">Ver opciones</p>
                        <ul class="mt-2 space-y-1 text-xs" id="list-preview-rows"></ul>
                    </div>

                    <button class="w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800">
                        Enviar lista
                    </button>
                </form>

                <script>
                    (function () {
                        var form = document.getElementById("list-form");

                        if (!form) {
                            return;
                        }

                        var body = document.getElementById("list-body");
                        var button = document.getElementById("list-button");
                        var previewBody = document.getElementById("list-preview-body");
                        var previewButton = document.getElementById("list-preview-button");
                        var previewRows = document.getElementById("list-preview-rows");

                        function renderPreview() {
                            previewBody.textContent = body.value.trim() || "Texto del mensaje";
                            previewButton.textContent = button.value.trim() || "Ver opciones";

                            var titles = Array.prototype.slice.call(form.querySelectorAll("[data-row-title]"));
                            var descriptions = Array.prototype.slice.call(form.querySelectorAll("[data-row-description]"));

                            previewRows.innerHTML = "";

                            titles.forEach(function (titleInput, index) {
                                var title = titleInput.value.trim();

                                if (!title) {
                                    return;
                                }

                                var description = (descriptions[index] && descriptions[index].value.trim()) || "";
                                var item = document.createElement("li");
                                item.className = "rounded-lg bg-white px-3 py-2 ring-1 ring-slate-200";
                                item.textContent = description ? title + " — " + description : title;
                                previewRows.appendChild(item);
                            });
                        }

                        form.addEventListener("input", renderPreview);
                        renderPreview();
                    })();
                </script>
            </section>
        <% } %>
    <% } %>

    <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
        <h3 class="font-bold text-slate-800">
            Enviar plantilla
        </h3>

        <p class="mt-1 text-xs text-slate-500">
            Es la única forma de reabrir la conversación cuando la ventana de
            24 horas está cerrada.
        </p>

        <% if (templates.length === 0) { %>
            <p class="mt-4 rounded-xl bg-slate-50 px-4 py-3 text-xs text-slate-500">
                No hay plantillas aprobadas sincronizadas. Sincronízalas en Admin → Plantillas.
            </p>
        <% } else { %>
            <form
                action="<%= basePath %>/<%= conversation.id %>/messages/template"
                method="POST"
                class="mt-4 space-y-3"
            >
                <select
                    name="templateId"
                    required
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
                >
                    <option value="">Selecciona plantilla</option>

                    <% templates.forEach((template) => { %>
                        <%
                            /**
                             * Se manda a la vista la forma de cada plantilla para
                             * mostrar solo los campos que hacen falta: el
                             * encabezado y el botón de enlace llevan una sola
                             * variable, y mandar un componente de más hace que
                             * Meta rechace el envío.
                             */
                            const shape = templateVariableShape(template.components);
                        %>
                        <option
                            value="<%= template.id %>"
                            data-variables="<%= shape.body %>"
                            data-header-variable="<%= shape.header %>"
                            data-url-variable="<%= shape.url %>"
                        >
                            <%= template.name %> · <%= template.language %>
                        </option>
                    <% }) %>
                </select>

                <div class="grid gap-2 sm:grid-cols-3" data-body-fields>
                    <% [1, 2, 3].forEach((position) => { %>
                        <div data-body-field data-position="<%= position %>" class="hidden">
                            <input
                                name="variable<%= position %>"
                                data-body-input
                                placeholder="Variable <%= position %>"
                                class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                            />
                        </div>
                    <% }) %>
                </div>

                <div class="grid gap-2 sm:grid-cols-2">
                    <label data-header-field class="hidden">
                        <span class="mb-1 block text-xs font-semibold uppercase text-slate-500">
                            Encabezado
                        </span>

                        <input
                            name="headerVariable"
                            data-header-input
                            placeholder="Ej. CP-20260001"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />
                    </label>

                    <label data-url-field class="hidden">
                        <span class="mb-1 block text-xs font-semibold uppercase text-slate-500">
                            Botón de enlace
                        </span>

                        <input
                            name="buttonVariable"
                            data-url-input
                            placeholder="Ej. CP-20260001"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm"
                        />
                    </label>
                </div>

                <p class="text-xs text-slate-500">
                    En el cuerpo de la plantilla, los valores fijos se escriben tal cual
                    y el nombre del contacto con <span class="font-mono">{nombre}</span>.
                    Si la plantilla trae encabezado o un botón con enlace, aparecen sus
                    campos: el encabezado admite <strong>una</strong> variable y el enlace
                    otra, al final.
                </p>

                <button class="w-full rounded-xl bg-margarita-600 px-4 py-3 text-sm font-semibold text-white hover:bg-margarita-700">
                    Enviar plantilla
                </button>
            </form>

            <script>
                /**
                 * Muestra sólo los campos que la plantilla elegida pide.
                 *
                 * El encabezado lleva una variable y el botón de enlace otra; el
                 * cuerpo, las que tenga. Mandar un componente de más (o uno
                 * vacío) hace que Meta rechace el envío, así que los campos
                 * viajan con el formulario sólo cuando corresponden.
                 */
                (function () {
                    const form = document.querySelector('form[action$="/messages/template"]');

                    if (!form) {
                        return;
                    }

                    const select = form.querySelector('select[name="templateId"]');
                    const bodyFields = form.querySelectorAll("[data-body-field]");
                    const headerField = form.querySelector("[data-header-field]");
                    const headerInput = form.querySelector("[data-header-input]");
                    const urlField = form.querySelector("[data-url-field]");
                    const urlInput = form.querySelector("[data-url-input]");

                    function toggle(field, input, visible) {
                        if (!field || !input) {
                            return;
                        }

                        field.classList.toggle("hidden", !visible);
                        input.disabled = !visible;
                        input.required = visible;
                    }

                    function refresh() {
                        const option = select ? select.selectedOptions[0] : null;
                        const variables = Number(option?.getAttribute("data-variables") || 0);
                        const header = Number(option?.getAttribute("data-header-variable") || 0);
                        const url = Number(option?.getAttribute("data-url-variable") || 0);

                        bodyFields.forEach(function (field) {
                            const position = Number(field.getAttribute("data-position") || 0);
                            const input = field.querySelector("[data-body-input]");
                            const visible = Boolean(option) && position <= variables;

                            field.classList.toggle("hidden", !visible);

                            if (input) {
                                input.disabled = !visible;
                                input.required = visible;
                            }
                        });

                        toggle(headerField, headerInput, Boolean(option) && header > 0);
                        toggle(urlField, urlInput, Boolean(option) && url > 0);
                    }

                    if (select) {
                        select.addEventListener("change", refresh);
                        refresh();
                    }
                })();
            </script>
        <% } %>
    </section>
<% } %>

<section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <h3 class="font-bold text-slate-800">
        Nota interna
    </h3>

    <p class="mt-1 text-xs text-slate-500">
        Solo la ve el equipo: no se envía a WhatsApp y no cuenta para el límite
        diario de mensajes.
    </p>

    <form
        action="<%= basePath %>/<%= conversation.id %>/messages/local"
        method="POST"
        class="mt-4 space-y-3"
    >
        <textarea
            name="body"
            rows="3"
            required
            placeholder="Por ejemplo: quedó de llamar mañana a las 10."
            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
        ></textarea>

        <button class="w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800">
            Guardar nota
        </button>
    </form>
</section>

<% if (typeof feedbackEnabled !== "undefined" && feedbackEnabled && conversation.status === "CLOSED") { %>
    <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
        <h3 class="font-bold text-slate-800">
            ¿Cómo estuvo esta conversación?
        </h3>

        <p class="mt-1 text-xs text-slate-500">
            La valoración es opcional y ayuda a medir la calidad del servicio.
        </p>

        <div class="mt-4 flex gap-2">
            <form action="<%= basePath %>/<%= conversation.id %>/feedback" method="POST">
                <input type="hidden" name="value" value="UP" />
                <button class="rounded-xl bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-700 ring-1 ring-emerald-100 hover:bg-emerald-100">
                    👍 Buena
                </button>
            </form>

            <form action="<%= basePath %>/<%= conversation.id %>/feedback" method="POST">
                <input type="hidden" name="value" value="DOWN" />
                <button class="rounded-xl bg-rose-50 px-4 py-2 text-sm font-bold text-rose-700 ring-1 ring-rose-100 hover:bg-rose-100">
                    👎 Mejorable
                </button>
            </form>
        </div>
    </section>
<% } %>

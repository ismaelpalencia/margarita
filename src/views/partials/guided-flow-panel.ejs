<% if (typeof panel !== "undefined" && panel) { %>
    <section class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
        <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
                <p class="text-[11px] font-bold uppercase tracking-wide text-slate-500">Flujo guiado</p>
                <p class="mt-1 text-sm font-bold text-slate-800"><%= panel.flowName %></p>
            </div>
            <span class="rounded-full px-2.5 py-1 text-[11px] font-bold <%= panel.status === "ACTIVE" ? "bg-amber-50 text-amber-800" : "bg-margarita-50 text-margarita-700" %>">
                <%= panel.status === "ACTIVE" ? "En curso" : "Completado" %>
            </span>
        </div>

        <% if (panel.fields.length === 0) { %>
            <p class="mt-3 text-xs text-slate-500">Todavía no hay datos capturados.</p>
        <% } else { %>
            <dl class="mt-3 space-y-2">
                <% panel.fields.forEach((field) => { %>
                    <div class="rounded-xl bg-slate-50 px-3 py-2">
                        <dt class="text-[11px] font-semibold text-slate-500"><%= field.label %></dt>
                        <dd class="mt-0.5 text-sm text-slate-800">
                            <% if (field.file && field.messageId) { %>
                                <a href="/media/<%= field.messageId %>" target="_blank" rel="noopener" class="font-semibold text-margarita-700 hover:underline">
                                    Ver archivo ( <%= field.value %> )
                                </a>
                            <% } else { %>
                                <%= field.value %>
                            <% } %>
                        </dd>
                    </div>
                <% }) %>
            </dl>
        <% } %>
    </section>
<% } %>

<%#
    Campos para las variables de la plantilla elegida.
    El formulario decide cuántos mostrar según data-variable-count de la
    opción seleccionada (ver el script al final de la vista de campañas).
%>
<p class="text-sm font-semibold text-slate-700">
    Variables de la plantilla
</p>

<p class="mt-1 text-xs text-slate-500">
    Escribe el texto de cada variable, o combina referencias:
    <code class="font-semibold">{nombre}</code>,
    <code class="font-semibold">{telefono}</code> y
    <code class="font-semibold">{columna:Nombre de la columna}</code>
    (las columnas solo aplican al cargar desde Excel).
</p>

<div class="mt-3 grid gap-3 md:grid-cols-3">
    <% [1, 2, 3].forEach((position) => { %>
        <div data-variable-field>
            <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">
                Variable <%= position %>
            </label>

            <input
                name="variable<%= position %>"
                placeholder="Ej. Hola {nombre}"
                class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-margarita-500 focus:ring-2 focus:ring-margarita-100"
            />
        </div>
    <% }) %>
</div>

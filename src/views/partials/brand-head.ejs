<%
    /**
     * Los archivos de marca llevan la versión del despliegue al final. Si no,
     * el navegador conserva el favicon viejo durante días: es el motivo más
     * común de "el logo no cambió" después de subir la app.
     */
    const assetTag = typeof assetVersion !== "undefined" && assetVersion
        ? `?v=${assetVersion}`
        : "";
%>

<%#
    Encabezado de marca compartido por todas las vistas.
    Se incluye dentro del <head> de cada página.
%>
<meta name="theme-color" content="#0c5b4c" />
<meta
    name="description"
    content="Margarita — cobranza por WhatsApp con seguridad bancaria: llamadas pedidas, bandeja, promesas de pago y reportes para equipos de cobranza."
/>

<link rel="icon" href="<%= `/favicon.ico${assetTag}` %>" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="<%= `/favicon-32x32.png${assetTag}` %>" />
<link rel="icon" type="image/png" sizes="16x16" href="<%= `/favicon-16x16.png${assetTag}` %>" />
<link rel="apple-touch-icon" sizes="180x180" href="<%= `/apple-touch-icon.png${assetTag}` %>" />
<link rel="manifest" href="<%= `/site.webmanifest${assetTag}` %>" />

<%#
    Aviso de carga con la margarita de la marca.

    Son dos momentos y comparten el mismo dibujo:

    - **Arranque** (aquí abajo): la capa se crea con un script en línea, antes
      de que exista el <body>, así que se pinta con el primer HTML. No depende
      de que cargue ningún archivo: si el CSS o el JS externos fallan, el aviso
      igual aparece y, peor aún, igual se quita (hay un reloj de seguridad).
    - **Cambio de pantalla** y **botón enviado**: los maneja `loading.js`.

    El estilo crítico va en línea a propósito: la capa tiene que verse bien
    antes de que llegue la hoja de estilos.
%>
<meta name="marga-seal" content="/brand/img/margarita-icon-128.png" />
<meta name="marga-loader-petals" content="/brand/img/margarita-loader-petals-128.png" />
<meta name="marga-loader-face" content="/brand/img/margarita-loader-face-128.png" />

<style>
    #marga-boot {
        position: fixed;
        inset: 0;
        z-index: 120;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
        background: #f6f8f5;
        transition: opacity 220ms ease;
    }

    #marga-boot[data-visible="false"] {
        opacity: 0;
        pointer-events: none;
    }

    #marga-boot .marga-boot__flower {
        position: relative;
        width: 3rem;
        height: 3rem;
        filter: drop-shadow(0 6px 14px rgb(15 111 74 / 0.16));
    }

    #marga-boot .marga-boot__petals {
        width: 100%;
        height: 100%;
        animation: marga-boot-flor 7s linear infinite;
        transform-origin: 50% 50%;
    }

    #marga-boot .marga-boot__face {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    #marga-boot .marga-boot__text {
        font: 700 0.85rem/1.2 ui-sans-serif, system-ui, sans-serif;
        color: #10573c;
        letter-spacing: 0.02em;
    }

    @keyframes marga-boot-flor {
        to {
            transform: rotate(360deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #marga-boot .marga-boot__petals {
            animation: none;
        }
    }
</style>

<script>
    /**
     * Capa de arranque. Se crea aquí mismo, con la flor y el texto ya
     * dibujados, y se retira cuando la página termina de cargar. Tiene un
     * mínimo de 250 ms (para que no sea un parpadeo) y un máximo de 6 s (para
     * que un recurso colgado no deje la pantalla tapada).
     */
    (function () {
        var created = Date.now();
        var petalsTag = document.querySelector('meta[name="marga-loader-petals"]');
        var faceTag = document.querySelector('meta[name="marga-loader-face"]');
        var petals = (petalsTag && petalsTag.getAttribute("content")) ||
            "/brand/img/margarita-loader-petals-128.png";
        var face = (faceTag && faceTag.getAttribute("content")) ||
            "/brand/img/margarita-loader-face-128.png";

        var layer = document.createElement("div");
        layer.id = "marga-boot";
        layer.setAttribute("role", "status");
        layer.setAttribute("aria-live", "polite");
        layer.innerHTML =
            '<div class="marga-boot__flower" aria-hidden="true">' +
            '<img src="' + petals + '" alt="" class="marga-boot__petals" />' +
            '<img src="' + face + '" alt="" class="marga-boot__face" />' +
            "</div>" +
            '<p class="marga-boot__text">Cargando…</p>';

        (document.body || document.documentElement).appendChild(layer);

        var hidden = false;

        function retire() {
            if (hidden) {
                return;
            }

            hidden = true;

            var wait = Math.max(0, 150 - (Date.now() - created));

            setTimeout(function () {
                layer.setAttribute("data-visible", "false");
                layer.setAttribute("aria-hidden", "true");

                setTimeout(function () {
                    if (layer.parentNode) {
                        layer.parentNode.removeChild(layer);
                    }
                }, 260);
            }, wait);
        }

        window.addEventListener("load", retire);
        window.addEventListener("pageshow", retire);
        setTimeout(retire, 6000);
    })();
</script>

<script src="<%= `/js/loading.js${assetTag}` %>" defer></script>

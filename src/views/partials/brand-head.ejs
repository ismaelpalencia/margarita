<%
    /**
     * Los archivos de marca llevan la versión del despliegue al final. Si no,
     * el navegador conserva el favicon viejo durante días: es el motivo más
     * común de "el logo no cambió" después de subir la app.
     */
    const assetTag = typeof assetVersion !== "undefined" && assetVersion
        ? `?v=${assetVersion}`
        : "";
%>

<%#
    Encabezado de marca compartido por todas las vistas.
    Se incluye dentro del <head> de cada página.
%>
<meta name="theme-color" content="#17865a" />
<meta
    name="description"
    content="Margarita — operación de WhatsApp Business Cloud API: campañas, conversaciones y agentes en un solo panel."
/>

<link rel="icon" href="<%= `/favicon.ico${assetTag}` %>" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="<%= `/favicon-32x32.png${assetTag}` %>" />
<link rel="icon" type="image/png" sizes="16x16" href="<%= `/favicon-16x16.png${assetTag}` %>" />
<link rel="apple-touch-icon" sizes="180x180" href="<%= `/apple-touch-icon.png${assetTag}` %>" />
<link rel="manifest" href="<%= `/site.webmanifest${assetTag}` %>" />

<%#
    Aviso de carga con el sello de la marca: aparece al cambiar de pantalla y
    en el botón que se acaba de enviar. Va en el encabezado compartido para que
    lo tengan todas las páginas, incluidas las que no usan `partials/header`.
%>
<meta name="marga-seal" content="/brand/img/margarita-icon-128.png" />
<script src="<%= `/js/loading.js${assetTag}` %>" defer></script>

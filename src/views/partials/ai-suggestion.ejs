<%
    /**
     * Tarjeta del borrador de IA en la bandeja.
     *
     * No envía nada: "Usar" copia el texto al compositor para que una
     * persona lo revise y lo mande. Si el modelo pidió entregar el hilo,
     * la tarjeta lo dice y no ofrece un texto inventado.
     *
     * Espera: suggestion, confidenceMin, basePath.
     */
    const confidence = Math.round((suggestion.confidence || 0) * 100);
    const lowConfidence = (suggestion.confidence || 0) < confidenceMin;
    const draft = (suggestion.body || "").trim();
    const canUse = draft.length > 0;
    const useUrl = `${basePath}/${conversation.id}/ai/${suggestion.id}/use`;
    const discardUrl = `${basePath}/${conversation.id}/ai/${suggestion.id}/discard`;
    const confidenceClass = suggestion.handoff || lowConfidence
        ? "bg-amber-50 text-amber-800 ring-amber-200"
        : "bg-margarita-50 text-margarita-700 ring-margarita-200";
%>

<section class="mb-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1 rounded-full bg-slate-900 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-white">
            IA
        </span>

        <span class="text-xs font-semibold text-slate-600">
            Borrador de respuesta
        </span>

        <span class="rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 <%= confidenceClass %>">
            Confianza <%= confidence %>%
        </span>

        <% if (suggestion.intent) { %>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600">
                <%= suggestion.intent %>
            </span>
        <% } %>
    </div>

    <% if (suggestion.handoff) { %>
        <p class="mt-3 rounded-xl bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900">
            La IA recomienda entregar esta conversación a una persona.
        </p>
    <% } else if (canUse) { %>
        <p class="mt-3 whitespace-pre-wrap rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-800">
            <%= draft %>
        </p>
    <% } %>

    <% if (lowConfidence && !suggestion.handoff) { %>
        <p class="mt-2 text-xs font-medium text-amber-700">
            Confianza menor al umbral configurado. Revísalo antes de enviarlo.
        </p>
    <% } %>

    <% if (suggestion.reason) { %>
        <p class="mt-2 text-xs text-slate-500">
            <%= suggestion.reason %>
        </p>
    <% } %>

    <div class="mt-3 flex flex-wrap items-center gap-2">
        <% if (canUse) { %>
            <form action="<%= useUrl %>" method="POST">
                <button class="rounded-xl bg-margarita-600 px-4 py-2 text-xs font-semibold text-white hover:bg-margarita-700">
                    Usar borrador
                </button>
            </form>
        <% } %>

        <form action="<%= discardUrl %>" method="POST">
            <button class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">
                Descartar
            </button>
        </form>

        <span class="text-[11px] text-slate-400">
            Nada se envía solo: al usarlo se copia al compositor.
        </span>
    </div>
</section>

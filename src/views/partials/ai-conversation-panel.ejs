<%
    /**
     * Panel de IA de una conversación.
     *
     * Responde la pregunta que el equipo se hace al abrir un hilo: ¿la IA
     * intervino aquí?, ¿respondió sola o entregó?, ¿cuánto costó? El detalle
     * de ajustes y base de conocimiento sigue en Admin → IA.
     */
    const aiEnabled = Boolean(aiSettings && aiSettings.enabled);
    const aiModeLabel = !aiEnabled
        ? "Apagada"
        : aiSettings.mode === "AUTO"
          ? "Automático acotado"
          : aiSettings.mode === "SUGGEST"
            ? "Sugerencias"
            : "Apagada";

    const aiStatusLabels = {
        PENDING: "Borrador pendiente de revisión",
        ACCEPTED: "El equipo usó el borrador",
        EDITED: "El equipo lo editó y envió",
        DISCARDED: "El equipo descartó el borrador",
        SUPERSEDED: "Reemplazado por un mensaje más nuevo",
        AUTO_SENT: "La IA respondió sola",
        HANDOFF: "La IA entregó a una persona"
    };

    const aiLast = aiConversation && aiConversation.last;
    const aiLastReason =
        aiLast && aiLast.reason
            ? aiLast.reason.length > 180
                ? `${aiLast.reason.slice(0, 180)}…`
                : aiLast.reason
            : "";
    const aiDecided =
        aiConversation
            ? aiConversation.accepted + aiConversation.edited
            : 0;
%>

<section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <div class="flex items-start justify-between gap-3">
        <h3 class="font-bold text-slate-800">
            IA en esta conversación
        </h3>

        <span class="rounded-full px-2.5 py-1 text-[11px] font-bold <%= aiEnabled ? 'bg-margarita-50 text-margarita-700' : 'bg-slate-100 text-slate-500' %>">
            <%= aiModeLabel %>
        </span>
    </div>

    <p class="mt-2 text-xs leading-5 text-slate-500">
        <% if (!aiEnabled) { %>
            La IA está apagada. El historial de abajo se conserva.
        <% } else if (conversation.aiPausedAt) { %>
            La IA está en pausa en este hilo: no responde sola hasta que alguien
            la reactive.
        <% } else { %>
            La IA respeta la base de conocimiento, la ventana de 24 horas y los
            límites del workspace.
        <% } %>
    </p>

    <% if (!aiLast) { %>
        <p class="mt-3 rounded-xl bg-slate-50 px-3 py-2 text-xs text-slate-500">
            Todavía no hay intervenciones de IA en este hilo.
        </p>
    <% } else { %>
        <div class="mt-3 rounded-xl bg-slate-50 px-3 py-3">
            <p class="text-xs font-bold text-slate-700">
                <%= aiStatusLabels[aiLast.status] || aiLast.status %>
            </p>

            <p class="mt-1 text-[11px] text-slate-500">
                <%= formatDateTimeMX(aiLast.createdAt) %>
                · confianza <%= Math.round(aiLast.confidence * 100) %>%
            </p>

            <% if (aiLast.intent) { %>
                <p class="mt-1 text-[11px] text-slate-500">
                    Intención: <span class="font-semibold text-slate-700"><%= aiLast.intent %></span>
                </p>
            <% } %>

            <% if (aiLastReason) { %>
                <p class="mt-2 text-[11px] leading-5 text-slate-600">
                    <%= aiLastReason %>
                </p>
            <% } %>
        </div>
    <% } %>

    <dl class="mt-4 grid grid-cols-2 gap-2 text-xs">
        <div class="rounded-xl bg-slate-50 px-3 py-2">
            <dt class="text-slate-500">Respondió sola</dt>
            <dd class="font-bold text-margarita-700">
                <%= aiConversation ? aiConversation.autoSent : 0 %>
            </dd>
        </div>

        <div class="rounded-xl bg-slate-50 px-3 py-2">
            <dt class="text-slate-500">Entregó a persona</dt>
            <dd class="font-bold text-amber-700">
                <%= aiConversation ? aiConversation.handoffs : 0 %>
            </dd>
        </div>

        <div class="rounded-xl bg-slate-50 px-3 py-2">
            <dt class="text-slate-500">Borradores aprobados</dt>
            <dd class="font-bold text-slate-800"><%= aiDecided %></dd>
        </div>

        <div class="rounded-xl bg-slate-50 px-3 py-2">
            <dt class="text-slate-500">Costo estimado</dt>
            <dd class="font-bold text-slate-800">
                $<%= ((aiConversation ? aiConversation.costMicros : 0) / 1000000).toFixed(4) %>
            </dd>
        </div>
    </dl>

    <% if (user && user.role === "ADMIN") { %>
        <a
            href="/admin/ai"
            class="mt-3 inline-flex text-xs font-bold text-margarita-700 hover:text-margarita-800"
        >
            Ver ajustes y métricas de IA →
        </a>
    <% } %>
</section>
